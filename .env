# Symfony specific variables (if needed)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_NAME}?serverVersion=16&charset=${POSTGRES_CHARSET}"
