{% extends 'base_admin.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.adm-dash-kpis {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.5rem;
}
.adm-kpi {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius);
    padding: 1rem;
    box-shadow: var(--adm-shadow);
}
.adm-kpi__value { font-size: 1.75rem; font-weight: 700; color: var(--adm-text); line-height: 1.2; }
.adm-kpi__label { font-size: 0.8rem; color: var(--adm-text-muted); margin-top: 0.25rem; }
.adm-kpi__revenue { font-size: 0.9rem; font-weight: 600; color: var(--adm-accent); margin-top: 0.35rem; }
.adm-dash-actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.5rem;
}
.adm-dash-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 0.75rem;
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius);
    text-decoration: none;
    color: var(--adm-text);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.2s, border-color 0.2s;
}
.adm-dash-action i { font-size: 1.5rem; color: var(--adm-accent); margin-bottom: 0.5rem; }
.adm-dash-action:hover { background: var(--adm-accent-soft); border-color: var(--adm-accent); }
.adm-dash-action span:last-child { font-size: 0.75rem; font-weight: 500; color: var(--adm-text-muted); margin-top: 0.2rem; }
.adm-dash-secondary {
    display: grid;
    gap: 0.75rem;
}
.adm-dash-secondary .adm-card { margin-bottom: 0; }
.adm-dash-secondary a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    color: var(--adm-text);
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
}
.adm-dash-secondary a:hover { background: var(--adm-accent-soft); }
.adm-dash-secondary a i { width: 1.5rem; text-align: center; color: var(--adm-accent); }
@media (min-width: 640px) {
    .adm-dash-kpis { grid-template-columns: repeat(4, 1fr); }
    .adm-dash-actions { grid-template-columns: repeat(4, 1fr); }
}
@media (min-width: 768px) {
    .adm-dash-secondary { grid-template-columns: repeat(3, 1fr); }
}
</style>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <h1 class="adm-page-title">Tableau de bord</h1>
    <p class="adm-page-subtitle">{{ "now"|date("d/m/Y") }} · L'Atelier de Marie</p>
</div>

<div class="adm-dash-kpis">
    <div class="adm-kpi">
        <div class="adm-kpi__value" data-target="{{ countByDay }}">0</div>
        <div class="adm-kpi__label">Aujourd'hui</div>
        <div class="adm-kpi__revenue">{{ totalByDay }} €</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__value" data-target="{{ countByWeek }}">0</div>
        <div class="adm-kpi__label">Cette semaine</div>
        <div class="adm-kpi__revenue">{{ totalByWeek }} €</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__value" data-target="{{ countByMonth }}">0</div>
        <div class="adm-kpi__label">Ce mois</div>
        <div class="adm-kpi__revenue">{{ totalByMonth }} €</div>
    </div>
    <div class="adm-kpi">
        <div class="adm-kpi__value" data-target="{{ countByYear }}">0</div>
        <div class="adm-kpi__label">Cette année</div>
        <div class="adm-kpi__revenue">{{ totalByYear }} €</div>
    </div>
</div>

<div class="adm-dash-actions">
    <a href="{{ path('app_calendar') }}" class="adm-dash-action">
        <i class="fas fa-calendar-check"></i>
        <span>Calendrier</span>
        <span>Gérer les RDV</span>
    </a>
    <a href="{{ path('app_service_index') }}" class="adm-dash-action">
        <i class="fas fa-cut"></i>
        <span>Prestations</span>
        <span>Services</span>
    </a>
    <a href="{{ path('app_client_index') }}" class="adm-dash-action">
        <i class="fas fa-users"></i>
        <span>Clients</span>
        <span>Base clients</span>
    </a>
    <a href="{{ path('app_statistics_index') }}" class="adm-dash-action">
        <i class="fas fa-chart-line"></i>
        <span>Statistiques</span>
        <span>Analyses</span>
    </a>
</div>

<div class="adm-dash-secondary">
    <div class="adm-card">
        <div class="adm-card__body">
            <a href="{{ path('app_category_index') }}">
                <i class="fas fa-tags"></i>
                <span>Catégories</span>
            </a>
        </div>
    </div>
    <div class="adm-card">
        <div class="adm-card__body">
            <a href="{{ path('app_picture_presentation_index') }}">
                <i class="fas fa-images"></i>
                <span>Galerie / Images</span>
            </a>
        </div>
    </div>
    <div class="adm-card">
        <div class="adm-card__body">
            <a href="{{ path('app_compte_index') }}">
                <i class="fas fa-calculator"></i>
                <span>Compte</span>
            </a>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function animateCounter(el, target) {
        var current = 0;
        var step = Math.max(1, target / 40);
        var t = setInterval(function() {
            current += step;
            if (current >= target) { current = target; clearInterval(t); }
            el.textContent = Math.floor(current);
        }, 25);
    }
    document.querySelectorAll('.adm-kpi__value[data-target]').forEach(function(el) {
        var target = parseInt(el.getAttribute('data-target'), 10) || 0;
        animateCounter(el, target);
    });
});
</script>
{% endblock %}
