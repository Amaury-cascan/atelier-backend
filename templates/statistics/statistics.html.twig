                            <tr>
                                <th>Service</th>
                                <th>Nombre</th>
                                <th>Chiffre d'Affaires</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% set totalCount = 0 %}
                            {% set totalAmount = 0 %}
