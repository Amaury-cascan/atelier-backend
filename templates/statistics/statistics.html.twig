                            {% set totalCount = 0 %}
                            {% set totalAmount = 0 %}
                            {% set serviceColors = ['#a24e32', '#c5653f', '#d4864a', '#8b5a3c', '#7d3a26', '#f0d5b8'] %}
                            {% for service, stats in yearlyStats[year] %}
                                {% if stats.total > 0 %}
                                    {% set totalCount = totalCount + stats.count %}
                                    {% set totalAmount = totalAmount + stats.total %}
                                {% endif %}
                            {% endfor %}
                            
                            {% for service, stats in yearlyStats[year] %}
                                {% if stats.total > 0 %}
                                    <tr>
                                        <td>
                                            <div class="service-name">
                                                <div class="service-indicator" style="background: {{ serviceColors[loop.index0 % 6] }}"></div>
                                                <span class="service-name-text">{{ service }}</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="count-badge">{{ stats.count }}</span>
                                        </td>
                                        <td>
                                            <span class="revenue-amount">{{ stats.total }}€</span>
                                        </td>
                                        <td>
                                            {% set percentage = (stats.total / totalAmount * 100)|round(1) %}
                                            <div class="progress-container">
                                                <div class="progress-bar" style="width: {{ percentage }}%; background: {{ serviceColors[loop.index0 % 6] }}">
                                                    {{ percentage }}%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        </tbody>
                        {% if totalCount > 0 %}
                            <tfoot>
                                <tr class="total-row">
                                    <td><strong>Total</strong></td>
                                    <td><span class="count-badge">{{ totalCount }}</span></td>
                                    <td><span class="revenue-amount">{{ totalAmount }}€</span></td>
                                    <td><strong>100%</strong></td>
                                </tr>
                            </tfoot>
                        {% endif %}
                    </table>
                </div>
            </div>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Couleurs du thème taupe/beige
    const colors = ['#a24e32', '#c5653f', '#d4864a', '#8b5a3c', '#7d3a26', '#f0d5b8'];
    
    {% if period == 'daily' and hasDailyStats %}
        // Graphique quotidien modernisé
        const dailyCtx = document.getElementById('dailyChart').getContext('2d');
        const dailyData = {
            labels: [
                {% for service, stats in dailyStats[date] %}
                    {% if stats.total > 0 %}'{{ service|e('js') }}',{% endif %}
                {% endfor %}
            ],
            datasets: [{
                data: [
                    {% for service, stats in dailyStats[date] %}
                        {% if stats.total > 0 %}{{ stats.total }},{% endif %}
                    {% endfor %}
                ],
                backgroundColor: colors,
                borderWidth: 0,
                borderRadius: 8,
                hoverOffset: 15
            }]
        };
        
        new Chart(dailyCtx, {
            type: 'doughnut',
            data: dailyData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            color: '#a24e32',
                            font: {
                                family: 'Inter',
                                size: 13,
                                weight: '600'
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(162, 78, 50, 0.95)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#a24e32',
                        borderWidth: 2,
                        cornerRadius: 12,
                        titleFont: {
                            family: 'Inter',
                            size: 14,
                            weight: '700'
                        },
                        bodyFont: {
                            family: 'Inter',
                            size: 13,
                            weight: '500'
                        },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                if (total === 0) return context.label + ': 0€ (0%)';
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + '€ (' + percentage + '%)';
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    duration: 1500,
                    easing: 'easeInOutQuart'
                }
            }
        });
    {% endif %}

    {% if period == 'weekly' and hasWeeklyStats %}
        // Graphique hebdomadaire
        const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
        const weeklyData = {
            labels: [
                {% for service, stats in weeklyStats[week] %}
                    {% if stats.total > 0 %}'{{ service|e('js') }}',{% endif %}
                {% endfor %}
            ],
            datasets: [{
                data: [
                    {% for service, stats in weeklyStats[week] %}
                        {% if stats.total > 0 %}{{ stats.total }},{% endif %}
                    {% endfor %}
                ],
                backgroundColor: colors,
                borderWidth: 0,
                borderRadius: 8,
                hoverOffset: 15
            }]
        };
        
        new Chart(weeklyCtx, {
            type: 'doughnut',
            data: weeklyData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            color: '#a24e32',
                            font: {
                                family: 'Inter',
                                size: 13,
                                weight: '600'
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(162, 78, 50, 0.95)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#a24e32',
                        borderWidth: 2,
                        cornerRadius: 12,
                        titleFont: {
                            family: 'Inter',
                            size: 14,
                            weight: '700'
                        },
                        bodyFont: {
                            family: 'Inter',
                            size: 13,
                            weight: '500'
                        },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                if (total === 0) return context.label + ': 0€ (0%)';
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + '€ (' + percentage + '%)';
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    duration: 1500,
                    easing: 'easeInOutQuart'
                }
            }
        });
    {% endif %}

    {% if period == 'monthly' and hasMonthlyStats %}
        // Graphique mensuel
        const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
        const monthlyData = {
            labels: [
                {% for service, stats in monthlyStats[month] %}
                    {% if stats.total > 0 %}'{{ service|e('js') }}',{% endif %}
                {% endfor %}
            ],
            datasets: [{
                data: [
                    {% for service, stats in monthlyStats[month] %}
                        {% if stats.total > 0 %}{{ stats.total }},{% endif %}
                    {% endfor %}
                ],
                backgroundColor: colors,
                borderWidth: 0,
                borderRadius: 8,
                hoverOffset: 15
            }]
        };
        
        new Chart(monthlyCtx, {
            type: 'doughnut',
            data: monthlyData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            color: '#a24e32',
                            font: {
                                family: 'Inter',
                                size: 13,
                                weight: '600'
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(162, 78, 50, 0.95)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#a24e32',
                        borderWidth: 2,
                        cornerRadius: 12,
                        titleFont: {
                            family: 'Inter',
                            size: 14,
                            weight: '700'
                        },
                        bodyFont: {
                            family: 'Inter',
                            size: 13,
                            weight: '500'
                        },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                if (total === 0) return context.label + ': 0€ (0%)';
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + '€ (' + percentage + '%)';
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    duration: 1500,
                    easing: 'easeInOutQuart'
                }
            }
        });
    {% endif %}

    {% if period == 'yearly' and hasYearlyStats %}
        // Graphique annuel
        const yearlyCtx = document.getElementById('yearlyChart').getContext('2d');
        const yearlyData = {
            labels: [
                {% for service, stats in yearlyStats[year] %}
                    {% if stats.total > 0 %}'{{ service|e('js') }}',{% endif %}
                {% endfor %}
            ],
            datasets: [{
                data: [
                    {% for service, stats in yearlyStats[year] %}
                        {% if stats.total > 0 %}{{ stats.total }},{% endif %}
                    {% endfor %}
                ],
                backgroundColor: colors,
                borderWidth: 0,
                borderRadius: 8,
                hoverOffset: 15
            }]
        };
        
        new Chart(yearlyCtx, {
            type: 'doughnut',
            data: yearlyData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '60%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            color: '#a24e32',
                            font: {
                                family: 'Inter',
                                size: 13,
                                weight: '600'
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(162, 78, 50, 0.95)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#a24e32',
                        borderWidth: 2,
                        cornerRadius: 12,
                        titleFont: {
                            family: 'Inter',
                            size: 14,
                            weight: '700'
                        },
                        bodyFont: {
                            family: 'Inter',
                            size: 13,
                            weight: '500'
                        },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                if (total === 0) return context.label + ': 0€ (0%)';
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + '€ (' + percentage + '%)';
                            }
                        }
                    }
                },
                animation: {
                    animateRotate: true,
                    duration: 1500,
                    easing: 'easeInOutQuart'
                }
            }
        });
    {% endif %}
    
    // Animation des compteurs
    function animateCounter(element, target) {
        let current = 0;
        const increment = target / 60;
        const timer = setInterval(() => {
            current += increment;
            if (current >= target) {
                current = target;
                clearInterval(timer);
            }
            element.textContent = Math.floor(current);
        }, 25);
    }

    // Animation des barres de progression
    function animateProgressBars() {
        const progressBars = document.querySelectorAll('.progress-bar');
        progressBars.forEach((bar, index) => {
            const width = bar.style.width;
            bar.style.width = '0%';
            setTimeout(() => {
                bar.style.width = width;
            }, 300 + (index * 100));
        });
    }

    // Animer les compteurs KPI
    setTimeout(() => {
        document.querySelectorAll('.kpi-number').forEach(counter => {
            const text = counter.textContent;
            const target = parseInt(text.replace(/[€\s]/g, ''));
            if (!isNaN(target)) {
                counter.textContent = '0';
                animateCounter(counter, target);
            }
        });
    }, 500);

    // Animer les barres de progression
    setTimeout(animateProgressBars, 800);

    // Animation des icônes KPI (rotation au hover)
    document.querySelectorAll('.kpi-icon').forEach(icon => {
        icon.addEventListener('mouseenter', function() {
            this.style.transform = 'scale(1.1) rotate(5deg)';
        });
        
        icon.addEventListener('mouseleave', function() {
            this.style.transform = 'scale(1) rotate(0deg)';
        });
    });
});
</script>
{% endblock %}
