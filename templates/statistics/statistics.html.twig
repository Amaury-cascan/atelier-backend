                                {% if stats.total > 0 %}
                                    <tr>
                                        <td>{{ service }}</td>
                                        <td>{{ stats.count }}</td>
                                        <td>{{ stats.total }} €</td>
                                    </tr>
                                    {% set totalCount = totalCount + stats.count %}
                                    {% set totalAmount = totalAmount + stats.total %}
                                {% endif %}
                            {% endfor %}
                            {% if totalCount > 0 %}
                                <tr class="table-success">
                                    <td><strong>Total</strong></td>
                                    <td><strong>{{ totalCount }}</strong></td>
                                    <td><strong>{{ totalAmount }} €</strong></td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center">Aucune prestation disponible avec un prix supérieur à 0.</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>Aucun rendez-vous disponible pour ce mois.</p>
                    {% endif %}
                </div>
            </div>

        {% elseif period == 'yearly' %}
            <div class="card mb-4 shadow">
                <div class="card-header">
                    <h2>Statistiques Par Année</h2>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ path('app_statistics_index') }}">
                        <div class="input-group mb-3">
                            <input type="year" name="year" class="form-control" value="{{ year }}" required>
                            <input type="hidden" name="period" value="yearly">
                            <button class="btn btn-outline-secondary" type="submit">Afficher</button>
                        </div>
                    </form>

                    <h3>Statistiques pour l'année {{ year }}</h3>
                    {% if hasYearlyStats %}
