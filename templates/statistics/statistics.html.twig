{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center mb-4">Statistiques des Rendez-vous</h1>

        <div class="btn-group mb-3" role="group" aria-label="Navigation">
            <a href="{{ path('app_statistics_index', { 'period': 'daily' }) }}" class="btn btn-primary">Par Jour</a>
            <a href="{{ path('app_statistics_index', { 'period': 'weekly' }) }}" class="btn btn-primary">Par Semaine</a>
            <a href="{{ path('app_statistics_index', { 'period': 'monthly' }) }}" class="btn btn-primary">Par Mois</a>
            <a href="{{ path('app_statistics_index', { 'period': 'yearly' }) }}" class="btn btn-primary">Par Année</a>
        </div>

        {% if period == 'daily' %}
            <div class="card mb-4 shadow">
                <div class="card-header">
                    <h2>Statistiques Par Jour</h2>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ path('app_statistics_index') }}">
                        <div class="input-group mb-3">
                            <input type="date" name="date" class="form-control" value="{{ date|date('Y-m-d') }}" required>
                            <input type="hidden" name="period" value="daily">
                            <button class="btn btn-outline-secondary" type="submit">Afficher</button>
                        </div>
                    </form>

                    <h3>Statistiques pour le {{ date|date('d/m/Y') }}</h3>
                    {% if hasDailyStats %}
                        <table class="table table-striped table-hover">
                            <thead class="table-primary">
                            <tr>
                                <th>Service</th>
                                <th>Nombre</th>
                                <th>Chiffre d'Affaires</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% set totalCount = 0 %}
                            {% set totalAmount = 0 %}
                            {% for service, stats in dailyStats[date] %}
                                {% if stats.total > 0 %}
                                    <tr>
                                        <td>{{ service }}</td>
                                        <td>{{ stats.count }}</td>
                                        <td>{{ stats.total }} €</td>
                                    </tr>
                                    {% set totalCount = totalCount + stats.count %}
                                    {% set totalAmount = totalAmount + stats.total %}
                                {% endif %}
                            {% endfor %}
                            {% if totalCount > 0 %}
                                <tr class="table-success">
                                    <td><strong>Total</strong></td>
                                    <td><strong>{{ totalCount }}</strong></td>
                                    <td><strong>{{ totalAmount }} €</strong></td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center">Aucune prestation disponible avec un prix supérieur à 0.</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>Aucun rendez-vous disponible pour cette date.</p>
                    {% endif %}
                </div>
            </div>

        {% elseif period == 'weekly' %}
            <div class="card mb-4 shadow">
                <div class="card-header">
                    <h2>Statistiques Par Semaine</h2>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ path('app_statistics_index') }}">
                        <div class="input-group mb-3">
                            <input type="week" name="week" class="form-control" value="{{ week }}" required>
                            <input type="hidden" name="period" value="weekly">
                            <button class="btn btn-outline-secondary" type="submit">Afficher</button>
                        </div>
                    </form>

                    <h3>Statistiques pour la semaine {{ week }}</h3>
                    {% if hasWeeklyStats %}
                        <table class="table table-striped table-hover">
                            <thead class="table-primary">
                            <tr>
                                <th>Service</th>
                                <th>Nombre</th>
                                <th>Chiffre d'Affaires</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% set totalCount = 0 %}
