{% set totalCount = 0 %}
{% set totalAmount = 0 %}
{% set serviceColors = ['#a24e32', '#c5653f', '#d4864a', '#8b5a3c', '#7d3a26', '#f0d5b8'] %}
{% for service, serviceStats in stats %}
    {% if serviceStats.total > 0 %}
        {% set totalCount = totalCount + serviceStats.count %}
        {% set totalAmount = totalAmount + serviceStats.total %}
    {% endif %}
{% endfor %}

{% if totalCount > 0 %}
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th><i class="bi bi-briefcase me-1"></i>Service</th>
                    <th><i class="bi bi-hash me-1"></i>Nombre</th>
                    <th><i class="bi bi-currency-euro me-1"></i>Chiffre d'Affaires</th>
                    <th><i class="bi bi-percent me-1"></i>Part</th>
                </tr>
            </thead>
            <tbody>
                {% for service, serviceStats in stats %}
                    {% if serviceStats.total > 0 %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="service-indicator me-2" style="background: {{ serviceColors[loop.index0 % 6] }}"></div>
                                    {{ service }}
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary">{{ serviceStats.count }}</span>
                            </td>
                            <td>
                                <strong>{{ serviceStats.total }} €</strong>
                            </td>
                            <td>
                                {% set percentage = (serviceStats.total / totalAmount * 100)|round(1) %}
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar" style="width: {{ percentage }}%; background: {{ serviceColors[loop.index0 % 6] }}">
                                        {{ percentage }}%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
            <tfoot class="table-success">
                <tr>
                    <th><strong>Total</strong></th>
                    <th><span class="badge bg-success">{{ totalCount }}</span></th>
                    <th><strong>{{ totalAmount }} €</strong></th>
                    <th><strong>100%</strong></th>
                </tr>
            </tfoot>
        </table>
    </div>
{% else %}
    <div class="text-center py-5">
        <i class="bi bi-calendar-x display-1 text-muted mb-3"></i>
        <h5 class="text-muted">Aucune prestation avec un prix supérieur à 0</h5>
        <p class="text-muted">Les données apparaîtront ici dès qu'il y aura des rendez-vous</p>
    </div>
{% endif %} 