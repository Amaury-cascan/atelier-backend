{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Catégories{% endblock %}

{% block stylesheets %}
<style>
/* Header moderne identique à service/index */
.categories-header {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.1), rgba(166, 139, 91, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.categories-title {
    color: var(--primary-color);
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, #8B7355, #6F5B47);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 12px;
}

.categories-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    margin: 0.5rem 0 0 3rem;
    font-weight: 400;
}

.new-category-btn {
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 15px rgba(139, 115, 85, 0.2);
}

.new-category-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(139, 115, 85, 0.3);
    color: white;
}

/* Stats cards identiques à service/index */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stats-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 8px 20px rgba(139, 115, 85, 0.08),
        0 4px 12px rgba(139, 115, 85, 0.05);
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.stats-card:hover {
    transform: translateY(-3px);
    box-shadow: 
        0 15px 35px rgba(139, 115, 85, 0.12),
        0 6px 20px rgba(139, 115, 85, 0.08);
}

.stats-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--primary-color);
    border-radius: 16px 16px 0 0;
}

.stats-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    font-size: 1.5rem;
    color: white;
}

.stats-icon.categories { background: linear-gradient(135deg, #8B7355, #A68B5B); }
.stats-icon.services { background: linear-gradient(135deg, #22C55E, #16A34A); }
.stats-icon.average { background: linear-gradient(135deg, #3B82F6, #2563EB); }

.stats-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1;
}

.stats-label {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.9rem;
}

/* Responsive */
@media (max-width: 768px) {
    .categories-header {
        flex-direction: column;
        text-align: center;
    }
    
    .categories-title {
        font-size: 1.8rem;
    }
    
    .categories-subtitle {
        margin-left: 0;
    }
    
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 480px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
}

/* Cards container et header identiques à service/index */
.categories-cards-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.categories-cards-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.25rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 0 4px 15px rgba(139, 115, 85, 0.08);
    margin-bottom: 0.5rem;
}

.cards-title {
    margin: 0 0 1rem 0;
    color: var(--primary-color);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.1rem;
}

.mobile-search-container {
    position: relative;
    display: flex;
    align-items: center;
}

.mobile-search-input {
    width: 100%;
    padding: 12px 40px 12px 16px;
    border: 2px solid rgba(139, 115, 85, 0.2);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.9);
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
    font-size: 0.95rem;
}

.mobile-search-input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(139, 115, 85, 0.1);
    background: rgba(255, 255, 255, 1);
}

.search-icon {
    position: absolute;
    right: 16px;
    color: var(--primary-color);
    pointer-events: none;
}
</style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <div class="categories-header">
        <div>
            <h1 class="categories-title">
                <i class="fas fa-tags"></i>
                Catégories
            </h1>
            <p class="categories-subtitle">Organisez vos prestations par catégories</p>
        </div>
        <a href="{{ path('app_category_new') }}" class="new-category-btn">
            <i class="fas fa-plus-circle"></i>
            Nouvelle Catégorie
        </a>
    </div>

    <!-- Stats rapides -->
    <div class="stats-grid">
        <div class="stats-card" data-animate="true">
            <div class="stats-icon categories">
                <i class="fas fa-tags"></i>
            </div>
            <div class="stats-number" data-target="{{ categories|length }}">0</div>
            <div class="stats-label">Catégories total</div>
        </div>
        
        <div class="stats-card" data-animate="true">
            <div class="stats-icon services">
                <i class="fas fa-briefcase"></i>
            </div>
            <div class="stats-number" data-target="{% set totalServices = 0 %}{% for category in categories %}{% if category.services is defined %}{% set totalServices = totalServices + category.services|length %}{% endif %}{% endfor %}{{ totalServices }}">0</div>
            <div class="stats-label">Services liés</div>
        </div>
        
        <div class="stats-card" data-animate="true">
            <div class="stats-icon average">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="stats-number" data-target="{{ categories|length > 0 ? (totalServices / categories|length)|round : 0 }}">0</div>
            <div class="stats-label">Services / catégorie</div>
        </div>
    </div>

    <!-- Liste des catégories -->
    {% if categories is not empty %}
        <!-- Affichage mobile/tablet (cartes) -->
        <div class="categories-cards-container">
            <div class="categories-cards-header">
                <h4 class="cards-title">
                    <i class="fas fa-list"></i>
                    Liste des Catégories ({{ categories|length }})
                </h4>
                <div class="mobile-search-container">
                    <input type="text" class="mobile-search-input" placeholder="Rechercher..." id="searchCategories">
                    <i class="fas fa-search search-icon"></i>
                </div>
            </div>
            {% for category in categories %}
                <div class="category-card-mobile category-row" data-category-name="{{ category.name|lower }}">
                    <div class="category-card-header">
                        <div class="category-card-icon">
                            <i class="fas fa-tag"></i>
                        </div>
                        <div class="category-card-title">
                            <h5 class="category-name">{{ category.name }}</h5>
                            <span class="category-id">Catégorie #{{ category.id }}</span>
                        </div>
                        <div class="category-card-actions">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" 
                               class="action-btn view-btn">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                               class="action-btn edit-btn" >
                                <i class="fas fa-edit"></i>
                            </a>
                        </div>
                    </div>
                    
                    <div class="category-card-body">
                        <div class="category-services">
                            <label class="category-label">
                                <i class="fas fa-briefcase"></i> Services associés
                            </label>
                            {% if category.services is defined and category.services|length > 0 %}
                                <div class="services-count">
                                    <span class="badge bg-success">
                                        {{ category.services|length }} service(s)
                                    </span>
                                </div>
                                <div class="services-list">
                                    {% for service in category.services|slice(0, 5) %}
                                        <span class="service-tag">{{ service.name }}</span>
                                    {% endfor %}
                                    {% if category.services|length > 5 %}
                                        <span class="service-more">+{{ category.services|length - 5 }} autres</span>
                                    {% endif %}
                                </div>
                            {% else %}
                                <span class="badge bg-secondary">
                                    <i class="fas fa-times-circle"></i> Aucun service
                                </span>
                            {% endif %}
                        </div>
                        
                        {% if category.description is defined and category.description %}
                            <div class="category-description">
                                <label class="category-label">
                                    <i class="fas fa-info-circle"></i> Description
                                </label>
                                <p class="description-text">{{ category.description }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="categories-cards-header">
            <div class="text-center py-5">
                <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Aucune catégorie trouvée</h5>
                <p class="text-muted">Créez votre première catégorie pour organiser vos services</p>
                <a href="{{ path('app_category_new') }}" class="new-category-btn">
                    <i class="fas fa-plus-circle"></i>
                    Créer une Catégorie
                </a>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des compteurs (identique à service/index)
    document.querySelectorAll('.stats-number').forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target'));
        if (!isNaN(target)) {
            let current = 0;
            const increment = target / 30;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                counter.textContent = Math.floor(current);
            }, 50);
        }
    });

    // Recherche en temps réel
    const searchInput = document.getElementById('searchCategories');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            
            // Desktop table rows
            const tableRows = document.querySelectorAll('.categories-table-card .category-row');
            tableRows.forEach(row => {
                const categoryName = row.querySelector('.fw-bold').textContent.toLowerCase();
                if (categoryName.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            
            // Mobile cards
            const mobileCards = document.querySelectorAll('.category-card-mobile');
            mobileCards.forEach(card => {
                const categoryName = card.getAttribute('data-category-name');
                if (categoryName.includes(searchTerm)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    }

    // Initialiser les tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>

<style>
/* Desktop styles */
.category-icon {
    width: 35px;
    height: 35px;
    border-radius: 8px;
    background: linear-gradient(45deg, var(--taupe), var(--taupe-light));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
}

.category-row:hover .category-icon {
    transform: scale(1.1);
    transition: transform 0.3s ease;
}

.categories-table-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.08);
}

/* Mobile cards styles */
.categories-cards-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.category-card-mobile {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(162, 78, 50, 0.1);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
}

.category-card-mobile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.15);
}

.category-card-header {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.05), rgba(197, 101, 63, 0.02));
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(162, 78, 50, 0.1);
}

.category-card-icon {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-light));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
}

.category-card-title {
    flex: 1;
    margin: 0 1rem;
    min-width: 0;
}

.category-name {
    font-weight: 700;
    color: var(--taupe);
    margin: 0;
    font-size: 1.1rem;
    word-break: break-word;
}

.category-id {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.category-card-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
}

.action-btn {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid rgba(162, 78, 50, 0.2);
    background: rgba(255, 255, 255, 0.9);
    color: var(--taupe);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 1rem;
}

.action-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(162, 78, 50, 0.2);
}

.view-btn {
    border-color: rgba(59, 130, 246, 0.3);
    color: #3B82F6;
}

.edit-btn {
    border-color: rgba(162, 78, 50, 0.3);
    color: var(--taupe);
}

.view-btn:hover {
    background: #3B82F6;
    color: white;
}

.edit-btn:hover {
    background: var(--taupe);
    color: white;
}

.category-card-body {
    padding: 1.25rem;
}

.category-services {
    margin-bottom: 1.25rem;
}

.category-label {
    display: block;
    font-weight: 600;
    color: var(--taupe);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
}

.services-count {
    margin-bottom: 0.75rem;
}

.services-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.service-tag {
    background: rgba(162, 78, 50, 0.1);
    color: var(--taupe);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
}

.service-more {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
}

.category-description {
    padding-top: 1rem;
    border-top: 1px solid rgba(162, 78, 50, 0.1);
}

.description-text {
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .category-card-header {
        padding: 0.875rem;
    }
    
    .category-card-icon {
        width: 40px;
        height: 40px;
        font-size: 1.1rem;
    }
    
    .category-name {
        font-size: 1rem;
    }
    
    .action-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 0.5rem;
        font-size: 0.9rem;
    }
    
    .action-btn .action-btn-text {
        font-size: 0.85rem;
    }
    
    .category-card-body {
        padding: 1rem;
    }
}

@media (max-width: 480px) {
    .category-card-header {
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    
    .category-card-title {
        margin: 0;
        flex: 1 1 100%;
        order: 2;
    }
    
    .category-card-icon {
        order: 1;
    }
    
    .category-card-actions {
        order: 3;
        justify-content: flex-end;
    }
}
</style>
{% endblock %}
