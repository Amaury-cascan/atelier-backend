{% extends 'base_admin.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
<style>
.sch-form-wrap { max-width: 760px; margin: 0 auto; }
.sch-form-header {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.1), rgba(166, 139, 91, 0.05));
    border-radius: 20px;
    padding: 1.75rem 2rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
}
.sch-form-header h1 { margin: 0; font-size: 1.75rem; color: #6F5B47; }
.sch-form-header p { margin: 0.4rem 0 0; color: #6b6560; }
.sch-form-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.75rem;
    border: 1px solid rgba(139, 115, 85, 0.12);
    margin-bottom: 1.25rem;
}
.sch-form .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
}
.sch-form .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
.sch-form label { font-weight: 600; color: #6F5B47; font-size: 0.9rem; }
.sch-form input[type="date"],
.sch-form input[type="time"],
.sch-form input[type="text"],
.sch-form input[type="datetime-local"],
.sch-form select {
    padding: 0.75rem 1rem;
    border: 2px solid rgba(139, 115, 85, 0.15);
    border-radius: 10px;
    font-size: 1rem;
    background: #fff;
}
.sch-form input:focus, .sch-form select:focus {
    outline: none;
    border-color: #8B7355;
    box-shadow: 0 0 0 3px rgba(139, 115, 85, 0.12);
}
.sch-day {
    border: 1px solid #e8e2da;
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 0.75rem;
}
.sch-day-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
}
.sch-day-head strong { font-size: 1rem; color: #4a433c; }
.sch-ranges { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; }
.sch-range-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}
.sch-range-row .form-group { margin: 0; }
.sch-hint { color: #6b6560; font-size: 0.88rem; margin: 0 0 1rem; }
.sch-actions-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 0.5rem;
}
.sch-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 0.92rem;
}
.sch-btn--primary { background: linear-gradient(135deg, #8B7355, #6F5B47); color: #fff; }
.sch-btn--ghost { background: #fff; color: #6F5B47; border: 1px solid rgba(139, 115, 85, 0.25); }
.sch-btn--sm { padding: 6px 10px; font-size: 0.82rem; }
.sch-btn--danger { background: transparent; color: #c94a4a; border: 1px solid rgba(201, 74, 74, 0.3); }
.sch-ranges-wrap[data-kind]:not([data-kind="open"]) { display: none; }
@media (max-width: 700px) {
    .sch-form .form-row { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

{% block body %}
<div class="sch-form-wrap">
    <div class="sch-form-header">
        <h1>{{ title }}</h1>
        {% if subtitle is defined and subtitle %}<p>{{ subtitle }}</p>{% endif %}
    </div>

    <div class="sch-form-card">
        {{ form_start(form, {attr: {class: 'sch-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}

        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.effectiveFrom) }}
                {{ form_widget(form.effectiveFrom) }}
                {{ form_errors(form.effectiveFrom) }}
            </div>
            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {attr: {placeholder: 'Optionnel'}}) }}
                {{ form_errors(form.name) }}
            </div>
        </div>

        {% if not isEdit %}
            <p class="sch-hint">La nouvelle grille part d’une copie de celle active — tu ajustes ensuite.</p>
        {% endif %}

        {% for dayForm in form.weekly %}
            {% set weekday = dayForm.weekday.vars.value %}
            <div class="sch-day" data-day-block>
                <div class="sch-day-head">
                    <strong>{{ dayLabels[weekday] }}</strong>
                    <div class="form-group" style="margin:0; min-width:160px">
                        {{ form_widget(dayForm.kind, {attr: {'data-kind-select': true}}) }}
                    </div>
                </div>
                {{ form_widget(dayForm.weekday) }}
                <div class="form-group">
                    {{ form_label(dayForm.label) }}
                    {{ form_widget(dayForm.label) }}
                </div>
                <div class="sch-ranges-wrap" data-kind="{{ dayForm.kind.vars.value }}" data-ranges-wrap>
                    <div class="sch-ranges" data-collection-holder
                         data-prototype="{{ form_widget(dayForm.ranges.vars.prototype)|e('html_attr') }}"
                         data-index="{{ dayForm.ranges|length }}">
                        {% for rangeForm in dayForm.ranges %}
                            <div class="sch-range-row" data-range-item>
                                {{ form_widget(rangeForm.start) }}
                                <span>→</span>
                                {{ form_widget(rangeForm.end) }}
                                <button type="button" class="sch-btn sch-btn--danger sch-btn--sm" data-remove-range title="Retirer">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="sch-btn sch-btn--ghost sch-btn--sm" data-add-range style="margin-top:8px">
                        <i class="fas fa-plus"></i> Ajouter une plage
                    </button>
                </div>
            </div>
        {% endfor %}

        <div class="sch-actions-bar">
            <button type="submit" class="sch-btn sch-btn--primary">
                <i class="fas fa-save"></i> Enregistrer
            </button>
            <a href="{{ path('app_schedule_index') }}" class="sch-btn sch-btn--ghost">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    function syncKind(block) {
        var select = block.querySelector('[data-kind-select]');
        var wrap = block.querySelector('[data-ranges-wrap]');
        if (!select || !wrap) return;
        wrap.setAttribute('data-kind', select.value);
        var label = block.querySelector('input[name*="[label]"]');
        if (!label) return;
        if (select.value === 'closed' && (!label.value || label.value === 'Ouvert' || label.value === 'Prestation extérieure')) {
            label.value = 'Fermé';
        } else if (select.value === 'external' && (!label.value || label.value === 'Fermé' || label.value === 'Ouvert')) {
            label.value = 'Prestation extérieure';
        }
    }

    document.querySelectorAll('[data-day-block]').forEach(function (block) {
        var select = block.querySelector('[data-kind-select]');
        if (select) {
            select.addEventListener('change', function () { syncKind(block); });
            syncKind(block);
        }

        var holder = block.querySelector('[data-collection-holder]');
        var addBtn = block.querySelector('[data-add-range]');
        if (addBtn && holder) {
            addBtn.addEventListener('click', function () {
                var proto = holder.dataset.prototype;
                var index = parseInt(holder.dataset.index || '0', 10);
                var html = proto.replace(/__name__/g, String(index));
                var wrap = document.createElement('div');
                wrap.className = 'sch-range-row';
                wrap.setAttribute('data-range-item', '');
                wrap.innerHTML = html + '<button type="button" class="sch-btn sch-btn--danger sch-btn--sm" data-remove-range><i class="fas fa-times"></i></button>';
                holder.appendChild(wrap);
                holder.dataset.index = String(index + 1);
            });
        }
    });

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-remove-range]');
        if (!btn) return;
        var item = btn.closest('[data-range-item]');
        var holder = btn.closest('[data-collection-holder]');
        if (!item || !holder) return;
        if (holder.querySelectorAll('[data-range-item]').length <= 1) return;
        item.remove();
    });
})();
</script>
{% endblock %}
