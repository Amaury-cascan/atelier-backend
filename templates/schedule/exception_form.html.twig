{% extends 'base_admin.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
<style>
.sch-form-wrap { max-width: 520px; margin: 0 auto; }
.sch-form-header {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.1), rgba(166, 139, 91, 0.05));
    border-radius: 20px;
    padding: 1.75rem 2rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
}
.sch-form-header h1 { margin: 0; font-size: 1.75rem; color: #6F5B47; }
.sch-form-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.75rem;
    border: 1px solid rgba(139, 115, 85, 0.12);
}
.sch-form .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
.sch-form label { font-weight: 600; color: #6F5B47; font-size: 0.9rem; }
.sch-form input, .sch-form select {
    padding: 0.75rem 1rem;
    border: 2px solid rgba(139, 115, 85, 0.15);
    border-radius: 10px;
    font-size: 1rem;
}
.sch-ranges { display: flex; flex-direction: column; gap: 0.5rem; }
.sch-range-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.sch-ranges-wrap[data-kind]:not([data-kind="open"]) { display: none; }
.sch-actions-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 0.5rem; }
.sch-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 12px; font-weight: 600;
    text-decoration: none; border: none; cursor: pointer; font-size: 0.92rem;
}
.sch-btn--primary { background: linear-gradient(135deg, #8B7355, #6F5B47); color: #fff; }
.sch-btn--ghost { background: #fff; color: #6F5B47; border: 1px solid rgba(139, 115, 85, 0.25); }
.sch-btn--sm { padding: 6px 10px; font-size: 0.82rem; }
.sch-btn--danger { background: transparent; color: #c94a4a; border: 1px solid rgba(201, 74, 74, 0.3); }
</style>
{% endblock %}

{% block body %}
<div class="sch-form-wrap">
    <div class="sch-form-header">
        <h1>{{ title }}</h1>
    </div>
    <div class="sch-form-card">
        {{ form_start(form, {attr: {class: 'sch-form', novalidate: 'novalidate'}}) }}
        <div class="form-group">
            {{ form_label(form.date) }}
            {{ form_widget(form.date) }}
        </div>
        <div class="form-group">
            {{ form_label(form.kind) }}
            {{ form_widget(form.kind, {attr: {'data-kind-select': true}}) }}
        </div>
        <div class="form-group">
            {{ form_label(form.label) }}
            {{ form_widget(form.label) }}
        </div>
        <div class="sch-ranges-wrap" data-kind="{{ form.kind.vars.value }}" data-ranges-wrap>
            <label>Plages horaires</label>
            <div class="sch-ranges" data-collection-holder
                 data-prototype="{{ form_widget(form.ranges.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.ranges|length }}">
                {% for rangeForm in form.ranges %}
                    <div class="sch-range-row" data-range-item>
                        {{ form_widget(rangeForm.start) }}
                        <span>→</span>
                        {{ form_widget(rangeForm.end) }}
                        <button type="button" class="sch-btn sch-btn--danger sch-btn--sm" data-remove-range>
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                {% endfor %}
            </div>
            <button type="button" class="sch-btn sch-btn--ghost sch-btn--sm" data-add-range style="margin-top:8px">
                <i class="fas fa-plus"></i> Ajouter une plage
            </button>
        </div>
        <div class="sch-actions-bar">
            <button type="submit" class="sch-btn sch-btn--primary"><i class="fas fa-save"></i> Enregistrer</button>
            <a href="{{ path('app_schedule_index') }}" class="sch-btn sch-btn--ghost">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var select = document.querySelector('[data-kind-select]');
    var wrap = document.querySelector('[data-ranges-wrap]');
    function sync() {
        if (select && wrap) wrap.setAttribute('data-kind', select.value);
    }
    if (select) select.addEventListener('change', sync);
    sync();

    var holder = document.querySelector('[data-collection-holder]');
    var addBtn = document.querySelector('[data-add-range]');
    if (addBtn && holder) {
        addBtn.addEventListener('click', function () {
            var index = parseInt(holder.dataset.index || '0', 10);
            var html = holder.dataset.prototype.replace(/__name__/g, String(index));
            var row = document.createElement('div');
            row.className = 'sch-range-row';
            row.setAttribute('data-range-item', '');
            row.innerHTML = html + '<button type="button" class="sch-btn sch-btn--danger sch-btn--sm" data-remove-range><i class="fas fa-times"></i></button>';
            holder.appendChild(row);
            holder.dataset.index = String(index + 1);
        });
    }
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-remove-range]');
        if (!btn) return;
        var item = btn.closest('[data-range-item]');
        var h = btn.closest('[data-collection-holder]');
        if (!item || !h || h.querySelectorAll('[data-range-item]').length <= 1) return;
        item.remove();
    });
})();
</script>
{% endblock %}
