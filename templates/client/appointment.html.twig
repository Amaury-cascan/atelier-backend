{% extends 'base_admin.html.twig' %}

{% block title %}Rendez-vous de {{ client.firstName }} {{ client.name }}{% endblock %}

{% block body %}
    <h1>Rendez-vous de {{ client.firstName }} {{ client.name }}</h1>
    
    <div class="card mb-4">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date et heures</th>
                        <th>Prestation</th>
                        <th>Prix (€)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                {% set today = "now"|date('U') %}
                {% set jours = {
                    0: 'Dimanche',
                    1: 'Lundi',
                    2: 'Mardi',
                    3: 'Mercredi',
                    4: 'Jeudi',
                    5: 'Vendredi',
                    6: 'Samedi'
                } %}
                {% for appointment in appointments|sort((a, b) => b.date <=> a.date) %}
                <tr>
                    <td {% if appointment.date|date('U') < today %}style="background-color: lightgreen;"{% endif %}>
                        {{ jours[appointment.date|date('w')] }} {{ appointment.date|date('d-m-Y H:i') }}
                    </td>
                    <td {% if appointment.date|date('U') < today %}style="background-color: lightgreen;"{% endif %}>
                        {{ appointment.service ? appointment.service.name : '—' }}
                    </td>
                    <td {% if appointment.date|date('U') < today %}style="background-color: lightgreen;"{% endif %}>
                        {{ appointment.price ?? '—' }}
                    </td>
                    <td class="d-flex" {% if appointment.date|date('U') < today %}style="background-color: lightgreen;"{% endif %}>
                        <a href="#" class="btn btn-sm btn-primary mx-2 btn-edit-appointment" data-bs-toggle="modal" data-bs-target="#availableSlotsModal{{ client.id }}"
                           data-appointment-id="{{ appointment.id }}"
                           data-service-name="{{ appointment.service ? appointment.service.name : '' }}"
                           data-price="{{ appointment.price ?? '' }}"
                           data-service-id="{{ appointment.service ? appointment.service.id : '' }}"
                           data-appointment-date="{{ appointment.date|date('Y-m-d H:i') }}">Modifier</a>
                        {{ include('client/_delete_app.html.twig') }}
                    </td>
                </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">Aucun rendez-vous trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_client_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>

<!-- Modal -->
<div class="modal fade" id="availableSlotsModal{{ client.id }}" tabindex="-1" aria-labelledby="availableSlotsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="availableSlotsModalLabel">Modifier le rendez-vous</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="slotSelectionForm" method="POST" action="">
                    <input type="hidden" name="appointmentId" id="appointmentId" value="">
                    <input type="hidden" name="clientId" id="formClientId" value="{{ client.id }}">
                    <input type="hidden" name="serviceId" id="formServiceId" value="">
                    <input type="hidden" name="date" id="formDate" value="">

                    <div class="mb-3">
                        <p class="mb-1"><strong>Prestation :</strong> <span id="formServiceNameDisplay">—</span></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prix (€)</label>
                        <input type="number" class="form-control" name="price" id="formPrice" min="0" step="1" placeholder="Prix">
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" name="removeService" id="formRemoveService" value="1">
                        <label class="form-check-label" for="formRemoveService">Retirer le lien avec le service (garder nom et prix)</label>
                    </div>

                    <hr>
                    <p class="mb-2">Changer le créneau :</p>
                    <div class="d-flex justify-content-between mb-3">
                        <button type="button" class="btn btn-secondary" id="prevDay">Précédent</button>
                        <h6 id="currentDate">{{ currentDate|date('d-m-Y') }}</h6>
                        <button type="button" class="btn btn-secondary" id="nextDay">Suivant</button>
                    </div>
                    <div class="list-group" id="availableSlots">
                        {% for slot in availableSlots %}
                            <button type="button" class="list-group-item list-group-item-action slot-btn" data-slot="{{ slot|date('Y-m-d H:i') }}">
                                {{ slot|date('H:i') }}
                            </button>
                        {% else %}
                            <div class="list-group-item">Aucun créneau disponible</div>
                        {% endfor %}
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" id="btnSaveServicePrice">Enregistrer (prestation / prix uniquement)</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentDate = new Date("{{ currentDate|date('Y-m-d H:i') }}");
    let appointmentId;
    const slotsUrlTemplate = "{{ path('app_available_slots', { id: 'PLACEHOLDER' }) }}";

    document.querySelectorAll('.btn-edit-appointment').forEach(button => {
        button.addEventListener('click', function() {
            appointmentId = this.getAttribute('data-appointment-id');
            const serviceId = this.getAttribute('data-service-id') || '';
            const editUrl = "{{ path('app_appointment_edit', {'id': 'placeholder'}) }}".replace('placeholder', appointmentId);
            document.getElementById('slotSelectionForm').action = editUrl;
            document.getElementById('appointmentId').value = appointmentId;
            document.getElementById('formServiceNameDisplay').textContent = this.getAttribute('data-service-name') || '—';
            document.getElementById('formPrice').value = this.getAttribute('data-price') || '';
            document.getElementById('formServiceId').value = serviceId;
            document.getElementById('formServiceId').dataset.original = serviceId;
            document.getElementById('formDate').value = this.getAttribute('data-appointment-date') || '';
            document.getElementById('formRemoveService').checked = false;
            updateSlots();
        });
    });

    document.getElementById('formRemoveService').addEventListener('change', function() {
        const formServiceId = document.getElementById('formServiceId');
        formServiceId.value = this.checked ? '' : (formServiceId.dataset.original || '');
    });

    document.getElementById('slotSelectionForm').addEventListener('submit', function() {
        if (document.getElementById('formRemoveService').checked) {
            document.getElementById('formServiceId').value = '';
        }
    });

    document.getElementById('prevDay').addEventListener('click', function() {
        currentDate.setDate(currentDate.getDate() - 1);
        updateSlots();
    });

    document.getElementById('nextDay').addEventListener('click', function() {
        currentDate.setDate(currentDate.getDate() + 1);
        updateSlots();
    });

    document.getElementById('availableSlots').addEventListener('click', function(e) {
        const slotBtn = e.target.closest('.slot-btn');
        if (slotBtn && slotBtn.dataset.slot) {
            document.getElementById('formDate').value = slotBtn.dataset.slot;
            document.getElementById('slotSelectionForm').submit();
        }
    });

    function updateSlots() {
        if (!appointmentId) return;
        document.getElementById('currentDate').innerText = currentDate.toLocaleDateString('fr-FR');
        const url = slotsUrlTemplate.replace('PLACEHOLDER', appointmentId) + '?date=' + currentDate.toISOString();
        fetch(url)
            .then(response => response.json())
            .then(data => {
                const slotsContainer = document.getElementById('availableSlots');
                slotsContainer.innerHTML = '';
                if (data.slots && data.slots.length > 0) {
                    data.slots.forEach(slot => {
                        const slotDate = typeof slot === 'object' && slot.date ? slot.date : slot;
                        const d = new Date(slotDate);
                        const slotStr = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0') + ' ' + String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'list-group-item list-group-item-action slot-btn';
                        btn.dataset.slot = slotStr;
                        btn.innerText = d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
                        slotsContainer.appendChild(btn);
                    });
                } else {
                    slotsContainer.innerHTML = '<div class="list-group-item">Aucun créneau disponible</div>';
                }
            })
            .catch(error => console.error('Erreur créneaux:', error));
    }
</script>
{% endblock %}