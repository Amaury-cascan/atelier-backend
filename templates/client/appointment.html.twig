{% extends 'base_admin.html.twig' %}

{% block title %}Rendez-vous de {{ client.firstName }} {{ client.name }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Page RDV client — thème admin */
.apt-page-header {
    margin-bottom: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.apt-page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--adm-text);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.apt-page-title i { color: var(--adm-accent); }

.apt-actions-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.apt-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--adm-radius-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    font-family: inherit;
}

.apt-btn-back {
    background: var(--adm-bg);
    color: var(--adm-text);
    border-color: var(--adm-border);
}

.apt-btn-back:hover {
    background: var(--adm-accent-soft);
    color: var(--adm-accent);
    border-color: var(--adm-accent);
}

.apt-card {
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--adm-shadow);
}

.apt-table {
    width: 100%;
    border-collapse: collapse;
}

.apt-table thead {
    background: var(--adm-bg);
    border-bottom: 1px solid var(--adm-border);
}

.apt-table th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--adm-text);
    font-size: 0.9rem;
}

.apt-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--adm-border);
    color: var(--adm-text);
    vertical-align: middle;
}

.apt-table tbody tr:hover {
    background: var(--adm-accent-soft);
}

.apt-table .apt-row-past {
    background: rgba(45, 138, 94, 0.06);
}

.apt-table .apt-row-past:hover {
    background: rgba(45, 138, 94, 0.1);
}

.apt-table .apt-actions-cell {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.apt-table .action-btn {
    padding: 0.5rem 0.75rem;
    border-radius: var(--adm-radius-sm);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: inherit;
}

.apt-table .delete-btn {
    background: rgba(220, 53, 69, 0.12);
    color: #dc3545;
    border-color: #dc3545;
}

.apt-table .delete-btn:hover {
    background: #dc3545;
    color: #fff;
}

.apt-btn-edit {
    background: var(--adm-accent-soft);
    color: var(--adm-accent);
    border-color: var(--adm-accent);
}

.apt-btn-edit:hover {
    background: var(--adm-accent);
    color: #fff;
}

.apt-empty {
    text-align: center;
    padding: 2rem;
    color: var(--adm-text-muted);
}

/* Modal sans Bootstrap */
.apt-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
}

.apt-modal-overlay.open { display: flex; }

.apt-modal-panel {
    background: var(--adm-surface);
    border-radius: var(--adm-radius);
    border: 1px solid var(--adm-border);
    box-shadow: var(--adm-shadow-lg);
    max-width: 440px;
    width: 100%;
    max-height: 90vh;
    overflow: auto;
}

.apt-modal-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--adm-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.apt-modal-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--adm-text);
}

.apt-modal-close {
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--adm-text-muted);
    cursor: pointer;
    padding: 0.25rem;
    line-height: 1;
}

.apt-modal-close:hover { color: var(--adm-text); }

.apt-modal-body { padding: 1.25rem; }

.apt-form-group { margin-bottom: 1rem; }

.apt-form-label {
    display: block;
    font-weight: 600;
    color: var(--adm-text);
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
}

.apt-form-control {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius-sm);
    font-size: 1rem;
    font-family: inherit;
    color: var(--adm-text);
    box-sizing: border-box;
}

.apt-form-control:focus {
    outline: none;
    border-color: var(--adm-accent);
    box-shadow: 0 0 0 3px var(--adm-accent-soft);
}

.apt-form-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
}

.apt-form-check input { accent-color: var(--adm-accent); cursor: pointer; }

.apt-form-check label { cursor: pointer; font-size: 0.9rem; color: var(--adm-text-muted); margin: 0; }

.apt-modal hr { border: none; border-top: 1px solid var(--adm-border); margin: 1rem 0; }

.apt-slot-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.apt-slot-nav h6 { margin: 0; font-size: 1rem; color: var(--adm-text); }

.apt-slot-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.slot-btn {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius-sm);
    background: var(--adm-surface);
    color: var(--adm-text);
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    font-family: inherit;
}

.slot-btn:hover {
    background: var(--adm-accent-soft);
    border-color: var(--adm-accent);
}

.apt-slot-empty { padding: 0.75rem; color: var(--adm-text-muted); font-size: 0.9rem; }

.apt-btn-primary {
    background: var(--adm-accent);
    color: #fff;
    border: none;
    padding: 0.6rem 1rem;
    border-radius: var(--adm-radius-sm);
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
}

.apt-btn-primary:hover { background: var(--adm-accent-hover); }

.apt-btn-secondary {
    background: var(--adm-bg);
    color: var(--adm-text);
    border: 1px solid var(--adm-border);
}

.apt-btn-secondary:hover { background: var(--adm-accent-soft); border-color: var(--adm-accent); color: var(--adm-accent); }

.apt-modal-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--adm-border);
    display: flex;
    justify-content: flex-end;
}

/* Mobile — pas de débordement, tableau en cartes */
@media (max-width: 768px) {
    .adm-page-header {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        min-width: 0;
        overflow-x: hidden;
    }
    .apt-page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
    }
    .apt-page-title {
        font-size: 1.2rem;
        word-break: break-word;
        max-width: 100%;
    }
    .apt-actions-top { width: 100%; }
    .apt-actions-top .apt-btn {
        flex: 1;
        min-width: 0;
        justify-content: center;
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
    }
    .apt-card {
        padding: 1rem;
        box-sizing: border-box;
        min-width: 0;
        overflow-x: hidden;
    }
    .apt-table { min-width: 0; }
    .apt-table thead { display: none; }
    .apt-table tbody tr.apt-row {
        display: block;
        border: 1px solid var(--adm-border);
        border-radius: var(--adm-radius);
        padding: 1rem;
        margin-bottom: 0.75rem;
        background: var(--adm-surface);
        box-shadow: var(--adm-shadow);
    }
    .apt-table tbody tr.apt-row:last-child { margin-bottom: 0; }
    .apt-table tbody td {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        border-bottom: none;
        gap: 0.5rem;
    }
    .apt-table tbody td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--adm-text-muted);
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    .apt-table tbody td.apt-row-actions::before { display: none; }
    .apt-table tbody td.apt-row-actions {
        justify-content: flex-end;
        padding-top: 0.75rem;
        margin-top: 0.25rem;
        border-top: 1px solid var(--adm-border);
    }
    .apt-table .apt-actions-cell {
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .apt-table .apt-btn-edit,
    .apt-table .action-btn {
        font-size: 0.8rem;
        padding: 0.4rem 0.6rem;
    }
    .apt-modal-overlay { padding: 0.5rem; align-items: flex-start; }
    .apt-modal-panel {
        max-width: 100%;
        margin: auto 0;
        max-height: 85vh;
    }
    .apt-modal-header,
    .apt-modal-body,
    .apt-modal-footer {
        padding-left: 1rem;
        padding-right: 1rem;
    }
    .apt-slot-nav {
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .apt-slot-nav h6 { font-size: 0.9rem; }
    .apt-slot-list { gap: 0.4rem; }
    .slot-btn { padding: 0.4rem 0.6rem; font-size: 0.85rem; }
}
</style>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <div class="apt-page-header">
        <h1 class="apt-page-title">
            <i class="fas fa-calendar-check"></i>
            Rendez-vous de {{ client.firstName }} {{ client.name }}
        </h1>
        <div class="apt-actions-top">
            <a href="{{ path('app_client_show', {'id': client.id}) }}" class="apt-btn apt-btn-back">
                <i class="fas fa-user"></i> Fiche client
            </a>
            <a href="{{ path('app_client_index') }}" class="apt-btn apt-btn-back">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>

<div class="apt-card">
    {% set today = "now"|date('U') %}
    {% set jours = {
        0: 'Dimanche',
        1: 'Lundi',
        2: 'Mardi',
        3: 'Mercredi',
        4: 'Jeudi',
        5: 'Vendredi',
        6: 'Samedi'
    } %}
    {% if appointments is not empty %}
        <table class="apt-table">
            <thead>
                <tr>
                    <th>Date et heure</th>
                    <th>Prestation</th>
                    <th>Prix (€)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for appointment in appointments %}
                    {% set isPast = appointment.date|date('U') < today %}
                    <tr class="apt-row {{ isPast ? 'apt-row-past' : '' }}">
                        <td data-label="Date et heure">{{ jours[appointment.date|date('w')] }} {{ appointment.date|date('d/m/Y H:i') }}</td>
                        <td data-label="Prestation">{{ appointment.service ? appointment.service.name : '—' }}</td>
                        <td data-label="Prix (€)">{{ appointment.price ?? '—' }}</td>
                        <td data-label="" class="apt-row-actions">
                            <div class="apt-actions-cell">
                                <button type="button" class="apt-btn apt-btn-edit btn-edit-appointment"
                                        data-appointment-id="{{ appointment.id }}"
                                        data-service-name="{{ appointment.service ? appointment.service.name : '' }}"
                                        data-price="{{ appointment.price ?? '' }}"
                                        data-service-id="{{ appointment.service ? appointment.service.id : '' }}"
                                        data-appointment-date="{{ appointment.date|date('Y-m-d H:i') }}">
                                    <i class="fas fa-edit"></i> Modifier
                                </button>
                                {{ include('client/_delete_app.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="apt-empty">
            <p><i class="fas fa-calendar-times"></i> Aucun rendez-vous pour ce client.</p>
        </div>
    {% endif %}
</div>

<!-- Modal Modifier RDV (sans Bootstrap) -->
<div class="apt-modal-overlay" id="availableSlotsModal" aria-hidden="true">
    <div class="apt-modal-panel" onclick="event.stopPropagation()">
        <div class="apt-modal-header">
            <h2 class="apt-modal-title" id="availableSlotsModalLabel">Modifier le rendez-vous</h2>
            <button type="button" class="apt-modal-close" id="aptModalClose" aria-label="Fermer">&times;</button>
        </div>
        <div class="apt-modal-body">
            <form id="slotSelectionForm" method="POST" action="">
                <input type="hidden" name="appointmentId" id="appointmentId" value="">
                <input type="hidden" name="clientId" id="formClientId" value="{{ client.id }}">
                <input type="hidden" name="serviceId" id="formServiceId" value="">
                <input type="hidden" name="date" id="formDate" value="">

                <div class="apt-form-group">
                    <p style="margin:0;"><strong>Prestation :</strong> <span id="formServiceNameDisplay">—</span></p>
                </div>
                <div class="apt-form-group">
                    <label class="apt-form-label">Prix (€)</label>
                    <input type="number" class="apt-form-control" name="price" id="formPrice" min="0" step="1" placeholder="Prix">
                </div>
                <div class="apt-form-group" style="margin-bottom:0.5rem;">
                    <button type="submit" class="apt-btn apt-btn-primary" id="btnSaveServicePrice">
                        <i class="fas fa-save"></i> Enregistrer
                    </button>
                </div>

                <hr>
                <p class="apt-form-label" style="margin-bottom:0.5rem;">Changer le créneau :</p>
                <div class="apt-slot-nav">
                    <button type="button" class="apt-btn apt-btn-secondary" id="prevDay">Précédent</button>
                    <h6 id="currentDate">{{ currentDate|date('d-m-Y') }}</h6>
                    <button type="button" class="apt-btn apt-btn-secondary" id="nextDay">Suivant</button>
                </div>
                <div class="apt-slot-list" id="availableSlots">
                    {% for slot in availableSlots %}
                        <button type="button" class="slot-btn" data-slot="{{ slot|date('Y-m-d H:i') }}">
                            {{ slot|date('H:i') }}
                        </button>
                    {% else %}
                        <div class="apt-slot-empty">Aucun créneau disponible</div>
                    {% endfor %}
                </div>

            </form>
        </div>
        <div class="apt-modal-footer">
            <button type="button" class="apt-btn apt-btn-secondary" id="aptModalCloseBtn">Fermer</button>
        </div>
    </div>
</div>

<script>
(function() {
    let currentDate = new Date("{{ currentDate|date('Y-m-d H:i') }}");
    let appointmentId;
    const slotsUrlTemplate = "{{ path('app_available_slots', { id: 'PLACEHOLDER' }) }}";
    const modal = document.getElementById('availableSlotsModal');

    function openModal() { if (modal) modal.classList.add('open'); }
    function closeModal() { if (modal) modal.classList.remove('open'); }

    document.querySelectorAll('.btn-edit-appointment').forEach(function(btn) {
        btn.addEventListener('click', function() {
            appointmentId = this.getAttribute('data-appointment-id');
            const serviceId = this.getAttribute('data-service-id') || '';
            const editUrl = "{{ path('app_appointment_edit', {'id': 'placeholder'}) }}".replace('placeholder', appointmentId);
            document.getElementById('slotSelectionForm').action = editUrl;
            document.getElementById('appointmentId').value = appointmentId;
            document.getElementById('formServiceNameDisplay').textContent = this.getAttribute('data-service-name') || '—';
            document.getElementById('formPrice').value = this.getAttribute('data-price') || '';
            document.getElementById('formServiceId').value = serviceId;
            document.getElementById('formDate').value = this.getAttribute('data-appointment-date') || '';
            updateSlots();
            openModal();
        });
    });

    if (document.getElementById('aptModalClose')) document.getElementById('aptModalClose').addEventListener('click', closeModal);
    if (document.getElementById('aptModalCloseBtn')) document.getElementById('aptModalCloseBtn').addEventListener('click', closeModal);
    if (modal) modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

    document.getElementById('prevDay').addEventListener('click', function() {
        currentDate.setDate(currentDate.getDate() - 1);
        updateSlots();
    });

    document.getElementById('nextDay').addEventListener('click', function() {
        currentDate.setDate(currentDate.getDate() + 1);
        updateSlots();
    });

    document.getElementById('availableSlots').addEventListener('click', function(e) {
        const slotBtn = e.target.closest('.slot-btn');
        if (slotBtn && slotBtn.dataset.slot) {
            document.getElementById('formDate').value = slotBtn.dataset.slot;
            document.getElementById('slotSelectionForm').submit();
        }
    });

    function updateSlots() {
        if (!appointmentId) return;
        document.getElementById('currentDate').innerText = currentDate.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
        const url = slotsUrlTemplate.replace('PLACEHOLDER', appointmentId) + '?date=' + currentDate.toISOString();
        fetch(url)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                const slotsContainer = document.getElementById('availableSlots');
                slotsContainer.innerHTML = '';
                if (data.slots && data.slots.length > 0) {
                    data.slots.forEach(function(slot) {
                        const slotDate = typeof slot === 'object' && slot.date ? slot.date : slot;
                        const d = new Date(slotDate);
                        const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), day = String(d.getDate()).padStart(2,'0');
                        const h = String(d.getHours()).padStart(2,'0'), min = String(d.getMinutes()).padStart(2,'0');
                        const slotStr = y + '-' + m + '-' + day + ' ' + h + ':' + min;
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'slot-btn';
                        btn.dataset.slot = slotStr;
                        btn.innerText = d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
                        slotsContainer.appendChild(btn);
                    });
                } else {
                    slotsContainer.innerHTML = '<div class="apt-slot-empty">Aucun créneau disponible</div>';
                }
            })
            .catch(function(err) { console.error('Erreur créneaux:', err); });
    }
})();
</script>
{% endblock %}
