{% extends 'base.html.twig' %}

{% block title %}Modifier {{client.firstName}} {{client.name}}{% endblock %}

{% block body %}
    <h1 class="mb-4">Modifier {{client.firstName}} {{client.name}}</h1>

    <div class="card mb-4">
        <div class="card-body">
            {{ include('client/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_client_index') }}" class="btn btn-secondary">Retour à la liste</a>
        {{ include('client/_delete_form.html.twig') }}
    </div>
{% endblock %}