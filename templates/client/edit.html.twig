{% extends 'base.html.twig' %}

{% block title %}Modifier {{client.firstName}} {{client.name}}{% endblock %}

{% block stylesheets %}
<style>
.form-container {
    max-width: 800px;
    margin: 0 auto;
}

.form-header {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.1), rgba(166, 139, 91, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    text-align: center;
}

.form-title {
    color: var(--primary-color);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, #8B7355, #6F5B47);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.form-subtitle {
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-size: 1rem;
}

.form-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 10px 25px rgba(139, 115, 85, 0.08),
        0 4px 15px rgba(139, 115, 85, 0.05);
    margin-bottom: 2rem;
    position: relative;
}

.form-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #8B7355, #A68B5B);
    border-radius: 20px 20px 0 0;
}

.actions-container {
    display: flex;
    gap: 1rem;
    justify-content: flex-start;
    flex-wrap: wrap;
    align-items: center;
}

.back-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-secondary);
    border: 1px solid rgba(139, 115, 85, 0.2);
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.back-btn:hover {
    background: var(--primary-color);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(139, 115, 85, 0.2);
}

/* Style pour le bouton de suppression inclus */
.delete-form-container {
    display: contents;
}

/* Responsive */
@media (max-width: 768px) {
    .form-card {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .form-header {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .form-title {
        font-size: 1.6rem;
        flex-direction: column;
    }
    
    .actions-container {
        justify-content: center;
        flex-direction: column;
        align-items: stretch;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="form-container" data-animate="true">
    <div class="form-header">
        <h1 class="form-title">
            <i class="fas fa-user-edit"></i>
            Modifier {{client.firstName}} {{client.name}}
        </h1>
        <p class="form-subtitle">Modifiez les informations de ce client</p>
    </div>

    <div class="form-card">
        {{ include('client/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>

    <div class="actions-container">
        <a href="{{ path('app_client_index') }}" class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Retour à la liste
        </a>
        <div class="delete-form-container">
            {{ include('client/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}