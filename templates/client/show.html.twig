{% extends 'base.html.twig' %}

{% block title %}Détails de {{ client.firstName }} {{ client.name }}{% endblock %}

{% block body %}
    <h1>Détails de {{ client.firstName }} {{ client.name }}</h1>
    <div class="d-flex gap-2 mb-2 justify-content-end">
        <a href="{{ path('app_client_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="btn btn-primary">Modifier</a>
        {{ include('client/_delete_form.html.twig') }}
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <table class="table table-striped">
                <tbody>
                <tr>
                    <th>Prénom</th>
                    <td>{{ client.firstName }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ client.name }}</td>
                </tr>
                <tr>
                    <th>Email</th>
                    <td>{{ client.email }}</td>
                </tr>
                <tr>
                    <th>Numéro</th>
                    <td>{{ client.phoneNumber }}</td>
                </tr>
                <tr>
                    <th>Comment m'avez vous connue ?</th>
                    <td>{{ client.connu }}</td>
                </tr>
                <tr>
                    <th>Etat des ongles</th>
                    <td>{{ client.etat }}</td>
                </tr>
                <tr>
                    <th>Notes</th>
                    <td>{{ client.note }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <h3>Historique client</h3>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Date</th>
            <th>Technique</th>
            <th>Forme</th>
            <th>Produits</th>
            <th>Prix</th>
            <th>Note</th>
            <th>Photos</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for info in clientInformation %}
            <tr>
                <td>{{ info.date ? info.date|date('d/m/y') : ' ' }}</td>
                <td>{{ info.technique }}</td>
                <td>{{ info.forme }}</td>
                <td>{{ info.produit }}</td>
                <td>{{ info.prix }}€</td>
                <td>
                    <span class="note-preview" data-full-note="{{ info.note }}">
                        {{ info.note|split(' ')|slice(0, 3)|join(' ') }}...
                    </span>
                </td>
                <td>
                    <button
                            class="btn btn-secondary open-carousel"
                            data-id="{{ info.id }}"
                            data-firstName="{{ client.firstName }}"
                            data-name="{{ client.name }}"
                            data-images="{{ info.pictures|map(p => p.name)|join(',') }}"
                            data-technique="{{ info.technique }}"
                            data-forme="{{ info.forme }}"
                            data-produit="{{ info.produit }}"
                            data-date="{{ info.date ? info.date|date('d/m/y') : '' }}"
                    >
                        Voir
                    </button>
                </td>
                <td class="d-flex gap-1">
                    <a href="{{ path('app_client_information_edit', {'id': info.id}) }}" class="btn btn-primary">Modifier</a>
                    <form action="{{ path('app_client_information_delete', {'id': info.id}) }}" method="post" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ info.id) }}">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette information ?');">X</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucune information disponible pour ce client.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <button id="toggleForm" class="btn btn-info">Ajouter une nouvelle information</button>

    <div id="newInformationForm" style="display: none;">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-success">Ajouter</button>
        {{ form_end(form) }}
    </div>

    <!-- Modale pour afficher la note complète -->
    <div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="noteModalLabel">Détails</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="modal-note-content">
                    <!-- La note complète sera affichée ici -->
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade carou-modal" id="carouselModal" tabindex="-1" aria-labelledby="carouselModalLabel" aria-hidden="true">
        <div class="modal-dialog" style="max-width: 600px;"> <!-- Taille de la modale ajustée -->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="carouselModalLabel">Détails</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Détails dynamiques -->
                    <div id="carouselDetails" class="mb-3">
                        <!-- Les informations seront insérées ici -->
                    </div>

                    <!-- Carrousel -->
                    <div id="carouselImages" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner" id="carouselContent">
                            <!-- Les images dynamiques seront insérées ici -->
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselImages" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Précédent</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselImages" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Suivant</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script>
        document.getElementById('toggleForm').addEventListener('click', function () {
            var formDiv = document.getElementById('newInformationForm');
            if (formDiv.style.display === 'none') {
                formDiv.style.display = 'block';
                this.textContent = 'Cacher le formulaire'; // Change le texte du bouton
            } else {
                formDiv.style.display = 'none';
                this.textContent = 'Ajouter une nouvelle information'; // Change le texte du bouton
            }
        });

        // Afficher la note complète dans la modale lors du clic
        document.querySelectorAll('.note-preview').forEach(function(note) {
            note.addEventListener('click', function() {
                const fullNote = this.getAttribute('data-full-note');
                document.getElementById('modal-note-content').innerText = fullNote; // Mettre à jour le contenu de la modale
                const noteModal = new bootstrap.Modal(document.getElementById('noteModal')); // Créer une instance de la modale
                noteModal.show(); // Afficher la modale
            });
        });

        document.querySelectorAll('.open-carousel').forEach(function(button) {
            button.addEventListener('click', function() {
                // Récupérer les informations dynamiques
                const images = this.getAttribute('data-images').split(',');
                const technique = this.getAttribute('data-technique');
                const forme = this.getAttribute('data-forme');
                const produit = this.getAttribute('data-produit');
                const date = this.getAttribute('data-date');
                const firstName = this.getAttribute('data-firstName');
                const name = this.getAttribute('data-name')

                // Mettre à jour les informations de la modale
                const modalTitle = document.getElementById('carouselModalLabel');
                modalTitle.textContent = `Séance du ${date} - ${firstName} ${name}`;

                const modalDetails = document.getElementById('carouselDetails');
                modalDetails.innerHTML = `
            <p><strong>Technique :</strong> ${technique}</p>
            <p><strong>Forme :</strong> ${forme}</p>
            <p><strong>Produit :</strong> ${produit}</p>
        `;

                // Mettre à jour les images du carrousel
                const carouselContent = document.getElementById('carouselContent');
                carouselContent.innerHTML = ''; // Effacer les images précédentes

                images.forEach((image, index) => {
                    const activeClass = index === 0 ? 'active' : '';
                    const carouselItem = `
                <div class="carousel-item ${activeClass}">
                    <img src="/images/client/${image}" class="d-block w-100" alt="Image ${index + 1}">
                </div>
            `;
                    carouselContent.innerHTML += carouselItem;
                });

                // Afficher la modale
                const carouselModal = new bootstrap.Modal(document.getElementById('carouselModal'));
                carouselModal.show();
            });
        });

    </script>
    <style>
        .carousel-item img {
            max-width: 100%;  /* Limite la largeur à celle de la modale */
            max-height: 400px; /* Définit une hauteur maximale pour éviter que les images soient trop grandes */
            object-fit: contain; /* Garde les proportions des images */
            margin: auto; /* Centre les images */
        }
        .carou-modal {
            max-width: 100vw;
            max-height: 100vh;
        }
    </style>
{% endblock %}
