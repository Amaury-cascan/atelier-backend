{% extends 'base.html.twig' %}

{% block title %}Détails de {{ client.firstName }} {{ client.name }}{% endblock %}

{% block stylesheets %}
<style>
.client-container {
    max-width: 1200px;
    margin: 0 auto;
}

.client-header {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.1), rgba(166, 139, 91, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.client-title {
    color: var(--primary-color);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, #8B7355, #6F5B47);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 12px;
}

.client-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.action-btn {
    padding: 12px 20px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
}

.back-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-secondary);
    border: 1px solid rgba(139, 115, 85, 0.2);
}

.back-btn:hover {
    background: var(--primary-color);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(139, 115, 85, 0.2);
}

.edit-btn {
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
}

.edit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(139, 115, 85, 0.3);
    color: white;
}

/* Client details card */
.client-details-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 10px 25px rgba(139, 115, 85, 0.08),
        0 4px 15px rgba(139, 115, 85, 0.05);
    margin-bottom: 2rem;
    position: relative;
}

.client-details-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #8B7355, #A68B5B);
    border-radius: 20px 20px 0 0;
}

.details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.detail-item {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: rgba(139, 115, 85, 0.03);
    border-radius: 12px;
    border-left: 4px solid var(--primary-color);
}

.detail-label {
    font-weight: 600;
    color: var(--primary-color);
    min-width: 120px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-value {
    color: var(--text-primary);
    font-weight: 500;
}

/* History section */
.history-section {
    margin-top: 3rem;
}

.section-title {
    color: var(--primary-color);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 12px;
}

.history-table-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 10px 25px rgba(139, 115, 85, 0.08),
        0 4px 15px rgba(139, 115, 85, 0.05);
    overflow: hidden;
    margin-bottom: 2rem;
}

.modern-table {
    width: 100%;
    border-collapse: collapse;
}

.modern-table thead {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.05), rgba(166, 139, 91, 0.02));
}

.modern-table th {
    padding: 1rem 1.5rem;
    text-align: left;
    font-weight: 600;
    color: var(--primary-color);
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
    white-space: nowrap;
}

.modern-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(139, 115, 85, 0.05);
    vertical-align: middle;
}

.history-row {
    transition: all 0.3s ease;
}

.history-row:hover {
    background: rgba(139, 115, 85, 0.03);
}

.price-cell {
    font-weight: 700;
    color: #22C55E;
}

.note-preview {
    cursor: pointer;
    padding: 6px 12px;
    background: rgba(139, 115, 85, 0.1);
    border-radius: 8px;
    transition: all 0.3s ease;
}

.note-preview:hover {
    background: rgba(139, 115, 85, 0.2);
    transform: scale(1.05);
}

.table-actions {
    display: flex;
    gap: 6px;
}

.table-btn {
    padding: 6px 12px;
    border-radius: 8px;
    border: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s ease;
    cursor: pointer;
}

.view-btn {
    background: rgba(59, 130, 246, 0.1);
    color: #3B82F6;
}

.view-btn:hover {
    background: #3B82F6;
    color: white;
    transform: translateY(-1px);
}

.edit-small-btn {
    background: rgba(139, 115, 85, 0.1);
    color: var(--primary-color);
}

.edit-small-btn:hover {
    background: var(--primary-color);
    color: white;
    transform: translateY(-1px);
}

.delete-small-btn {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

.delete-small-btn:hover {
    background: #EF4444;
    color: white;
    transform: translateY(-1px);
}

/* Add information section */
.add-info-section {
    margin-top: 2rem;
}

.toggle-form-btn {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.toggle-form-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(34, 197, 94, 0.3);
}

.form-container {
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 8px 20px rgba(139, 115, 85, 0.08),
        0 4px 12px rgba(139, 115, 85, 0.05);
}

.submit-btn {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.2);
}

/* Empty state */
.empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--text-secondary);
}

.empty-icon {
    font-size: 3rem;
    color: var(--text-light);
    margin-bottom: 1rem;
}

/* Modal customization */
.modal-content {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(139, 115, 85, 0.1);
    border-radius: 16px;
}

.modal-header {
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.05), rgba(166, 139, 91, 0.02));
}

.modal-title {
    color: var(--primary-color);
    font-weight: 600;
}

.carousel-item img {
    max-width: 100%;
    max-height: 400px;
    object-fit: contain;
    margin: auto;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(139, 115, 85, 0.15);
}

/* Responsive */
@media (max-width: 768px) {
    .client-header {
        flex-direction: column;
        text-align: center;
    }
    
    .client-title {
        font-size: 1.6rem;
    }
    
    .client-actions {
        justify-content: center;
        width: 100%;
    }
    
    .action-btn {
        flex: 1;
        justify-content: center;
    }
    
    .details-grid {
        grid-template-columns: 1fr;
    }
    
    .client-details-card {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    .modern-table {
        min-width: 800px;
    }
    
    .table-actions {
        flex-direction: column;
        width: 100%;
    }
    
    .table-btn {
        width: 100%;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="client-container" data-animate="true">
    <!-- Header -->
    <div class="client-header">
        <h1 class="client-title">
            <i class="fas fa-user-circle"></i>
            {{ client.firstName }} {{ client.name }}
        </h1>
        <div class="client-actions">
            <a href="{{ path('app_client_index') }}" class="action-btn back-btn">
                <i class="fas fa-arrow-left"></i>
                Retour à la liste
            </a>
            <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="action-btn edit-btn">
                <i class="fas fa-edit"></i>
                Modifier
            </a>
            {{ include('client/_delete_form.html.twig') }}
        </div>
    </div>

    <!-- Client Details -->
    <div class="client-details-card" data-animate="true">
        <div class="details-grid">
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-user"></i>
                    Prénom
                </div>
                <div class="detail-value">{{ client.firstName }}</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-id-badge"></i>
                    Nom
                </div>
                <div class="detail-value">{{ client.name }}</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-envelope"></i>
                    Email
                </div>
                <div class="detail-value">{{ client.email ?: 'Non renseigné' }}</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-phone"></i>
                    Téléphone
                </div>
                <div class="detail-value">{{ client.phoneNumber ?: 'Non renseigné' }}</div>
            </div>
            
            {% if client.connu %}
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-handshake"></i>
                    Comment connue
                </div>
                <div class="detail-value">{{ client.connu }}</div>
            </div>
            {% endif %}
            
            {% if client.etat %}
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-hand-paper"></i>
                    État des ongles
                </div>
                <div class="detail-value">{{ client.etat }}</div>
            </div>
            {% endif %}
            
            {% if client.note %}
            <div class="detail-item" style="grid-column: 1 / -1;">
                <div class="detail-label">
                    <i class="fas fa-sticky-note"></i>
                    Notes
                </div>
                <div class="detail-value">{{ client.note }}</div>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- History Section -->
    <div class="history-section" data-animate="true">
        <h3 class="section-title">
            <i class="fas fa-history"></i>
            Historique client
        </h3>

        <div class="history-table-card">
            <div class="table-responsive">
                {% if clientInformation is not empty %}
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar"></i> Date</th>
                                <th><i class="fas fa-palette"></i> Technique</th>
                                <th><i class="fas fa-shapes"></i> Forme</th>
                                <th><i class="fas fa-box"></i> Produits</th>
                                <th><i class="fas fa-euro-sign"></i> Prix</th>
                                <th><i class="fas fa-comment"></i> Note</th>
                                <th><i class="fas fa-images"></i> Photos</th>
                                <th><i class="fas fa-cog"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for info in clientInformation %}
                                <tr class="history-row">
                                    <td>{{ info.date ? info.date|date('d/m/Y') : '-' }}</td>
                                    <td>{{ info.technique ?: '-' }}</td>
                                    <td>{{ info.forme ?: '-' }}</td>
                                    <td>{{ info.produit ?: '-' }}</td>
                                    <td class="price-cell">{{ info.prix ? info.prix ~ '€' : '-' }}</td>
                                    <td>
                                        {% if info.note %}
                                            <span class="note-preview" data-full-note="{{ info.note }}">
                                                {{ info.note|split(' ')|slice(0, 3)|join(' ') }}...
                                            </span>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        <button class="table-btn view-btn open-carousel"
                                                data-id="{{ info.id }}"
                                                data-firstName="{{ client.firstName }}"
                                                data-name="{{ client.name }}"
                                                data-images="{{ info.pictures|map(p => p.name)|join(',') }}"
                                                data-technique="{{ info.technique }}"
                                                data-forme="{{ info.forme }}"
                                                data-produit="{{ info.produit }}"
                                                data-date="{{ info.date ? info.date|date('d/m/Y') : '' }}">
                                            <i class="fas fa-eye"></i>
                                            Voir
                                        </button>
                                    </td>
                                    <td>
                                        <div class="table-actions">
                                            <a href="{{ path('app_client_information_edit', {'id': info.id}) }}" 
                                               class="table-btn edit-small-btn">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="{{ path('app_client_information_delete', {'id': info.id}) }}" 
                                                  method="post" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ info.id) }}">
                                                <button type="submit" 
                                                        class="table-btn delete-small-btn" 
                                                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette information ?');">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-calendar-times"></i>
                        </div>
                        <h5>Aucun historique disponible</h5>
                        <p>Aucune prestation n'a encore été enregistrée pour ce client.</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Add Information -->
        <div class="add-info-section">
            <button id="toggleForm" class="toggle-form-btn">
                <i class="fas fa-plus"></i>
                Ajouter une nouvelle information
            </button>

            <div id="newInformationForm" class="form-container" style="display: none;">
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="submit-btn">
                    <i class="fas fa-save"></i>
                    Ajouter
                </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<!-- Note Modal -->
<div class="modal fade" id="noteModal" tabindex="-1" aria-labelledby="noteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="noteModalLabel">
                    <i class="fas fa-sticky-note"></i>
                    Note complète
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-note-content">
                <!-- La note complète sera affichée ici -->
            </div>
        </div>
    </div>
</div>

<!-- Carousel Modal -->
<div class="modal fade" id="carouselModal" tabindex="-1" aria-labelledby="carouselModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="carouselModalLabel">
                    <i class="fas fa-images"></i>
                    Détails de la séance
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Détails dynamiques -->
                <div id="carouselDetails" class="mb-3">
                    <!-- Les informations seront insérées ici -->
                </div>

                <!-- Carrousel -->
                <div id="carouselImages" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner" id="carouselContent">
                        <!-- Les images dynamiques seront insérées ici -->
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselImages" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Précédent</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselImages" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Suivant</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle form visibility
    document.getElementById('toggleForm').addEventListener('click', function () {
        var formDiv = document.getElementById('newInformationForm');
        if (formDiv.style.display === 'none') {
            formDiv.style.display = 'block';
            this.innerHTML = '<i class="fas fa-minus"></i> Cacher le formulaire';
        } else {
            formDiv.style.display = 'none';
            this.innerHTML = '<i class="fas fa-plus"></i> Ajouter une nouvelle information';
        }
    });

    // Note modal functionality
    document.querySelectorAll('.note-preview').forEach(function(note) {
        note.addEventListener('click', function() {
            const fullNote = this.getAttribute('data-full-note');
            document.getElementById('modal-note-content').innerText = fullNote;
            const noteModal = new bootstrap.Modal(document.getElementById('noteModal'));
            noteModal.show();
        });
    });

    // Carousel modal functionality
    document.querySelectorAll('.open-carousel').forEach(function(button) {
        button.addEventListener('click', function() {
            const images = this.getAttribute('data-images').split(',');
            const technique = this.getAttribute('data-technique');
            const forme = this.getAttribute('data-forme');
            const produit = this.getAttribute('data-produit');
            const date = this.getAttribute('data-date');
            const firstName = this.getAttribute('data-firstName');
            const name = this.getAttribute('data-name');

            // Update modal title
            const modalTitle = document.getElementById('carouselModalLabel');
            modalTitle.innerHTML = `<i class="fas fa-images"></i> Séance du ${date} - ${firstName} ${name}`;

            // Update modal details
            const modalDetails = document.getElementById('carouselDetails');
            modalDetails.innerHTML = `
                <div class="row">
                    <div class="col-md-4"><strong><i class="fas fa-palette"></i> Technique :</strong> ${technique}</div>
                    <div class="col-md-4"><strong><i class="fas fa-shapes"></i> Forme :</strong> ${forme}</div>
                    <div class="col-md-4"><strong><i class="fas fa-box"></i> Produit :</strong> ${produit}</div>
                </div>
            `;

            // Update carousel images
            const carouselContent = document.getElementById('carouselContent');
            carouselContent.innerHTML = '';

            if (images.length > 0 && images[0] !== '') {
                images.forEach((image, index) => {
                    const activeClass = index === 0 ? 'active' : '';
                    const carouselItem = `
                        <div class="carousel-item ${activeClass}">
                            <img src="/images/client/${image}" class="d-block w-100" alt="Image ${index + 1}">
                        </div>
                    `;
                    carouselContent.innerHTML += carouselItem;
                });
            } else {
                carouselContent.innerHTML = `
                    <div class="carousel-item active">
                        <div class="d-flex justify-content-center align-items-center" style="height: 300px; background: rgba(139, 115, 85, 0.1); border-radius: 12px;">
                            <div class="text-center text-muted">
                                <i class="fas fa-image fa-3x mb-3"></i>
                                <p>Aucune image disponible</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Show modal
            const carouselModal = new bootstrap.Modal(document.getElementById('carouselModal'));
            carouselModal.show();
        });
    });
});
</script>
{% endblock %}
