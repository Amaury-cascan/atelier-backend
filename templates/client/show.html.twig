{% extends 'base_admin.html.twig' %}

{% block title %}Détails de {{ client.firstName }} {{ client.name }}{% endblock %}

{% block stylesheets %}
<style>
.client-container {
    max-width: 1200px;
    margin: 0 auto;
}

.client-header {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.1), rgba(166, 139, 91, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.client-title {
    color: var(--primary-color);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, #8B7355, #6F5B47);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 12px;
}

.client-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.action-btn {
    padding: 12px 20px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
}

.back-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-secondary);
    border: 1px solid rgba(139, 115, 85, 0.2);
}

.back-btn:hover {
    background: var(--primary-color);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(139, 115, 85, 0.2);
}

.edit-btn {
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
}

.edit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(139, 115, 85, 0.3);
    color: white;
}

.delete-btn {
    background: var(--adm-error, #c94a4a);
    color: white;
    border: 1px solid transparent;
}

.delete-btn:hover {
    background: #b03a3a;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(201, 74, 74, 0.3);
}

.client-delete-form {
    display: inline-block;
}

/* Client details card */
.client-details-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 10px 25px rgba(139, 115, 85, 0.08),
        0 4px 15px rgba(139, 115, 85, 0.05);
    margin-bottom: 2rem;
    position: relative;
}

.client-details-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #8B7355, #A68B5B);
    border-radius: 20px 20px 0 0;
}

.details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.detail-item {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: rgba(139, 115, 85, 0.03);
    border-radius: 12px;
    border-left: 4px solid var(--primary-color);
}

.detail-label {
    font-weight: 600;
    color: var(--primary-color);
    min-width: 120px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-value {
    color: var(--text-primary);
    font-weight: 500;
}

/* History section */
.history-section {
    margin-top: 3rem;
}

.section-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
}

.history-subtitle {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary-color);
    margin: 1.5rem 0 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.history-subtitle:first-of-type {
    margin-top: 0;
}

.section-title {
    color: var(--primary-color);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    gap: 12px;
}

.history-table-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 10px 25px rgba(139, 115, 85, 0.08),
        0 4px 15px rgba(139, 115, 85, 0.05);
    overflow: hidden;
    margin-bottom: 2rem;
}

.modern-table {
    width: 100%;
    border-collapse: collapse;
}

.modern-table thead {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.05), rgba(166, 139, 91, 0.02));
}

.modern-table th {
    padding: 1rem 1.5rem;
    text-align: left;
    font-weight: 600;
    color: var(--primary-color);
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
    white-space: nowrap;
}

.modern-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(139, 115, 85, 0.05);
    vertical-align: middle;
}

.history-row {
    transition: all 0.3s ease;
}

.history-row:hover {
    background: rgba(139, 115, 85, 0.03);
}

.price-cell {
    font-weight: 700;
    color: #22C55E;
}

.note-preview {
    cursor: pointer;
    padding: 6px 12px;
    background: rgba(139, 115, 85, 0.1);
    border-radius: 8px;
    transition: all 0.3s ease;
}

.note-preview:hover {
    background: rgba(139, 115, 85, 0.2);
    transform: scale(1.05);
}

.table-actions {
    display: flex;
    gap: 6px;
}

.table-btn {
    padding: 6px 12px;
    border-radius: 8px;
    border: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s ease;
    cursor: pointer;
}

.view-btn {
    background: rgba(59, 130, 246, 0.1);
    color: #3B82F6;
}

.view-btn:hover {
    background: #3B82F6;
    color: white;
    transform: translateY(-1px);
}

.edit-small-btn {
    background: rgba(139, 115, 85, 0.1);
    color: var(--primary-color);
}

.edit-small-btn:hover {
    background: var(--primary-color);
    color: white;
    transform: translateY(-1px);
}

.delete-small-btn {
    background: rgba(239, 68, 68, 0.1);
    color: #EF4444;
}

.delete-small-btn:hover {
    background: #EF4444;
    color: white;
    transform: translateY(-1px);
}

/* Add information section */
.add-info-section {
    margin-top: 2rem;
}

.toggle-form-btn {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.toggle-form-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(34, 197, 94, 0.3);
}

.form-container {
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid rgba(139, 115, 85, 0.1);
    box-shadow: 
        0 8px 20px rgba(139, 115, 85, 0.08),
        0 4px 12px rgba(139, 115, 85, 0.05);
}

.submit-btn {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.2);
}

/* Empty state */
.empty-state {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--text-secondary);
}

.empty-state.small {
    padding: 1.5rem 1rem;
}

.empty-state.small p {
    margin: 0;
    font-size: 0.95rem;
}

.empty-icon {
    font-size: 3rem;
    color: var(--text-light);
    margin-bottom: 1rem;
}

/* Modal customization */
.modal-content {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(139, 115, 85, 0.1);
    border-radius: 16px;
}

.modal-header {
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.05), rgba(166, 139, 91, 0.02));
}

.modal-title {
    color: var(--primary-color);
    font-weight: 600;
}

/* Modal RDV prestation (sans Bootstrap) */
.rdv-prestation-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}
.rdv-prestation-modal-overlay.open {
    display: flex;
}
.rdv-prestation-modal-panel {
    background: var(--adm-surface, #fff);
    border-radius: var(--adm-radius, 12px);
    border: 1px solid var(--adm-border, #e8e4de);
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
    max-width: 420px;
    width: 100%;
    max-height: 90vh;
    overflow: auto;
}
.rdv-prestation-modal-panel .modal-header {
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.rdv-prestation-modal-panel .modal-header .btn-close-modal {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.25rem;
    color: var(--adm-text-muted);
    line-height: 1;
}
.rdv-prestation-modal-panel .modal-header .btn-close-modal:hover {
    color: var(--adm-text);
}
.rdv-prestation-modal-panel .modal-body {
    padding: 1.25rem;
}
.rdv-prestation-modal-panel .form-label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: var(--adm-text);
}
.rdv-prestation-modal-panel .form-select,
.rdv-prestation-modal-panel .form-control {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius-sm);
    font-size: 1rem;
}
.rdv-prestation-modal-panel .mb-3 { margin-bottom: 1rem; }
.rdv-prestation-modal-panel .modal-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--adm-border);
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
}
.rdv-prestation-modal-panel .btn-modal-secondary {
    padding: 0.5rem 1rem;
    border-radius: var(--adm-radius-sm);
    border: 1px solid var(--adm-border);
    background: var(--adm-bg);
    color: var(--adm-text);
    cursor: pointer;
    font-weight: 500;
}
.rdv-prestation-modal-panel .btn-modal-primary {
    padding: 0.5rem 1rem;
    border-radius: var(--adm-radius-sm);
    border: none;
    background: var(--adm-accent, #c17f59);
    color: white;
    cursor: pointer;
    font-weight: 500;
}
.rdv-prestation-modal-panel .btn-modal-primary:hover {
    background: var(--adm-accent-hover, #a96b48);
}

.carousel-item img {
    max-width: 100%;
    max-height: 400px;
    object-fit: contain;
    margin: auto;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(139, 115, 85, 0.15);
}

/* Responsive */
@media (max-width: 768px) {
    .client-header {
        flex-direction: column;
        text-align: center;
    }
    
    .client-title {
        font-size: 1.6rem;
    }
    
    .client-actions {
        justify-content: center;
        width: 100%;
    }
    
    .action-btn {
        flex: 1;
        justify-content: center;
    }
    
    .details-grid {
        grid-template-columns: 1fr;
    }
    
    .client-details-card {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    .modern-table {
        min-width: 800px;
    }
    
    /* Liste RDV en mode télé : cartes au lieu du tableau */
    .rdv-list-card {
        padding: 1rem;
        margin-left: 0.5rem;
        margin-right: 0.5rem;
    }
    
    .rdv-list-card .rdv-table-responsive {
        overflow: visible;
        padding: 0;
    }
    
    .rdv-list-card .rdv-table {
        min-width: 0;
        width: 100%;
    }
    
    .rdv-list-card .rdv-table thead {
        display: none;
    }
    
    .rdv-list-card .rdv-table tbody tr.rdv-row {
        display: block;
        border: 1px solid var(--adm-border, rgba(139, 115, 85, 0.15));
        border-radius: var(--adm-radius, 12px);
        padding: 1rem;
        margin-bottom: 0.75rem;
        background: var(--adm-surface, #fff);
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    
    .rdv-list-card .rdv-table tbody tr.rdv-row:last-child {
        margin-bottom: 0;
    }
    
    .rdv-list-card .rdv-table tbody td {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        border-bottom: none;
        gap: 0.75rem;
    }
    
    .rdv-list-card .rdv-table tbody td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--adm-text-muted, #6b6560);
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    
    .rdv-list-card .rdv-table tbody td.rdv-row-actions {
        justify-content: flex-end;
        padding-top: 0.75rem;
        margin-top: 0.25rem;
        border-top: 1px solid var(--adm-border, rgba(139, 115, 85, 0.1));
    }
    
    .rdv-list-card .rdv-table tbody td.rdv-row-actions::before {
        display: none;
    }
    
    .rdv-list-card .rdv-table .table-btn {
        width: auto;
    }
    
    .table-actions {
        flex-direction: column;
        width: 100%;
    }
    
    .table-btn {
        width: 100%;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="client-container" data-animate="true">
    <!-- Header -->
    <div class="client-header">
        <h1 class="client-title">
            <i class="fas fa-user-circle"></i>
            {{ client.firstName }} {{ client.name }}
        </h1>
        <div class="client-actions">
            <a href="{{ path('app_client_index') }}" class="action-btn back-btn">
                <i class="fas fa-arrow-left"></i>
                Retour à la liste
            </a>
            <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="action-btn edit-btn">
                <i class="fas fa-edit"></i>
                Modifier
            </a>
            {{ include('client/_delete_form.html.twig') }}
        </div>
    </div>

    <!-- Client Details -->
    <div class="client-details-card" data-animate="true">
        <div class="details-grid">
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-user"></i>
                    Prénom
                </div>
                <div class="detail-value">{{ client.firstName }}</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-id-badge"></i>
                    Nom
                </div>
                <div class="detail-value">{{ client.name }}</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-envelope"></i>
                    Email
                </div>
                <div class="detail-value">{{ client.email ?: 'Non renseigné' }}</div>
            </div>
            
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-phone"></i>
                    Téléphone
                </div>
                <div class="detail-value">{{ client.phoneNumber ?: 'Non renseigné' }}</div>
            </div>
            
            {% if client.connu %}
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-handshake"></i>
                    Comment connue
                </div>
                <div class="detail-value">{{ client.connu }}</div>
            </div>
            {% endif %}
            
            {% if client.etat %}
            <div class="detail-item">
                <div class="detail-label">
                    <i class="fas fa-hand-paper"></i>
                    État des ongles
                </div>
                <div class="detail-value">{{ client.etat }}</div>
            </div>
            {% endif %}
            
            {% if client.note %}
            <div class="detail-item" style="grid-column: 1 / -1;">
                <div class="detail-label">
                    <i class="fas fa-sticky-note"></i>
                    Notes
                </div>
                <div class="detail-value">{{ client.note }}</div>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Historique client = RDV + Informations -->
    <div class="history-section" data-animate="true">
        <h3 class="section-title">
            <i class="fas fa-history"></i>
            Historique client
        </h3>
        <p class="section-subtitle">Rendez-vous et informations de prestations</p>

        <!-- Rendez-vous -->
        <h4 class="history-subtitle"><i class="fas fa-calendar-check"></i> Rendez-vous</h4>
        <div class="history-table-card rdv-list-card">
            <div class="table-responsive rdv-table-responsive">
                {% if appointments is defined and appointments is not empty %}
                    <table class="modern-table rdv-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar"></i> Date</th>
                                <th><i class="fas fa-clock"></i> Horaire</th>
                                <th><i class="fas fa-cut"></i> Prestation</th>
                                <th><i class="fas fa-euro-sign"></i> Prix</th>
                                <th><i class="fas fa-hourglass-half"></i> Durée</th>
                                <th><i class="fas fa-cog"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for apt in appointments %}
                                <tr class="history-row rdv-row">
                                    <td data-label="Date">{{ apt.date ? apt.date|date('d/m/Y') : '-' }}</td>
                                    <td data-label="Horaire">{{ apt.date ? apt.date|date('H:i') : '-' }}</td>
                                    <td data-label="Prestation">{{ apt.service ? apt.service.name : '-' }}</td>
                                    <td class="price-cell" data-label="Prix">{{ apt.price is not null ? apt.price ~ '€' : (apt.service and apt.service.price is not null ? apt.service.price ~ '€' : '-') }}</td>
                                    <td data-label="Durée">
                                        {% if apt.endDate and apt.date %}
                                            {% set diff = apt.endDate.diff(apt.date) %}
                                            {{ (diff.h * 60 + diff.i) }} min
                                        {% elseif apt.service and apt.service.duration is not null %}
                                            {{ apt.service.duration }} min
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td data-label="" class="rdv-row-actions">
                                        <button type="button" class="table-btn edit-small-btn btn-edit-rdv-prestation"
                                                data-appointment-id="{{ apt.id }}"
                                                data-form-action="{{ path('app_client_appointment_update_prestation', { id: client.id, appointmentId: apt.id }) }}"
                                                data-service-id="{{ apt.service ? apt.service.id : '' }}"
                                                data-price="{{ apt.price ?? (apt.service ? apt.service.price : '') }}"
                                                title="Modifier prestation et prix">
                                            <i class="fas fa-edit"></i> Modifier
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="empty-state small">
                        <p>Aucun rendez-vous enregistré pour ce client.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Modal Modifier prestation & prix du RDV (sans Bootstrap) -->
<div class="rdv-prestation-modal-overlay" id="editRdvPrestationModal" aria-hidden="true">
    <div class="rdv-prestation-modal-panel" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h5 class="modal-title"><i class="fas fa-edit"></i> Modifier prestation et prix</h5>
            <button type="button" class="btn-close-modal" id="editRdvPrestationModalClose" aria-label="Fermer">&times;</button>
        </div>
        <form id="editRdvPrestationForm" method="post" action="">
            <div class="modal-body">
                <input type="hidden" name="_token" value="{{ csrf_token('client_rdv_prestation') }}">
                <div class="mb-3">
                    <label for="editRdvServiceId" class="form-label">Prestation</label>
                    <select name="serviceId" id="editRdvServiceId" class="form-select">
                        {% if services is defined %}
                            {% for s in services %}
                                <option value="{{ s.id }}">{{ s.name }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>
                <div class="mb-3">
                    <label for="editRdvPrice" class="form-label">Prix (€)</label>
                    <input type="number" name="price" id="editRdvPrice" class="form-control" min="0" step="1" placeholder="Prix personnalisé">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-secondary" id="editRdvPrestationModalCancel">Annuler</button>
                <button type="submit" class="btn-modal-primary"><i class="fas fa-save"></i> Enregistrer</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle form visibility (optionnel)
    var toggleForm = document.getElementById('toggleForm');
    if (toggleForm) {
        toggleForm.addEventListener('click', function () {
            var formDiv = document.getElementById('newInformationForm');
            if (formDiv) {
                if (formDiv.style.display === 'none') {
                    formDiv.style.display = 'block';
                    this.innerHTML = '<i class="fas fa-minus"></i> Cacher le formulaire';
                } else {
                    formDiv.style.display = 'none';
                    this.innerHTML = '<i class="fas fa-plus"></i> Ajouter une nouvelle information';
                }
            }
        });
    }

    // Note modal (optionnel, si Bootstrap présent)
    document.querySelectorAll('.note-preview').forEach(function(note) {
        note.addEventListener('click', function() {
            var fullNote = this.getAttribute('data-full-note');
            var modalContent = document.getElementById('modal-note-content');
            if (modalContent) modalContent.innerText = fullNote || '';
            if (typeof bootstrap !== 'undefined') {
                var noteModalEl = document.getElementById('noteModal');
                if (noteModalEl) new bootstrap.Modal(noteModalEl).show();
            }
        });
    });

    // Modal Modifier prestation & prix RDV — colonne Actions (délégation d’événements)
    var editRdvModal = document.getElementById('editRdvPrestationModal');
    function openEditRdvModal() {
        if (editRdvModal) editRdvModal.classList.add('open');
    }
    function closeEditRdvModal() {
        if (editRdvModal) editRdvModal.classList.remove('open');
    }
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-edit-rdv-prestation');
        if (!btn) return;
        e.preventDefault();
        var form = document.getElementById('editRdvPrestationForm');
        if (form) form.action = btn.getAttribute('data-form-action') || '';
        var sel = document.getElementById('editRdvServiceId');
        if (sel) sel.value = btn.getAttribute('data-service-id') || '';
        var priceInput = document.getElementById('editRdvPrice');
        if (priceInput) priceInput.value = btn.getAttribute('data-price') || '';
        openEditRdvModal();
    });
    var closeBtn = document.getElementById('editRdvPrestationModalClose');
    if (closeBtn) closeBtn.addEventListener('click', closeEditRdvModal);
    var cancelBtn = document.getElementById('editRdvPrestationModalCancel');
    if (cancelBtn) cancelBtn.addEventListener('click', closeEditRdvModal);
    if (editRdvModal) {
        editRdvModal.addEventListener('click', function(e) {
            if (e.target === editRdvModal) closeEditRdvModal();
        });
    }

    // Carousel modal functionality
    document.querySelectorAll('.open-carousel').forEach(function(button) {
        button.addEventListener('click', function() {
            const images = this.getAttribute('data-images').split(',');
            const technique = this.getAttribute('data-technique');
            const forme = this.getAttribute('data-forme');
            const produit = this.getAttribute('data-produit');
            const date = this.getAttribute('data-date');
            const firstName = this.getAttribute('data-firstName');
            const name = this.getAttribute('data-name');

            // Update modal title
            const modalTitle = document.getElementById('carouselModalLabel');
            modalTitle.innerHTML = `<i class="fas fa-images"></i> Séance du ${date} - ${firstName} ${name}`;

            // Update modal details
            const modalDetails = document.getElementById('carouselDetails');
            modalDetails.innerHTML = `
                <div class="row">
                    <div class="col-md-4"><strong><i class="fas fa-palette"></i> Technique :</strong> ${technique}</div>
                    <div class="col-md-4"><strong><i class="fas fa-shapes"></i> Forme :</strong> ${forme}</div>
                    <div class="col-md-4"><strong><i class="fas fa-box"></i> Produit :</strong> ${produit}</div>
                </div>
            `;

            // Update carousel images
            const carouselContent = document.getElementById('carouselContent');
            carouselContent.innerHTML = '';

            if (images.length > 0 && images[0] !== '') {
                images.forEach((image, index) => {
                    const activeClass = index === 0 ? 'active' : '';
                    const carouselItem = `
                        <div class="carousel-item ${activeClass}">
                            <img src="/images/client/${image}" class="d-block w-100" alt="Image ${index + 1}">
                        </div>
                    `;
                    carouselContent.innerHTML += carouselItem;
                });
            } else {
                carouselContent.innerHTML = `
                    <div class="carousel-item active">
                        <div class="d-flex justify-content-center align-items-center" style="height: 300px; background: rgba(139, 115, 85, 0.1); border-radius: 12px;">
                            <div class="text-center text-muted">
                                <i class="fas fa-image fa-3x mb-3"></i>
                                <p>Aucune image disponible</p>
                            </div>
                        </div>
                    </div>
                `;
            }

            // Show modal
            const carouselModal = new bootstrap.Modal(document.getElementById('carouselModal'));
            carouselModal.show();
        });
    });
});
</script>
{% endblock %}
