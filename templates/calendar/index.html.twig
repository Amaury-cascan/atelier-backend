{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Variables globales
    let currentDate = new Date();
    let currentView = 'day';
    let appointments = [];
    let services = [];
    let clients = [];
    let touchStartX = 0;
    let touchEndX = 0;
    
    // Couleurs des services
    const serviceColors = [
        '', 'service-color-1', 'service-color-2', 'service-color-3', 'service-color-4',
        'service-color-5', 'service-color-6', 'service-color-7', 'service-color-8', 'service-color-9', 'service-color-10'
    ];

    // Initialisation
    init();

    function init() {
        setupEventListeners();
        loadData();
        updateDateDisplay();
        showView(currentView);
    }

    function setupEventListeners() {
        // Navigation principale
        document.getElementById('prevPeriod').addEventListener('click', () => navigatePeriod(-1));
        document.getElementById('nextPeriod').addEventListener('click', () => navigatePeriod(1));
        document.getElementById('todayBtn').addEventListener('click', goToToday);
        document.getElementById('yearViewBtn').addEventListener('click', showYearSelector);

        // Navigation semaine
        document.getElementById('prevWeek').addEventListener('click', () => navigateWeek(-1));
        document.getElementById('nextWeek').addEventListener('click', () => navigateWeek(1));

        // Navigation mois
        document.getElementById('prevMonth').addEventListener('click', () => navigateMonth(-1));
        document.getElementById('nextMonth').addEventListener('click', () => navigateMonth(1));

        // Vue tabs
        document.querySelectorAll('.view-tab').forEach(tab => {
            tab.addEventListener('click', (e) => {
                const view = e.target.dataset.view;
                switchView(view);
            });
        });

        // Bouton nouveau RDV
        document.getElementById('newAppointmentBtn').addEventListener('click', showNewAppointmentModal);

        // Stats period
        document.getElementById('statsPeriod').addEventListener('change', updateStats);

        // Swipe detection
        document.addEventListener('touchstart', handleTouchStart, { passive: true });
        document.addEventListener('touchend', handleTouchEnd, { passive: true });

        // Year selector
        setupYearSelector();
        
        // Appointment modal
        setupAppointmentModal();
        
        // New appointment modal
        setupNewAppointmentModal();
    }



    // Navigation par swipe
    function handleTouchStart(e) {
        touchStartX = e.changedTouches[0].screenX;
    }

    function handleTouchEnd(e) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
    }

    function handleSwipe() {
        const threshold = 50;
        const diff = touchStartX - touchEndX;

        if (Math.abs(diff) > threshold) {
            if (diff > 0) {
                // Swipe left - jour suivant
                navigateDay(1);
            } else {
                // Swipe right - jour précédent
                navigateDay(-1);
            }
        }
    }

    // Navigation générale
    function navigatePeriod(direction) {
        switch(currentView) {
            case 'day':
                navigateDay(direction);
                break;
            case 'week':
                navigateWeek(direction);
                break;
            case 'month':
                navigateMonth(direction);
                break;
        }
    }

    function navigateDay(direction) {
        currentDate.setDate(currentDate.getDate() + direction);
        updateDateDisplay();
        renderDayView();
        
        // Animation
        const container = document.getElementById('dayView');
        container.classList.remove('slide-in-left', 'slide-in-right');
        container.classList.add(direction > 0 ? 'slide-in-right' : 'slide-in-left');
    }

    function navigateWeek(direction) {
        currentDate.setDate(currentDate.getDate() + (direction * 7));
        updateDateDisplay();
        renderWeekView();
        
        // Animation
        const container = document.getElementById('weekView');
        container.classList.remove('slide-in-left', 'slide-in-right');
        container.classList.add(direction > 0 ? 'slide-in-right' : 'slide-in-left');
    }

    function navigateMonth(direction) {
        currentDate.setMonth(currentDate.getMonth() + direction);
        updateDateDisplay();
        renderMonthView();
        
        // Animation
        const container = document.getElementById('monthView');
        container.classList.remove('slide-in-left', 'slide-in-right');
        container.classList.add(direction > 0 ? 'slide-in-right' : 'slide-in-left');
    }

    function goToToday() {
        currentDate = new Date();
        updateDateDisplay();
        showView(currentView);
    }

    function updateDateDisplay() {
        let displayText;
        
        switch(currentView) {
            case 'day':
                const options = { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                };
                displayText = currentDate.toLocaleDateString('fr-FR', options);
                break;
            case 'week':
                displayText = 'Semaine';
                updateWeekDisplay();
                break;
            case 'month':
                displayText = currentDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
                break;
            case 'list':
                displayText = 'Liste des rendez-vous';
                break;
            case 'stats':
                displayText = 'Statistiques';
                break;
            default:
                displayText = 'Calendrier';
        }
        
        document.getElementById('currentDate').textContent = displayText;
        document.getElementById('currentYear').textContent = currentDate.getFullYear();
    }

    // Gestion des vues
    function switchView(view) {
        currentView = view;
        
        // Update tabs
        document.querySelectorAll('.view-tab').forEach(tab => {
            tab.classList.toggle('active', tab.dataset.view === view);
        });
        
        showView(view);
    }

    function showView(view) {
        // Hide all views
        document.querySelectorAll('.view-content').forEach(el => {
            el.style.display = 'none';
        });

        // Show selected view
        const viewElement = document.getElementById(`${view}View`);
        if (viewElement) {
            viewElement.style.display = 'block';
            viewElement.classList.add('fade-in');
        }

        // Render view content
        switch(view) {
            case 'day':
                renderDayView();
                break;
            case 'week':
                renderWeekView();
                break;
            case 'month':
                renderMonthView();
                break;
            case 'list':
                renderListView();
                break;
            case 'stats':
                renderStatsView();
                break;
        }
        
        // Mettre à jour l'affichage de la date selon la vue
        updateDateDisplay();
    }

    // Rendu vue jour
    function renderDayView() {
        
        const container = document.getElementById('dayAppointments');
        const dayAppointments = getDayAppointments(currentDate);
        
        
        if (dayAppointments.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-calendar-day"></i>
                    </div>
                    <div class="empty-title">Aucun rendez-vous</div>
                    <div class="empty-subtitle">Votre journée est libre</div>
                </div>
            `;
            return;
        }

        // Calculer la plage horaire nécessaire
        const timeRange = calculateTimeRange(dayAppointments);
        
        // Créer la structure de timeline
        container.innerHTML = createTimelineStructure(timeRange, dayAppointments);
        
        // Ajouter les event listeners pour les RDV
        setupAppointmentEvents();
    }

    // Créer la structure HTML de la timeline avec RDV positionnés
    function createTimelineStructure(timeRange, appointments) {
        const HOUR_HEIGHT = 80; // Hauteur d'une heure en pixels
        const totalHours = timeRange.end - timeRange.start + 1;
        const totalHeight = totalHours * HOUR_HEIGHT;
        
        let html = `<div class="timeline-container" style="position: relative; height: ${totalHeight}px;">`;
        
        // Créer les lignes d'heures
        for (let hour = timeRange.start; hour <= timeRange.end; hour++) {
            const top = (hour - timeRange.start) * HOUR_HEIGHT;
            html += `
                <div class="timeline-hour" style="position: absolute; top: ${top}px; left: 0; right: 0; height: ${HOUR_HEIGHT}px; border-bottom: 1px solid #e5e5e5;">
                    <div class="timeline-hour-label" style="position: absolute; left: 0; top: 0; width: 60px; text-align: center; font-size: 0.9em; color: #666; background: white; padding: 4px 0;">
                        ${hour.toString().padStart(2, '0')}:00
                    </div>
                    <div class="timeline-hour-content" style="margin-left: 70px; height: 100%;"></div>
                </div>
            `;
        }
        
        // Ajouter les RDV positionnés
        appointments.forEach(apt => {
            const startDate = new Date(apt.start);
            const endDate = new Date(apt.end);
            
            const startHour = startDate.getHours();
            const startMinutes = startDate.getMinutes();
            const endHour = endDate.getHours();
            const endMinutes = endDate.getMinutes();
            
            // Calculer la position et la hauteur
            const startOffset = (startHour - timeRange.start) + (startMinutes / 60);
            const duration = ((endHour * 60 + endMinutes) - (startHour * 60 + startMinutes)) / 60;
            
            const top = startOffset * HOUR_HEIGHT;
            const height = duration * HOUR_HEIGHT - 2; // -2px pour éviter le chevauchement des bordures
            
            html += createAppointmentBlock(apt, top, height);
        });
        
        html += '</div>';
        return html;
    }

    // Créer le HTML d'un bloc de RDV positionné
    function createAppointmentBlock(appointment, top, height) {
        const service = services.find(s => s.id == appointment.extendedProps.serviceId);
        const client = clients.find(c => c.id == appointment.extendedProps.clientId);
        const colorClass = serviceColors[appointment.extendedProps.serviceId] || 'service-color-1';
        
        const startTime = new Date(appointment.start).toLocaleTimeString('fr-FR', {
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Paris'
        });
        
        const endTime = new Date(appointment.end).toLocaleTimeString('fr-FR', {
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Paris'
        });

        const clientInitials = client ? 
            (client.firstName.charAt(0) + client.name.charAt(0)).toUpperCase() : '??';

        return `
            <div class="appointment-timeline-block ${colorClass}" 
                 data-id="${appointment.id}"
                 style="position: absolute; 
                        top: ${top}px; 
                        height: ${height}px; 
                        left: 70px; 
                        right: 10px; 
                        background: rgba(139, 115, 85, 0.1);
                        border: 1px solid rgba(139, 115, 85, 0.3);
                        border-radius: 8px;
                        padding: 8px;
                        cursor: pointer;
                        transition: all 0.2s ease;
                        overflow: hidden;">
                
                <div class="appointment-timeline-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px;">
                    <div class="appointment-timeline-time" style="font-weight: 600; color: #8B7355; font-size: 0.85em;">
                        ${startTime} - ${endTime}
                    </div>
                    <div class="appointment-timeline-avatar" style="width: 24px; height: 24px; border-radius: 50%; background: #8B7355; color: white; display: flex; align-items: center; justify-content: center; font-size: 0.7em; font-weight: 600;">
                        ${clientInitials}
                    </div>
                </div>
                
                <div class="appointment-timeline-service" style="font-weight: 600; color: #333; margin-bottom: 2px; font-size: 0.9em;">
                    ${appointment.title}
                </div>
                
                <div class="appointment-timeline-client" style="color: #666; font-size: 0.85em;">
                    ${appointment.extendedProps.clientFirstName} ${appointment.extendedProps.clientName}
                </div>
                
                ${height > 60 ? `
                    <div class="appointment-timeline-details" style="margin-top: 8px; font-size: 0.8em; color: #888;">
                        <div>💰 ${appointment.extendedProps.price || service?.price || 0}€</div>
                        <div>⏱️ ${formatDurationFromMinutes(appointment.extendedProps.duration || service?.duration || 60)}</div>
                    </div>
                ` : ''}
            </div>
        `;
    }

    // Formater la durée en minutes vers texte lisible
    function formatDurationFromMinutes(minutes) {
        const hours = Math.floor(minutes / 60);
        const mins = minutes % 60;
        
        if (hours === 0) {
            return `${mins} min`;
        } else if (mins === 0) {
            return `${hours}h`;
        } else {
            return `${hours}h${mins.toString().padStart(2, '0')}`;
        }
    }

    // Calculer la plage horaire nécessaire pour afficher tous les RDV
    function calculateTimeRange(appointments) {
        if (appointments.length === 0) {
            return { start: 9, end: 18 }; // Défaut 9h-18h
        }

        let earliestStart = 24;
        let latestEnd = 0;

        appointments.forEach(apt => {
            const startHour = new Date(apt.start).getHours();
            const endHour = new Date(apt.end).getHours();
            const endMinutes = new Date(apt.end).getMinutes();
            
            earliestStart = Math.min(earliestStart, startHour);
            latestEnd = Math.max(latestEnd, endMinutes > 0 ? endHour + 1 : endHour);
        });

        // Ajouter une marge d'une heure avant et après
        return {
            start: Math.max(7, earliestStart - 1), // Pas avant 7h
            end: Math.min(22, latestEnd + 1)       // Pas après 22h
        };
    }

    // Rendu vue liste
    function renderListView() {
        const container = document.getElementById('listAppointments');
        const upcomingAppointments = getUpcomingAppointments();
        
        if (upcomingAppointments.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-list"></i>
                    </div>
                    <div class="empty-title">Aucun rendez-vous à venir</div>
                    <div class="empty-subtitle">Votre planning est vide</div>
                </div>
            `;
            return;
        }

        let currentDateStr = '';
        let html = '';

        upcomingAppointments.forEach(apt => {
            const aptDate = new Date(apt.start).toLocaleDateString('fr-FR');
            
            if (aptDate !== currentDateStr) {
                currentDateStr = aptDate;
                html += `<div class="list-date-header">${aptDate}</div>`;
            }
            
            html += renderAppointmentCard(apt);
        });

        container.innerHTML = html;
        
        // Ajouter les event listeners pour les RDV
