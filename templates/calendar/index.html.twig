    }

    // Rendu vue semaine
    function renderWeekView() {
        const container = document.getElementById('weekGrid');
        const weekStart = getWeekStart(currentDate);
        
        // Mise à jour de l'affichage de la semaine
        updateWeekDisplay();
        
        const weekDays = [];
        
        // Générer les 7 jours de la semaine
        for (let i = 1; i < 6; i++) {
            const day = new Date(weekStart);
            day.setDate(weekStart.getDate() + i);
            weekDays.push(day);
        }

        let html = '<div class="week-header">';
        weekDays.forEach(day => {
            const isToday = day.toDateString() === new Date().toDateString();
            const dayAppointments = getDayAppointments(day);
            
            html += `
                <div class="week-day ${isToday ? 'today' : ''}" data-date="${day.toISOString()}">
                    <div class="week-day-header">
                        <div class="week-day-name">${day.toLocaleDateString('fr-FR', { weekday: 'short' })}</div>
                        <div class="week-day-number">${day.getDate()}</div>
                    </div>
                    <div class="week-day-appointments">
                        ${dayAppointments.slice(0, 3).map(apt => `
                            <div class="week-appointment ${serviceColors[apt.extendedProps.serviceId] || ''}" data-id="${apt.id}">
                                <div class="week-apt-time">${new Date(apt.start).toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris'})}</div>
                                <div class="week-apt-client">${apt.extendedProps.clientFirstName}</div>
                            </div>
                        `).join('')}
                        ${dayAppointments.length > 3 ? `<div class="week-more">+${dayAppointments.length - 3}</div>` : ''}
                    </div>
                </div>
            `;
        });
        html += '</div>';

        container.innerHTML = html;
        
        // Ajouter les event listeners pour les RDV
        setupAppointmentEvents();
    }

    function getWeekStart(date) {
        const d = new Date(date);
        const day = d.getDay();
        const diff = d.getDate() - day + (day === 0 ? -6 : 1); // Lundi = début de semaine
        return new Date(d.setDate(diff));
    }

    // Mise à jour de l'affichage de la semaine
    function updateWeekDisplay() {
        const weekStart = getWeekStart(currentDate);
        const weekEnd = new Date(weekStart);
        weekEnd.setDate(weekStart.getDate() + 6);
        
        const startStr = weekStart.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        const endStr = weekEnd.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        
        document.getElementById('weekRange').textContent = `${startStr} - ${endStr}`;
    }

    // Rendu vue mois
    function renderMonthView() {
        const container = document.getElementById('monthGrid');
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();
        
        // Mise à jour du titre
        document.getElementById('monthTitle').textContent = 
            currentDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
        
        // Première date du calendrier (peut être du mois précédent)
        const firstDay = new Date(year, month, 1);
        const startDate = getWeekStart(firstDay);
        
        let html = '';
        
        // Headers des jours
        const dayHeaders = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
        dayHeaders.forEach(day => {
            html += `<div class="month-day-header">${day}</div>`;
        });
        
        // Générer 6 semaines (42 jours)
        for (let i = 0; i < 42; i++) {
            const currentDay = new Date(startDate);
            currentDay.setDate(startDate.getDate() + i);
            
            const isCurrentMonth = currentDay.getMonth() === month;
            const isToday = currentDay.toDateString() === new Date().toDateString();
            const dayAppointments = getDayAppointments(currentDay);
            
            const classes = [
                'month-day',
                !isCurrentMonth ? 'other-month' : '',
                isToday ? 'today' : ''
            ].filter(c => c).join(' ');
            
            html += `
                <div class="${classes}" data-date="${currentDay.toISOString()}">
                    <div class="month-day-number">${currentDay.getDate()}</div>
                    <div class="month-appointments">
                        ${dayAppointments.slice(0, 2).map(apt => `
                            <div class="month-appointment ${serviceColors[apt.extendedProps.serviceId] || ''}" data-id="${apt.id}">
                                ${new Date(apt.start).toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris'})} ${apt.extendedProps.clientFirstName}
                            </div>
                        `).join('')}
                        ${dayAppointments.length > 2 ? `<div class="month-more">+${dayAppointments.length - 2}</div>` : ''}
                    </div>
                </div>
            `;
        }
        
        container.innerHTML = html;
        
        // Ajouter les event listeners pour cliquer sur un jour
        container.querySelectorAll('.month-day').forEach(dayEl => {
            dayEl.addEventListener('click', (e) => {
                const clickedDate = new Date(e.currentTarget.dataset.date);
                currentDate = clickedDate;
                switchView('day');
            });
        });
    }

    // Rendu vue statistiques
    function renderStatsView() {
        updateStats();
        renderCharts();
    }

    // Mise à jour des statistiques
    function updateStats() {
        const period = document.getElementById('statsPeriod').value;
        const filteredAppointments = getFilteredAppointments(period);
        
        // KPIs
        document.getElementById('totalAppointments').textContent = filteredAppointments.length;
        
        const totalRevenue = filteredAppointments.reduce((sum, apt) => {
            const service = services.find(s => s.id == apt.extendedProps.serviceId);
            return sum + (service ? service.price : 0);
        }, 0);
        document.getElementById('totalRevenue').textContent = totalRevenue + '€';
        
        const uniqueClients = new Set(filteredAppointments.map(apt => apt.extendedProps.clientId));
        document.getElementById('totalClients').textContent = uniqueClients.size;
        
        const avgTicket = filteredAppointments.length > 0 ? Math.round(totalRevenue / filteredAppointments.length) : 0;
        document.getElementById('avgTicket').textContent = avgTicket + '€';
        
        // Top clients
        updateTopClients(filteredAppointments);
    }

    function getFilteredAppointments(period) {
        const now = new Date();
        let startDate;
        let endDate;
        
        switch(period) {
            case 'month':
                // Mois courant : du 1er au dernier jour du mois
                startDate = new Date(now.getFullYear(), now.getMonth(), 1);
                endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59); // Dernier jour du mois
                break;
            case 'quarter':
                // 3 derniers mois complets
                startDate = new Date(now.getFullYear(), now.getMonth() - 2, 1);
                endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0); // Fin du mois courant
                break;
            case 'year':
                // Cette année complète : du 1er janvier au 31 décembre
                startDate = new Date(now.getFullYear(), 0, 1);
                endDate = new Date(now.getFullYear(), 11, 31); // 31 décembre
                break;
            case 'all':
            default:
                // Tous les rendez-vous
                startDate = new Date(2020, 0, 1); // Date très ancienne
                endDate = new Date(2060, 11, 31); // Date très future
                break; 
        }
        
        return appointments.filter(apt => {
            const aptDate = new Date(apt.start);
            // Vérifier si c'est un vrai RDV (pas "Pas de rdv")
            const isValidAppointment = apt.service?.name !== "Pas de rdv" && apt.title !== "Pas de rdv";

            return aptDate >= startDate && 
                   aptDate <= endDate && 
                   isValidAppointment;
        });
    }

    function updateTopClients(filteredAppointments) {
        const clientStats = {};
        
        filteredAppointments.forEach(apt => {
            const clientId = apt.extendedProps.clientId;
            const service = services.find(s => s.id == apt.extendedProps.serviceId);
            const price = service ? service.price : 0;
            
            if (!clientStats[clientId]) {
                clientStats[clientId] = {
                    name: `${apt.extendedProps.clientFirstName} ${apt.extendedProps.clientName}`,
                    count: 0,
                    total: 0
                };
            }
            
            clientStats[clientId].count++;
            clientStats[clientId].total += price;
        });
        
        const topClients = Object.values(clientStats)
            .sort((a, b) => b.total - a.total)
            .slice(0, 5);
        
        let html = '';
        topClients.forEach((client, index) => {
            html += `
                <div class="top-item">
                    <div class="top-item-info">
                        <div class="top-item-name">#${index + 1} ${client.name}</div>
                        <div class="top-item-details">${client.count} rendez-vous</div>
                    </div>
                    <div class="top-item-value">${client.total}€</div>
                </div>
            `;
        });
        
        document.getElementById('topClients').innerHTML = html || '<div class="empty-state">Aucune donnée</div>';
    }

    // Graphiques avec Chart.js
    let servicesChart, monthlyChart, hourlyChart;

    function renderCharts() {
        const period = document.getElementById('statsPeriod').value;
        const filteredAppointments = getFilteredAppointments(period);
        renderServicesChart(filteredAppointments);
        renderMonthlyChart(filteredAppointments);
        renderHourlyChart(filteredAppointments);
    }

    function renderServicesChart(filteredAppointments) {
        const ctx = document.getElementById('servicesChart').getContext('2d');
        
        // Destruction du graphique précédent
        if (servicesChart) {
            servicesChart.destroy();
        }
        
        const serviceStats = {};
        filteredAppointments.forEach(apt => {
            const serviceId = apt.extendedProps.serviceId;
            const service = services.find(s => s.id == serviceId);
            const serviceName = service ? service.name : 'Service inconnu';
            
            serviceStats[serviceName] = (serviceStats[serviceName] || 0) + 1;
        });
        
        const colors = [
            'rgb(162, 78, 50)', 'rgb(200, 149, 109)', 'rgb(184, 149, 109)', 
            'rgb(166, 124, 82)', 'rgb(139, 115, 85)', 'rgb(155, 139, 114)'
        ];
        
        servicesChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(serviceStats),
                datasets: [{
                    data: Object.values(serviceStats),
                    backgroundColor: colors,
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    }

    function renderMonthlyChart(filteredAppointments) {
        const ctx = document.getElementById('monthlyChart').getContext('2d');
        
        if (monthlyChart) {
            monthlyChart.destroy();
        }
        
        // Filtrer les RDV du début de l'année au mois courant
        const now = new Date();
        const yearStart = new Date(now.getFullYear(), 0, 1);
        const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0);
        
        const yearAppointments = appointments.filter(apt => {
            const aptDate = new Date(apt.start);
            const isValidAppointment = apt.service?.name !== "Pas de rdv" && apt.title !== "Pas de rdv";
            return aptDate >= yearStart && aptDate <= monthEnd && isValidAppointment;
        });
        
        const monthlyStats = {};
        yearAppointments.forEach(apt => {
            const date = new Date(apt.start);
            const monthKey = `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}`;
            
            if (!monthlyStats[monthKey]) {
                monthlyStats[monthKey] = { count: 0, revenue: 0 };
            }
            
            monthlyStats[monthKey].count++;
            const service = services.find(s => s.id == apt.extendedProps.serviceId);
            monthlyStats[monthKey].revenue += service ? service.price : 0;
        });
        
        const sortedMonths = Object.keys(monthlyStats).sort();
        
        monthlyChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: sortedMonths.map(month => {
                    const [year, monthNum] = month.split('-');
                    return new Date(year, monthNum - 1).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });
                }),
                datasets: [{
                    label: 'Chiffre d\'affaires',
                    data: sortedMonths.map(month => monthlyStats[month].revenue),
                    borderColor: 'rgb(162, 78, 50)',
                    backgroundColor: 'rgba(162, 78, 50, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value + '€';
                            }
                        }
                    }
                }
            }
        });
    }

    function renderHourlyChart(filteredAppointments) {
        const ctx = document.getElementById('hourlyChart').getContext('2d');
        
        if (hourlyChart) {
            hourlyChart.destroy();
        }
        
        const hourlyStats = {};
        for (let hour = 9; hour <= 19; hour++) {
            hourlyStats[hour] = 0;
        }
        
        filteredAppointments.forEach(apt => {
            const hour = new Date(apt.start).getHours();
            if (hourlyStats[hour] !== undefined) {
                hourlyStats[hour]++;
            }
        });
        
        hourlyChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: Object.keys(hourlyStats).map(hour => hour + 'h'),
                datasets: [{
                    label: 'Rendez-vous',
                    data: Object.values(hourlyStats),
                    backgroundColor: 'rgba(162, 78, 50, 0.8)',
                    borderColor: 'rgb(162, 78, 50)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });
    }

    // Sélecteur d'année
    function setupYearSelector() {
        const yearSelector = document.getElementById('yearSelector');
        
        yearSelector.addEventListener('click', (e) => {
            if (e.target === yearSelector) {
                hideYearSelector();
            }
        });
    }

    function showYearSelector() {
        const yearGrid = document.getElementById('yearGrid');
        const currentYear = new Date().getFullYear();
        
        let html = '';
        for (let year = currentYear - 5; year <= currentYear + 5; year++) {
            const isCurrentYear = year === currentDate.getFullYear();
            html += `
                <div class="year-item ${isCurrentYear ? 'current' : ''}" data-year="${year}">
                    ${year}
                </div>
            `;
        }
        
        yearGrid.innerHTML = html;
        
        // Event listeners pour les années
        yearGrid.querySelectorAll('.year-item').forEach(item => {
            item.addEventListener('click', (e) => {
                const selectedYear = parseInt(e.target.dataset.year);
                currentDate.setFullYear(selectedYear);
                updateDateDisplay();
                showView(currentView);
                hideYearSelector();
            });
        });
        
        document.getElementById('yearSelector').style.display = 'flex';
    }

    function hideYearSelector() {
        document.getElementById('yearSelector').style.display = 'none';
    }

    // Gestion du modal des RDV
    let currentAppointment = null;
    let originalDuration = null;

    function setupAppointmentModal() {
        // Fermeture du modal
        document.getElementById('closeAppointmentModal').addEventListener('click', hideAppointmentModal);
        document.getElementById('appointmentModal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('appointmentModal')) {
                hideAppointmentModal();
            }
        });

        // Actions du modal
        document.getElementById('editAppointmentBtn').addEventListener('click', editAppointment);
        document.getElementById('changeDurationBtn').addEventListener('click', toggleDurationEditor);
        document.getElementById('deleteAppointmentBtn').addEventListener('click', deleteAppointment);
        document.getElementById('saveDurationBtn').addEventListener('click', saveDuration);
        document.getElementById('cancelDurationBtn').addEventListener('click', cancelDurationEdit);

        // Boutons de durée prédéfinie
        document.querySelectorAll('.duration-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const minutes = parseInt(e.target.dataset.minutes);
                if (minutes) {
                    selectDuration(minutes);
                    document.getElementById('customDuration').value = minutes;
                }
            });
        });

        // Durée personnalisée
        document.getElementById('customDuration').addEventListener('input', (e) => {
            const minutes = parseInt(e.target.value);
            if (minutes && minutes >= 5) {
                selectDuration(minutes);
            }
        });
    }

    function showAppointmentModal(appointment) {
        currentAppointment = appointment;
        const service = services.find(s => s.id == appointment.extendedProps.serviceId);
        originalDuration = appointment.extendedProps.duration || (service ? service.duration : 60);

        // Remplir les informations
        document.getElementById('appointmentClientName').textContent = 
            `${appointment.extendedProps.clientFirstName} ${appointment.extendedProps.clientName}`;
        document.getElementById('appointmentServiceName').textContent = 
            service ? service.name : 'Service inconnu';
        
        const startDate = new Date(appointment.start);
        const endDate = new Date(appointment.end);
        document.getElementById('appointmentDateTime').textContent = 
            startDate.toLocaleDateString('fr-FR', { 
                weekday: 'long', 
                day: 'numeric', 
                month: 'long', 
                hour: '2-digit', 
                minute: '2-digit' 
            });
        
        const durationMinutes = Math.round((endDate - startDate) / (1000 * 60));
        document.getElementById('appointmentDuration').textContent = formatDuration(durationMinutes);
        document.getElementById('appointmentPrice').textContent = service ? service.price + '€' : 'N/A';

        // Réinitialiser l'éditeur de durée
        document.getElementById('durationEditor').style.display = 'none';
        document.getElementById('changeDurationBtn').style.display = 'block';
        document.getElementById('saveDurationBtn').style.display = 'none';
        document.getElementById('cancelDurationBtn').style.display = 'none';
        document.getElementById('customDuration').value = durationMinutes;
        
        // Afficher le modal
        document.getElementById('appointmentModal').style.display = 'flex';
    }

    function hideAppointmentModal() {
        document.getElementById('appointmentModal').style.display = 'none';
        currentAppointment = null;
        originalDuration = null;
    }

    // MODIFICATION DATE/HEURE + SERVICE (TOGGLE)
    function editAppointment() {
        if (currentAppointment) {
            toggleEditMode();
        }
    }

    function toggleEditMode() {
        const dateEl = document.getElementById('appointmentDateTime');
        const isEditing = dateEl.querySelector('input') !== null;
        
        if (isEditing) {
            // Mode édition → Mode affichage
            cancelEditMode();
        } else {
            // Mode affichage → Mode édition
            startEditMode();
        }
    }

    function startEditMode() {
        // 1. Transformer date/heure en input
        const dateEl = document.getElementById('appointmentDateTime');
        const currentDate = new Date(currentAppointment.start);
        const dateValue = currentDate.toISOString().slice(0, 16);
        dateEl.innerHTML = `<input type="datetime-local" id="editDateTime" value="${dateValue}" style="padding: 8px; border: 2px solid #A68B5B; border-radius: 8px; width: 100%; font-size: 0.9rem;">`;

        // 2. Transformer service en select
        const serviceEl = document.getElementById('appointmentServiceName');
        let options = '';
        services.forEach(service => {
            const selected = service.id == currentAppointment.extendedProps.serviceId ? 'selected' : '';
            options += `<option value="${service.id}" ${selected}>${service.name}</option>`;
        });
        serviceEl.innerHTML = `<select id="editService" style="padding: 8px; border: 2px solid #A68B5B; border-radius: 8px; width: 100%; font-size: 0.9rem;">${options}</select>`;

        // 3. Masquer les autres boutons temporairement (comme toggleDuration)
        document.getElementById('changeDurationBtn').style.display = 'none';
        document.getElementById('deleteAppointmentBtn').style.display = 'none';
        document.getElementById('editAppointmentBtn').style.display = 'none';

        // 4. Ajouter boutons de contrôle
        const actionsContainer = document.querySelector('.appointment-modal-actions');
        
        const saveBtn = document.createElement('button');
        saveBtn.className = 'action-btn save-btn';
        saveBtn.innerHTML = '<i class="fas fa-save"></i> Sauvegarder';
        saveBtn.onclick = saveEditChanges;
        saveBtn.id = 'saveEditBtn';
        
        const cancelBtn = document.createElement('button');
        cancelBtn.className = 'action-btn cancel-btn';
        cancelBtn.innerHTML = '<i class="fas fa-times"></i> Annuler';
        cancelBtn.onclick = cancelEditMode;
        cancelBtn.id = 'cancelEditBtn';
        
        actionsContainer.appendChild(saveBtn);
        actionsContainer.appendChild(cancelBtn);
    }

    function saveEditChanges() {
        const newDate = document.getElementById('editDateTime').value;
        const newServiceId = document.getElementById('editService').value;

        if (!newDate || !newServiceId) return;

        // Calculer la durée actuelle à partir des anciennes dates start/end
        const currentStart = new Date(currentAppointment.start);
        const currentEnd = new Date(currentAppointment.end);
        const currentDuration = Math.round((currentEnd - currentStart) / (1000 * 60)); // durée en minutes
        
        const endDate = new Date(new Date(newDate).getTime() + (currentDuration * 60000));

        fetch('{{ path('app_appointment_update') }}', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                id: currentAppointment.id,
                date: newDate,
                endDate: endDate.toISOString(),
                serviceId: newServiceId,
                clientId: currentAppointment.extendedProps.clientId
            })
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                // Mettre à jour localement
                const index = appointments.findIndex(apt => apt.id == currentAppointment.id);
                if (index !== -1) {
                    const service = services.find(s => s.id == newServiceId);
                    appointments[index].title = service ? service.name : appointments[index].title;
                    appointments[index].start = newDate;
                    appointments[index].end = endDate.toISOString();
                    appointments[index].extendedProps.serviceId = newServiceId;
                    currentAppointment = appointments[index];
                }
                toggleEditMode();
                showView(currentView);
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
        });
    }

    function cancelEditMode() {
        // Restaurer l'affichage original
        const dateEl = document.getElementById('appointmentDateTime');
        const serviceEl = document.getElementById('appointmentServiceName');

        // Restaurer date
        const startDate = new Date(currentAppointment.start);
        dateEl.textContent = startDate.toLocaleDateString('fr-FR', { 
            weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' 
        });

        // Restaurer service
        const service = services.find(s => s.id == currentAppointment.extendedProps.serviceId);
        serviceEl.textContent = service ? service.name : 'Service inconnu';

        // Restaurer les boutons originaux (comme toggleDuration)
        document.getElementById('changeDurationBtn').style.display = 'block';
        document.getElementById('deleteAppointmentBtn').style.display = 'block';
        document.getElementById('editAppointmentBtn').style.display = 'block';

        // Supprimer les boutons temporaires
        const saveBtn = document.getElementById('saveEditBtn');
        const cancelBtn = document.getElementById('cancelEditBtn');
        if (saveBtn) saveBtn.remove();
        if (cancelBtn) cancelBtn.remove();
    }

    function toggleDurationEditor() {
        const editor = document.getElementById('durationEditor');
        const isVisible = editor.style.display !== 'none';
        
        editor.style.display = isVisible ? 'none' : 'block';
        document.getElementById('editAppointmentBtn').style.display = isVisible ? 'block' : 'none';
        document.getElementById('changeDurationBtn').style.display = isVisible ? 'block' : 'none';
        document.getElementById('deleteAppointmentBtn').style.display = isVisible ? 'block' : 'none';
        document.getElementById('saveDurationBtn').style.display = isVisible ? 'none' : 'block';
        document.getElementById('cancelDurationBtn').style.display = isVisible ? 'none' : 'block';
        
        if (!isVisible) {
            // Sélectionner la durée actuelle
            const currentDuration = originalDuration;
            selectDuration(currentDuration);
            document.getElementById('customDuration').value = currentDuration;
        }
    }

    function selectDuration(minutes) {
        // Désélectionner tous les boutons
        document.querySelectorAll('.duration-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        
        // Sélectionner le bouton correspondant
        const btn = document.querySelector(`[data-minutes="${minutes}"]`);
        if (btn) {
            btn.classList.add('active');
        }
    }

    function saveDuration() {
        const newDuration = parseInt(document.getElementById('customDuration').value);
        
        if (!newDuration || newDuration < 5) {
            alert('Veuillez saisir une durée valide (minimum 5 minutes)');
            return;
        }

        if (!currentAppointment) return;

        // Calculer la nouvelle heure de fin
        const startDate = new Date(currentAppointment.start);
        const newEndDate = new Date(startDate.getTime() + (newDuration * 60 * 1000));

        // Mettre à jour l'appointment
        currentAppointment.end = newEndDate.toISOString();
        currentAppointment.extendedProps.duration = newDuration;

        // Faire la requête AJAX pour sauvegarder
        updateAppointmentDuration(currentAppointment.id, newDuration)
            .then(() => {
                // Mettre à jour l'affichage
                document.getElementById('appointmentDuration').textContent = formatDuration(newDuration);
                originalDuration = newDuration;
                
                // Fermer l'éditeur
                toggleDurationEditor();
                
                // Rafraîchir la vue
                showView(currentView);
                
                            })
            .catch(error => {
                console.error('Erreur lors de la mise à jour:', error);
    
            });
    }

    function cancelDurationEdit() {
        toggleDurationEditor();
        document.getElementById('customDuration').value = originalDuration;
        selectDuration(originalDuration);
    }

    function deleteAppointment() {
        if (!currentAppointment) return;

        if (confirm('Êtes-vous sûr de vouloir supprimer ce rendez-vous ?')) {
            // Faire la requête AJAX pour supprimer
            deleteAppointmentById(currentAppointment.id)
                .then(() => {
                    // Retirer de la liste locale
                    appointments = appointments.filter(apt => apt.id !== currentAppointment.id);
                    
                    hideAppointmentModal();
                    showView(currentView);
                    
                })
                .catch(error => {
                    console.error('Erreur lors de la suppression:', error);
                });
        }
    }

    function formatDuration(minutes) {
        const hours = Math.floor(minutes / 60);
        const mins = minutes % 60;
        
        if (hours === 0) {
            return `${mins} min`;
        } else if (mins === 0) {
            return `${hours}h`;
        } else {
            return `${hours}h${mins.toString().padStart(2, '0')}`;
        }
    }

    // API calls pour mise à jour et suppression
    async function updateAppointmentDuration(appointmentId, newDuration) {
        // Récupérer l'appointment complet depuis la liste locale
        const appointment = appointments.find(apt => apt.id == appointmentId);
        if (!appointment) {
            throw new Error('Rendez-vous introuvable');
        }

        // Calculer la nouvelle heure de fin
        const startDate = new Date(appointment.start);
        const newEndDate = new Date(startDate.getTime() + (newDuration * 60 * 1000));
        
        // Formater l'endDate dans le même format que la date de début (format local)
        const year = newEndDate.getFullYear();
        const month = String(newEndDate.getMonth() + 1).padStart(2, '0');
        const day = String(newEndDate.getDate()).padStart(2, '0');
        const hours = String(newEndDate.getHours()).padStart(2, '0');
        const minutes = String(newEndDate.getMinutes()).padStart(2, '0');
        
        const endDateFormatted = `${year}-${month}-${day}T${hours}:${minutes}`;

        const response = await fetch('{{ path('app_appointment_update') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ 
                id: appointmentId,
                date: appointment.start,
                endDate: endDateFormatted,
                serviceId: appointment.extendedProps.serviceId,
                clientId: appointment.extendedProps.clientId
            })
        });

        if (!response.ok) {
            throw new Error('Erreur réseau');
        }

        return response.json();
    }

    async function deleteAppointmentById(appointmentId) {
        const response = await fetch('{{ path('app_appointment_delete') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ id: appointmentId })
        });

        if (!response.ok) {
            throw new Error('Erreur réseau');
        }

        const result = await response.json();
        return result.success;
    }



    // Mise à jour de la fonction de clic sur les RDV
    function setupAppointmentEvents() {
        document.querySelectorAll('.appointment-card, .week-appointment, .month-appointment, .appointment-timeline-block').forEach(card => {
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                const appointmentId = card.dataset.id;
                const appointment = appointments.find(apt => apt.id == appointmentId);
                if (appointment) {
                    showAppointmentModal(appointment);
                }
            });
        });
    }

    // Génération des créneaux horaires
    function generateTimeSlots() {
        const slots = [];
        for (let hour = 9; hour <= 19; hour++) {
            slots.push(`${hour.toString().padStart(2, '0')}:00`);
        }
        return slots;
    }

    // Rendu carte RDV
    function renderAppointmentCard(appointment) {
        const service = services.find(s => s.id == appointment.extendedProps.serviceId);
        const client = clients.find(c => c.id == appointment.extendedProps.clientId);
        const colorClass = serviceColors[appointment.extendedProps.serviceId] || '';
        
        const startTime = new Date(appointment.start).toLocaleTimeString('fr-FR', {
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Paris'
        });
        
        const endTime = new Date(appointment.end).toLocaleTimeString('fr-FR', {
            hour: '2-digit', 
            minute: '2-digit',
            timeZone: 'Europe/Paris'
        });

        const clientInitials = client ? 
            (client.firstName.charAt(0) + client.name.charAt(0)).toUpperCase() : '??';

        return `
            <div class="appointment-card ${colorClass}" data-id="${appointment.id}">
                <div class="appointment-header">
                    <div class="appointment-service">${appointment.title}</div>
                    <div class="appointment-time">${startTime} - ${endTime}</div>
                </div>
                <div class="appointment-client">
                    <div class="client-avatar">${clientInitials}</div>
                    <div class="client-info">
                        <div class="client-name">${appointment.extendedProps.clientFirstName} ${appointment.extendedProps.clientName}</div>
                    </div>
                </div>
                <div class="appointment-details">
                    <div class="appointment-duration">
                        <i class="fas fa-clock"></i>
                        ${(() => {
                            const duration = appointment.extendedProps.duration || service?.duration || Math.round((new Date(appointment.end) - new Date(appointment.start)) / (1000 * 60));
                            return formatDuration(duration);
                        })()}
                    </div>
                    <div class="appointment-price">
                        ${appointment.extendedProps.price || service?.price || 0}€
                    </div>
                </div>
            </div>
        `;
    }

    // Utilitaires de données
    function getDayAppointments(date) {
    
        const filtered = appointments.filter(appointment => {
            const appointmentDate = new Date(appointment.start);
            const match = appointmentDate.toDateString() === date.toDateString();
            return match;
        })
            .sort((a, b) => new Date(a.start) - new Date(b.start))
            .slice(0, 20);
        
        return filtered;
    }

    function getUpcomingAppointments() {
        const now = new Date();
        return appointments
            .filter(apt => new Date(apt.start) >= now)
            .sort((a, b) => new Date(a.start) - new Date(b.start))
            .slice(0, 20); // Limite à 20 RDV
    }

    // Chargement des données
    function loadData() {
        Promise.all([
            loadAppointments(),
            loadServices(),
            loadClients()
        ]).then(() => {
    
            renderDayView();
        }).catch(error => {
            console.error('Erreur lors du chargement des données:', error);
            showToast('Erreur lors du chargement des données', 'error');
        });
    }

    function loadAppointments() {
        return fetch('{{ path('app_calendar_events') }}')
            .then(response => {
                return response.json();
            })
            .then(data => {
                appointments = data;
            })
            .catch(error => {
                console.error('Erreur chargement RDV:', error);
            });
    }

    function loadServices() {
        return fetch('{{ path('app_get_services') }}')
            .then(response => response.json())
            .then(data => {
                services = data;
                populateServiceSelect();
            })
            .catch(error => {
                console.error('Erreur chargement services:', error);
            });
    }

    function loadClients() {
        return fetch('{{ path('app_get_clients') }}')
            .then(response => response.json())
            .then(data => {
                clients = data;
                populateClientSelect();
            })
            .catch(error => {
                console.error('Erreur chargement clients:', error);
            });
    }

    function populateServiceSelect() {
        const select = document.getElementById('serviceSelect');
        if (!select) {
            console.error('Élément serviceSelect introuvable');
            return;
        }
        
        // Vider les options existantes sauf la première
        while (select.children.length > 1) {
            select.removeChild(select.lastChild);
        }
        
        services.forEach(service => {
            const option = document.createElement('option');
            option.value = service.id;
            option.textContent = service.name;
            select.appendChild(option);
        });
    }

    function populateClientSelect() {
        const select = document.getElementById('clientSelect');
        if (!select) {
            console.error('Élément clientSelect introuvable');
            return;
        }
        
        // Vider les options existantes sauf la première
        while (select.children.length > 1) {
            select.removeChild(select.lastChild);
        }
        
        clients.forEach(client => {
            const option = document.createElement('option');
            option.value = client.id;
            option.textContent = `${client.firstName} ${client.name}`;
            select.appendChild(option);
        });
    }

    // Modal management
    function showNewAppointmentModal() {
        const modal = document.getElementById('newAppointmentModal');
        modal.classList.add('show');
        
        // Set default date to current selected date
        const dateInput = document.getElementById('appointmentDate');
        const defaultDateTime = new Date(currentDate);
        defaultDateTime.setHours(9, 0, 0, 0);
        dateInput.value = defaultDateTime.toISOString().slice(0, 16);
    }

    function hideNewAppointmentModal() {
        const modal = document.getElementById('newAppointmentModal');
        modal.classList.remove('show');
    }

    // Configuration du modal de nouveau RDV
    function setupNewAppointmentModal() {
        // Fermeture du modal
        document.querySelectorAll('#newAppointmentModal .modal-close').forEach(btn => {
            btn.addEventListener('click', hideNewAppointmentModal);
        });
        
        document.getElementById('newAppointmentModal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('newAppointmentModal')) {
                hideNewAppointmentModal();
            }
        });

        // Bouton de sauvegarde
        document.getElementById('saveAppointment').addEventListener('click', saveAppointment);
    }

    function saveAppointment() {
        const form = document.getElementById('appointmentForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        if (!data.date || !data.serviceId || !data.clientId) {
            showToast('Veuillez remplir tous les champs', 'error');
            return;
        }

        const selectedService = services.find(s => s.id == data.serviceId);
        if (!selectedService) {
            showToast('Service introuvable', 'error');
            return;
        }


        const startDate = new Date(data.date);
        const durationInMinutes = parseInt(selectedService.duration) || 0;
        const durationInMs = durationInMinutes * 60000;
        const endDate = new Date(startDate.getTime() + durationInMs);
        
        // Formater l'endDate dans le même format que la date de début (format local)
        const year = endDate.getFullYear();
        const month = String(endDate.getMonth() + 1).padStart(2, '0');
        const day = String(endDate.getDate()).padStart(2, '0');
        const hours = String(endDate.getHours()).padStart(2, '0');
        const minutes = String(endDate.getMinutes()).padStart(2, '0');
        
        data.endDate = `${year}-${month}-${day}T${hours}:${minutes}`;
        

        fetch('{{ path('app_appointment_create') }}', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                // Add to local appointments array
                appointments.push({
                    id: result.id,
                    title: result.serviceName,
                    start: result.date,
                    end: result.endDate,
                    extendedProps: {
                        clientName: result.clientName,
                        clientFirstName: result.clientFirstName,
                        serviceId: result.serviceId,
                        clientId: result.clientId,
                        duration: selectedService.duration,
                        price: selectedService.price
                    }
                });
                
                hideNewAppointmentModal();
                form.reset();
                showView(currentView);
                showToast('Rendez-vous créé avec succès', 'success');
            } else {
                showToast('Erreur lors de la création: ' + (result.error || 'Erreur inconnue'), 'error');
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            showToast('Erreur de connexion', 'error');
        });
    }
});
</script>
{% endblock %}

{% block body %}
<div class="mobile-calendar">
    <!-- Header mobile -->
    <div class="mobile-header">
        <div class="header-top">
            <div class="header-title">
                <i class="fas fa-calendar-alt"></i>
                Calendrier
            </div>
            <div class="header-date" id="headerDate">
                {{ "now"|date("d M Y") }}
            </div>
        </div>

        <!-- Navigation -->
        <div class="mobile-nav">
            <button class="nav-btn" id="prevPeriod">
                <i class="fas fa-chevron-left"></i>
            </button>
            <div class="nav-current-date" id="currentDate">
                Aujourd'hui
            </div>
            <button class="nav-btn" id="nextPeriod">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
        
        <!-- Navigation rapide -->
        <div class="quick-nav">
            <button class="quick-nav-btn" id="todayBtn">
                <i class="fas fa-home"></i>
                Aujourd'hui
            </button>
            <button class="quick-nav-btn" id="yearViewBtn">
                <i class="fas fa-calendar-alt"></i>
                <span id="currentYear">2024</span>
            </button>
        </div>

        <!-- Vue tabs -->
        <div class="view-tabs">
            <button class="view-tab active" data-view="day">
                <i class="fas fa-calendar-day"></i>
                Jour
            </button>
            <button class="view-tab" data-view="week">
                <i class="fas fa-calendar-week"></i>
                Semaine
            </button>
            <button class="view-tab" data-view="month">
                <i class="fas fa-calendar"></i>
                Mois
            </button>
            <button class="view-tab" data-view="list">
                <i class="fas fa-list"></i>
                Liste
            </button>
            <button class="view-tab" data-view="stats">
                <i class="fas fa-chart-bar"></i>
                Stats
            </button>
        </div>
    </div>

    <!-- Vue Jour -->
    <div class="day-view view-content" id="dayView">
        <div class="day-header">
            <div class="day-title" id="dayTitle">Aujourd'hui</div>
            <div class="day-subtitle">Vos rendez-vous du jour</div>
        </div>
        
        <div class="timeline" id="dayAppointments">
            <!-- Les RDV seront chargés ici -->
        </div>
    </div>

    <!-- Vue Liste -->
    <div class="list-view view-content" id="listView" style="display: none;">
        <div class="list-filters">
            <div class="filter-row">
                <input type="text" class="filter-input" placeholder="Rechercher un client..." id="searchClient">
            </div>
            <div class="filter-row">
                <select class="filter-input" id="filterService">
                    <option value="">Tous les services</option>
                </select>
                <input type="date" class="filter-input" id="filterDate">
            </div>
        </div>
        
        <div id="listAppointments">
            <!-- Les RDV seront chargés ici -->
        </div>
    </div>

    <!-- Vue Semaine -->
    <div class="week-view view-content" id="weekView" style="display: none;">
        <div class="week-nav">
            <button class="week-nav-btn" id="prevWeek">
                <i class="fas fa-chevron-left"></i>
                Semaine précédente
            </button>
            <div class="week-range" id="weekRange">
                <!-- Range de la semaine -->
            </div>
            <button class="week-nav-btn" id="nextWeek">
                Semaine suivante
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
        <div class="week-grid" id="weekGrid">
            <!-- La semaine sera chargée ici -->
        </div>
    </div>

    <!-- Vue Mois -->
    <div class="month-view view-content" id="monthView" style="display: none;">
        <div class="month-nav">
            <button class="month-nav-btn" id="prevMonth">
                <i class="fas fa-chevron-left"></i>
            </button>
            <div class="month-title" id="monthTitle">
                <!-- Titre du mois -->
            </div>
            <button class="month-nav-btn" id="nextMonth">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
        <div class="month-grid" id="monthGrid">
            <!-- Le mois sera chargé ici -->
        </div>
    </div>

    <!-- Vue Statistiques -->
    <div class="stats-view view-content" id="statsView" style="display: none;">
        <div class="stats-header">
            <h2>Statistiques L'Atelier de Marie</h2>
            <div class="stats-period">
                <select id="statsPeriod" class="form-input-mobile">
                    <option value="month">Ce mois</option>
                    <option value="quarter">Ce trimestre</option>
                    <option value="year">Cette année</option>
                    <option value="all">Tout</option>
                </select>
            </div>
        </div>

        <!-- KPIs rapides -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-number" id="totalAppointments">0</div>
                    <div class="kpi-label">Rendez-vous</div>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="fas fa-euro-sign"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-number" id="totalRevenue">0€</div>
                    <div class="kpi-label">Chiffre d'affaires</div>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-number" id="totalClients">0</div>
                    <div class="kpi-label">Clients uniques</div>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-number" id="avgTicket">0€</div>
                    <div class="kpi-label">Ticket moyen</div>
                </div>
            </div>
        </div>

        <!-- Graphiques -->
        <div class="charts-container">
            <div class="chart-card">
                <h3>Répartition par service</h3>
                <canvas id="servicesChart"></canvas>
            </div>
            <div class="chart-card">
                <h3>Évolution mensuelle</h3>
                <canvas id="monthlyChart"></canvas>
            </div>
            <div class="chart-card">
                <h3>Top clients</h3>
                <div id="topClients" class="top-list">
                    <!-- Top clients sera chargé ici -->
                </div>
            </div>
            <div class="chart-card">
                <h3>Répartition horaire</h3>
                <canvas id="hourlyChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Sélecteur d'année -->
    <div class="year-selector" id="yearSelector" style="display: none;">
        <div class="year-grid" id="yearGrid">
            <!-- Les années seront chargées ici -->
        </div>
    </div>

    <!-- Modal de gestion des RDV -->
    <div class="appointment-modal" id="appointmentModal" style="display: none;">
        <div class="appointment-modal-content">
            <div class="appointment-modal-header">
                <h3 id="appointmentModalTitle">Gérer le rendez-vous</h3>
                <button class="close-btn" id="closeAppointmentModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="appointment-modal-body">
                <div class="appointment-info">
                    <div class="appointment-detail">
                        <i class="fas fa-user"></i>
                        <span id="appointmentClientName">Client</span>
                    </div>
                    <div class="appointment-detail">
                        <i class="fas fa-cut"></i>
                        <span id="appointmentServiceName">Service</span>
                    </div>
                    <div class="appointment-detail">
                        <i class="fas fa-clock"></i>
                        <span id="appointmentDateTime">Date et heure</span>
                    </div>
                    <div class="appointment-detail">
                        <i class="fas fa-hourglass-half"></i>
                        <span id="appointmentDuration">Durée</span>
                    </div>
                    <div class="appointment-detail">
                        <i class="fas fa-euro-sign"></i>
                        <span id="appointmentPrice">Prix</span>
                    </div>
                </div>

                <div class="duration-editor" id="durationEditor" style="display: none;">
                    <h4>Modifier la durée</h4>
                    <div class="duration-controls">
                        <button class="duration-btn" data-minutes="15">15 min</button>
                        <button class="duration-btn" data-minutes="30">30 min</button>
                        <button class="duration-btn" data-minutes="45">45 min</button>
                        <button class="duration-btn" data-minutes="60">1h</button>
                        <button class="duration-btn" data-minutes="90">1h30</button>
                        <button class="duration-btn" data-minutes="120">2h</button>
                    </div>
                    <div class="custom-duration">
                        <label for="customDuration">Durée personnalisée (minutes) :</label>
                        <input type="number" id="customDuration" min="5" max="480" step="5" class="form-input-mobile">
                    </div>
                </div>
            </div>

            <div class="appointment-modal-actions">
                <button class="action-btn edit-btn" id="editAppointmentBtn">
                    <i class="fas fa-edit"></i>
                    Modifier
                </button>
                <button class="action-btn duration-btn-toggle" id="changeDurationBtn">
                    <i class="fas fa-clock"></i>
                    Changer durée
                </button>
                <button class="action-btn delete-btn" id="deleteAppointmentBtn">
                    <i class="fas fa-trash"></i>
                    Supprimer
                </button>
                <button class="action-btn save-btn" id="saveDurationBtn" style="display: none;">
                    <i class="fas fa-save"></i>
                    Sauvegarder
                </button>
                <button class="action-btn cancel-btn" id="cancelDurationBtn" style="display: none;">
                    <i class="fas fa-times"></i>
                    Annuler
                </button>
            </div>
        </div>
    </div>

    <!-- Bouton flottant -->
    <button class="fab" id="newAppointmentBtn">
        <i class="fas fa-plus"></i>
    </button>
</div>

<!-- Modal Nouveau RDV -->
<div class="mobile-modal" id="newAppointmentModal">
    <div class="modal-content-mobile">
        <div class="modal-header-mobile">
            <div class="modal-title-mobile">Nouveau Rendez-vous</div>
            <button class="modal-close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body-mobile">
            <form id="appointmentForm">
                <div class="form-group-mobile">
                    <label class="form-label-mobile">Date et heure</label>
                    <input type="datetime-local" class="form-input-mobile" id="appointmentDate" name="date" required>
                </div>
                <div class="form-group-mobile">
                    <label class="form-label-mobile">Service</label>
                    <select class="form-input-mobile" id="serviceSelect" name="serviceId" required>
                        <option value="">Choisir un service</option>
                    </select>
                </div>
                <div class="form-group-mobile">
                    <label class="form-label-mobile">Client</label>
                    <select class="form-input-mobile" id="clientSelect" name="clientId" required>
                        <option value="">Choisir un client</option>
                    </select>
                </div>
            </form>
        </div>
        <div class="modal-footer-mobile">
            <button type="button" class="btn-mobile btn-secondary-mobile modal-close">Annuler</button>
            <button type="button" class="btn-mobile btn-primary-mobile" id="saveAppointment">Créer</button>
        </div>
    </div>
</div>
{% endblock %}
