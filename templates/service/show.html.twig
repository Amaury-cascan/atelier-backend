{% extends 'base_admin.html.twig' %}

{% block title %}Détails de la prestation{% endblock %}

{% block stylesheets %}
<style>
.service-container {
    max-width: 900px;
    margin: 0 auto;
}

.service-header {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(197, 101, 63, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    text-align: center;
}

.service-title {
    color: var(--taupe);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.service-subtitle {
    color: var(--taupe-dark);
    margin-top: 0.5rem;
    font-size: 1rem;
}

.service-details-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 
        0 10px 25px rgba(162, 78, 50, 0.08),
        0 4px 15px rgba(162, 78, 50, 0.05);
    margin-bottom: 2rem;
    position: relative;
}

.service-details-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--taupe), var(--taupe-light));
    border-radius: 20px 20px 0 0;
}

.service-details {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: start;
}

.service-image-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.service-image {
    width: 100%;
    max-width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(139, 115, 85, 0.15);
    transition: all 0.3s ease;
}

.service-image:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(139, 115, 85, 0.2);
}

.no-image {
    width: 100%;
    max-width: 300px;
    height: 200px;
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(197, 101, 63, 0.05));
    border: 2px dashed rgba(162, 78, 50, 0.3);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--taupe-dark);
}

.no-image i {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.service-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.info-row {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: rgba(162, 78, 50, 0.03);
    border-radius: 12px;
    border-left: 4px solid var(--taupe);
}

.info-label {
    font-weight: 600;
    color: var(--taupe);
    min-width: 120px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.info-value {
    color: #333;
    font-weight: 500;
}

.price-value {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
    font-size: 1.2rem;
}

.duration-value {
    background: linear-gradient(135deg, #F59E0B, #D97706);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
}

.description-value {
    line-height: 1.6;
    color: var(--taupe-dark);
}

.actions-container {
    display: flex;
    gap: 1rem;
    justify-content: flex-start;
    flex-wrap: wrap;
    align-items: center;
}

.action-btn {
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
}

.back-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--taupe-dark);
    border: 1px solid rgba(162, 78, 50, 0.2);
}

.back-btn:hover {
    background: var(--taupe);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(162, 78, 50, 0.2);
}

.edit-btn {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
}

.edit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.3);
    color: white;
}

.delete-btn {
    background: var(--adm-error, #c94a4a);
    color: white;
    border: 1px solid transparent;
}

.delete-btn:hover {
    background: #b03a3a;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(201, 74, 74, 0.3);
}

.service-delete-form {
    display: inline-block;
}

/* Responsive */
@media (max-width: 768px) {
    .service-details {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    
    .service-details-card {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .service-header {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .service-title {
        font-size: 1.6rem;
        flex-direction: column;
    }
    
    .actions-container {
        justify-content: center;
        flex-direction: column;
        align-items: stretch;
    }
    
    .info-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
    
    .info-label {
        min-width: auto;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="service-container" data-animate="true">
    <div class="service-header">
        <h1 class="service-title">
            <i class="fas fa-eye"></i>
            Détails de la prestation
        </h1>
        <p class="service-subtitle">Informations complètes sur {{ service.name }}</p>
    </div>

    <div class="service-details-card">
        <div class="service-details">
            <div class="service-image-container">
                {% if service.picture %}
                    <img src="{{ asset('uploads/services/' ~ service.picture) }}" 
                         alt="{{ service.name }}" 
                         class="service-image">
                {% else %}
                    <div class="no-image">
                        <i class="fas fa-image"></i>
                        <span>Aucune image</span>
                    </div>
                {% endif %}
            </div>
            
            <div class="service-info">
                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-tag"></i>
                        Nom
                    </div>
                    <div class="info-value">{{ service.name }}</div>
                </div>
                
                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-euro-sign"></i>
                        Prix
                    </div>
                    <div class="info-value price-value">{{ service.price }} €</div>
                </div>
                
                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-clock"></i>
                        Durée
                    </div>
                    <div class="info-value duration-value">{{ service.duration }} minutes</div>
                </div>
                
                {% if service.description %}
                <div class="info-row">
                    <div class="info-label">
                        <i class="fas fa-align-left"></i>
                        Description
                    </div>
                    <div class="info-value description-value">{{ service.description }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="actions-container">
        <a href="{{ path('app_service_index') }}" class="action-btn back-btn">
            <i class="fas fa-arrow-left"></i>
            Retour à la liste
        </a>
        <a href="{{ path('app_service_edit', {'id': service.id}) }}" class="action-btn edit-btn">
            <i class="fas fa-edit"></i>
            Modifier
        </a>
        {{ include('service/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}