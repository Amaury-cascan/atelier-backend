{% extends 'base.html.twig' %}

{% block title %}Détails de la prestation{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails de la prestation</h1>

    <div class="card mb-4">
        <div class="card-body">
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th>Nom</th>
                        <td>{{ service.name }}</td>
                    </tr>
                    <tr>
                        <th>Prix</th>
                        <td>{{ service.price }} €</td>
                    </tr>
                    <tr>
                        <th>Image</th>
                        <td>
                            {% if service.picture %}
                                <img src="{{ asset('uploads/services/' ~ service.picture) }}" alt="{{ service.name }}" class="img-thumbnail" style="max-width: 200px;">
                            {% else %}
                                <span class="text-muted">Aucune image</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ service.description }}</td>
                    </tr>
                    <tr>
                        <th>Durée</th>
                        <td>{{ service.duration }} min</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_service_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_service_edit', {'id': service.id}) }}" class="btn btn-primary">Modifier</a>
        {{ include('service/_delete_form.html.twig') }}
    </div>
{% endblock %}