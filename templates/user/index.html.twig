{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block stylesheets %}
<style>
.users-container {
    padding: 2rem 0;
}

.page-header {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(197, 101, 63, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
}

.page-title {
    color: var(--taupe);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 16px;
}

.page-subtitle {
    color: var(--taupe-dark);
    margin-top: 0.5rem;
    font-size: 1.1rem;
}

.stats-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
    text-align: center;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.15);
}

.stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    font-size: 1.5rem;
    color: white;
}

.stat-icon.users { background: linear-gradient(135deg, var(--taupe), var(--taupe-dark)); }
.stat-icon.admins { background: linear-gradient(135deg, #dc2626, #b91c1c); }
.stat-icon.regular { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--taupe);
    margin-bottom: 0.5rem;
}

.stat-label {
    color: var(--taupe-dark);
    font-weight: 500;
}

.users-cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.user-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
    transition: all 0.3s ease;
    position: relative;
}

.user-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.15);
}

.user-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1rem;
}

.user-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1.2rem;
}

.user-info h4 {
    margin: 0;
    color: var(--taupe);
    font-weight: 600;
    font-size: 1.1rem;
}

.user-id {
    color: var(--taupe-dark);
    font-size: 0.85rem;
    opacity: 0.8;
}

.user-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.role-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
}

.role-badge.admin {
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.1), rgba(185, 28, 28, 0.05));
    color: #dc2626;
    border: 1px solid rgba(220, 38, 38, 0.2);
}

.role-badge.user {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(29, 78, 216, 0.05));
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.2);
}

.role-badge.other {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(125, 58, 38, 0.05));
    color: var(--taupe);
    border: 1px solid rgba(162, 78, 50, 0.2);
}

.user-meta {
    color: var(--taupe-dark);
    font-size: 0.85rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 6px;
}

.user-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
}

.action-btn {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 4px;
    border: none;
    cursor: pointer;
}

.action-btn.view {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.2);
}

.action-btn.edit {
    background: rgba(162, 78, 50, 0.1);
    color: var(--taupe);
    border: 1px solid rgba(162, 78, 50, 0.2);
}

.action-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.search-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.search-title {
    color: var(--taupe);
    font-weight: 600;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.search-container {
    position: relative;
    min-width: 300px;
}

.search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.5rem;
    border: 2px solid rgba(162, 78, 50, 0.15);
    border-radius: 25px;
    background: rgba(255, 255, 255, 0.9);
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.search-input:focus {
    outline: none;
    border-color: var(--taupe);
    box-shadow: 0 0 0 3px rgba(162, 78, 50, 0.1);
}

.search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--taupe);
}

.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--taupe-dark);
}

.empty-state i {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.add-btn {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.add-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.3);
    color: white;
}

.results-counter {
    color: var(--taupe-dark);
    font-size: 0.9rem;
    margin-top: 1rem;
}

/* Responsive */
@media (max-width: 768px) {
    .users-cards-container {
        grid-template-columns: 1fr;
    }
    
    .search-header {
        flex-direction: column;
        align-items: stretch;
    }
    
    .search-container {
        min-width: auto;
    }
    
    .page-title {
        font-size: 2rem;
        flex-direction: column;
        text-align: center;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="users-container" data-animate="true">
    <!-- En-tête -->
    <div class="page-header">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-users"></i>
                    Gestion des Utilisateurs
                </h1>
                <p class="page-subtitle">Gérez les comptes utilisateurs de votre application</p>
            </div>
            <a href="{{ path('app_user_new') }}" class="add-btn">
                <i class="fas fa-plus-circle"></i>
                Nouvel Utilisateur
            </a>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon users">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-number" data-target="{{ users|length }}">0</div>
            <div class="stat-label">Utilisateurs total</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon admins">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="stat-number" data-target="{% set adminCount = 0 %}{% for user in users %}{% if user.roles is defined and 'ROLE_ADMIN' in user.roles %}{% set adminCount = adminCount + 1 %}{% endif %}{% endfor %}{{ adminCount }}">0</div>
            <div class="stat-label">Administrateurs</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon regular">
                <i class="fas fa-user"></i>
            </div>
            <div class="stat-number" data-target="{{ users|length - adminCount }}">0</div>
            <div class="stat-label">Utilisateurs standards</div>
        </div>
    </div>

    <!-- Recherche -->
    <div class="search-header">
        <h4 class="search-title">
            <i class="fas fa-list"></i>
            Liste des Utilisateurs
        </h4>
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Rechercher un utilisateur..." id="searchUsers">
        </div>
    </div>

    <!-- Liste des utilisateurs -->
    {% if users is not empty %}
        <div class="users-cards-container">
            {% for user in users %}
                <div class="user-card" data-user="{{ user.email|lower }}">
                    <div class="user-header">
                        <div class="user-avatar">
                            {{ user.email|first|upper }}
                        </div>
                        <div class="user-info">
                            <h4>{{ user.email }}</h4>
                            <div class="user-id">ID: #{{ user.id }}</div>
                        </div>
                    </div>

                    <div class="user-roles">
                        {% if user.roles is defined and user.roles|length > 0 %}
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="role-badge admin">
                                        <i class="fas fa-crown"></i>
                                        Administrateur
                                    </span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="role-badge user">
                                        <i class="fas fa-user"></i>
                                        Utilisateur
                                    </span>
                                {% else %}
                                    <span class="role-badge other">
                                        <i class="fas fa-tag"></i>
                                        {{ role }}
                                    </span>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <span class="role-badge other">
                                <i class="fas fa-exclamation-triangle"></i>
                                Aucun rôle
                            </span>
                        {% endif %}
                    </div>

                    {% if user.createdAt is defined %}
                    <div class="user-meta">
                        <i class="fas fa-calendar-plus"></i>
                        Créé le {{ user.createdAt|date('d/m/Y à H:i') }}
                    </div>
                    {% endif %}

                    <div class="user-actions">
                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="action-btn view">
                            <i class="fas fa-eye"></i>
                            Voir
                        </a>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="action-btn edit">
                            <i class="fas fa-edit"></i>
                            Modifier
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="results-counter">
            <span id="userCount">{{ users|length }}</span> utilisateur(s) affiché(s)
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-users"></i>
            <h3>Aucun utilisateur trouvé</h3>
            <p>Créez votre premier utilisateur pour commencer</p>
            <a href="{{ path('app_user_new') }}" class="add-btn">
                <i class="fas fa-plus-circle"></i>
                Créer un Utilisateur
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des compteurs
    document.querySelectorAll('.stat-number').forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target'));
        if (!isNaN(target)) {
            let current = 0;
            const increment = target / 20;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                counter.textContent = Math.floor(current);
            }, 50);
        }
    });

    // Recherche en temps réel
    const searchInput = document.getElementById('searchUsers');
    const userCards = document.querySelectorAll('.user-card');
    const userCounter = document.getElementById('userCount');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            let visibleCount = 0;
            
            userCards.forEach(card => {
                const userEmail = card.getAttribute('data-user');
                if (userEmail.includes(searchTerm)) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            if (userCounter) {
                userCounter.textContent = visibleCount;
            }
        });
    }
});
</script>
{% endblock %}