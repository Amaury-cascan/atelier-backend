
{% extends 'base.html.twig' %}

{% block title %}Connexion - L'Atelier de Marie{% endblock %}

{% block stylesheets %}
<style>
/* Login page moderne avec glassmorphism */
.login-container {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    position: relative;
    overflow: hidden;
}

.login-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
        radial-gradient(circle at 20% 80%, rgba(162, 78, 50, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(197, 101, 63, 0.15) 0%, transparent 50%),
        linear-gradient(135deg, var(--beige) 0%, var(--taupe-light) 100%);
    z-index: -1;
}

.login-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 3rem 2.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 
        0 20px 40px rgba(162, 78, 50, 0.12),
        0 8px 30px rgba(162, 78, 50, 0.08);
    width: 100%;
    max-width: 450px;
    position: relative;
    overflow: hidden;
    animation: slideInUp 0.6s ease-out;
}

.login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--taupe), var(--taupe-light), var(--taupe));
    border-radius: 24px 24px 0 0;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.login-header {
    text-align: center;
    margin-bottom: 2.5rem;
}

.login-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: white;
    font-size: 2rem;
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.3);
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.login-title {
    color: var(--taupe);
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.login-subtitle {
    color: var(--taupe-dark);
    font-size: 0.95rem;
    margin: 0;
    font-weight: 400;
}

.login-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-group {
    position: relative;
}

.form-label {
    display: block;
    font-weight: 600;
    color: var(--taupe);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.form-label i {
    color: var(--taupe);
}

.form-control {
    width: 100%;
    padding: 1rem 1.25rem;
    border: 2px solid rgba(162, 78, 50, 0.15);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    font-family: 'Inter', sans-serif;
    color: #333;
    transition: all 0.3s ease;
    box-sizing: border-box;
}

.form-control:focus {
    outline: none;
    border-color: var(--taupe);
    box-shadow: 
        0 0 0 3px rgba(162, 78, 50, 0.1),
        0 4px 15px rgba(162, 78, 50, 0.15);
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-1px);
}

.form-control::placeholder {
    color: var(--taupe-dark);
    opacity: 0.7;
}

.form-check {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0.5rem 0;
}

.form-check-input {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(162, 78, 50, 0.3);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    transition: all 0.3s ease;
    margin: 0;
}

.form-check-input:checked {
    background: var(--taupe);
    border-color: var(--taupe);
}

.form-check-label {
    color: var(--taupe-dark);
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    margin: 0;
}

.login-btn {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 16px;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.3);
    position: relative;
    overflow: hidden;
}

.login-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(162, 78, 50, 0.4);
}

.login-btn:hover::before {
    left: 100%;
}

.login-btn:active {
    transform: translateY(0);
}

.alert {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.05));
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 16px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    color: #dc2626;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: shake 0.5s ease-in-out;
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

.alert::before {
    content: '\f071';
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    color: #dc2626;
}

/* Responsive */
@media (max-width: 768px) {
    .login-container {
        padding: 1rem;
        min-height: calc(100vh - 70px);
    }
    
    .login-card {
        padding: 2rem 1.5rem;
        margin: 1rem 0;
    }
    
    .login-icon {
        width: 70px;
        height: 70px;
        font-size: 1.8rem;
    }
    
    .login-title {
        font-size: 1.6rem;
    }
    
    .form-control {
        padding: 0.875rem 1rem;
    }
    
    .login-btn {
        padding: 0.875rem 1.5rem;
        font-size: 1rem;
    }
}

@media (max-width: 480px) {
    .login-card {
        padding: 1.5rem 1rem;
        border-radius: 20px;
    }
    
    .login-title {
        font-size: 1.4rem;
    }
    
    .login-subtitle {
        font-size: 0.85rem;
    }
}

/* Animation d'apparition des éléments */
.login-form > * {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
}

.login-form > *:nth-child(1) { animation-delay: 0.1s; }
.login-form > *:nth-child(2) { animation-delay: 0.2s; }
.login-form > *:nth-child(3) { animation-delay: 0.3s; }
.login-form > *:nth-child(4) { animation-delay: 0.4s; }
.login-form > *:nth-child(5) { animation-delay: 0.5s; }

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <i class="fas fa-user-lock"></i>
            </div>
            <h1 class="login-title">Connexion</h1>
            <p class="login-subtitle">Accédez à votre espace L'Atelier de Marie</p>
        </div>

        {% if error %}
            <div class="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="login-form">
            <div class="form-group">
                <label for="username" class="form-label">
                    <i class="fas fa-envelope"></i>
                    Adresse email
                </label>
                <input 
                    type="email" 
                    value="{{ last_username }}" 
                    name="_username" 
                    id="username" 
                    class="form-control" 
                    autocomplete="email" 
                    required 
                    autofocus
                    placeholder="Votre adresse email"
                >
            </div>

            <div class="form-group">
                <label for="password" class="form-label">
                    <i class="fas fa-lock"></i>
                    Mot de passe
                </label>
                <input 
                    type="password" 
                    name="_password" 
                    id="password" 
                    class="form-control" 
                    autocomplete="current-password" 
                    required
                    placeholder="Votre mot de passe"
                >
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-check">
                <input type="checkbox" name="_remember_me" class="form-check-input" id="rememberMe">
                <label class="form-check-label" for="rememberMe">
                    Se souvenir de moi
                </label>
            </div>

            <button class="login-btn" type="submit">
                <i class="fas fa-sign-in-alt"></i>
                Se connecter
            </button>
        </form>
    </div>
</div>
{% endblock %}