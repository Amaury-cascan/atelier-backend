{% extends 'base_admin.html.twig' %}

{% block title %}Connexion · L'Atelier de Marie{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Page login — pas de marge sur adm-main, centrage pleine zone */
.adm-main:has(.login-page-wrapper) {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding: 0 !important;
    max-width: none !important;
}

.login-page-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 64px);
    width: 100%;
    padding: 2rem 1rem;
    box-sizing: border-box;
}

.login-page {
    width: 100%;
    max-width: 420px;
    flex-shrink: 0;
}

.login-card {
    background: #ffffff;
    border: 1px solid #e8e4de;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 8px 24px rgba(45, 42, 38, 0.08);
}

.login-header {
    text-align: center;
    margin-bottom: 1.5rem;
}

.login-icon {
    width: 64px;
    height: 64px;
    background: #c17f59;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    color: #fff;
    font-size: 1.5rem;
}

.login-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #2d2a26;
    margin: 0 0 0.35rem 0;
}

.login-subtitle {
    font-size: 0.95rem;
    color: #6b6560;
    margin: 0;
}

.login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.login-form .form-group {
    margin: 0;
}

.login-form .form-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #2d2a26;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
}

.login-form .form-label i {
    color: #c17f59;
    width: 1rem;
    text-align: center;
}

.login-form .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #e8e4de;
    border-radius: 8px;
    background: #ffffff;
    color: #2d2a26;
    font-size: 1rem;
    font-family: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.login-form .form-control:focus {
    outline: none;
    border-color: #c17f59;
    box-shadow: 0 0 0 3px rgba(193, 127, 89, 0.12);
}

.login-form .form-control::placeholder {
    color: #6b6560;
}

.login-form .form-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
}

.login-form .form-check-input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: #c17f59;
    margin: 0;
    cursor: pointer;
}

.login-form .form-check-label {
    font-size: 0.9rem;
    color: #6b6560;
    cursor: pointer;
    margin: 0;
}

.login-btn {
    background: #c17f59;
    color: #fff;
    border: none;
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    font-family: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: background 0.2s, transform 0.2s;
    margin-top: 0.25rem;
}

.login-btn:hover {
    background: #a96b48;
    color: #fff;
    transform: translateY(-1px);
}

.login-btn:active {
    transform: translateY(0);
}

.login-alert {
    background: rgba(201, 74, 74, 0.1);
    border: 1px solid #c94a4a;
    border-radius: 8px;
    padding: 0.875rem 1rem;
    margin-bottom: 1rem;
    color: #c94a4a;
    font-size: 0.9rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.login-alert i {
    flex-shrink: 0;
}

@media (max-width: 480px) {
    .login-card {
        padding: 1.5rem 1.25rem;
    }
    .login-title {
        font-size: 1.35rem;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="login-page-wrapper">
    <div class="login-page">
        <div class="login-card">
                <div class="login-header">
                    <div class="login-icon">
                        <i class="fas fa-user-lock"></i>
                    </div>
                    <h1 class="login-title">Connexion</h1>
                    <p class="login-subtitle">Accédez à votre espace administration</p>
                </div>

                {% if error %}
                    <div class="login-alert">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="login-form">
                    <div class="form-group">
                        <label for="username" class="form-label">
                            <i class="fas fa-envelope"></i>
                            Adresse email
                        </label>
                        <input type="email"
                               value="{{ last_username }}"
                               name="_username"
                               id="username"
                               class="form-control"
                               autocomplete="email"
                               required
                               autofocus
                               placeholder="Votre adresse email">
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock"></i>
                            Mot de passe
                        </label>
                        <input type="password"
                               name="_password"
                               id="password"
                               class="form-control"
                               autocomplete="current-password"
                               required
                               placeholder="Votre mot de passe">
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-check">
                        <input type="checkbox" name="_remember_me" class="form-check-input" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                    </div>

                    <button class="login-btn" type="submit">
                        <i class="fas fa-sign-in-alt"></i>
                        Se connecter
                    </button>
                </form>
        </div>
    </div>
</div>
{% endblock %}
