{% extends 'base_admin.html.twig' %}

{% block title %}Compte{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.compte-menu { display: grid; gap: 1rem; }
.compte-menu a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius);
    text-decoration: none;
    color: var(--adm-text);
    font-weight: 600;
    transition: background 0.2s, border-color 0.2s;
}
.compte-menu a:hover { background: var(--adm-accent-soft); border-color: var(--adm-accent); }
.compte-menu a i { font-size: 1.5rem; color: var(--adm-accent); width: 2rem; text-align: center; }
.compte-menu a span:last-child { font-size: 0.9rem; font-weight: 500; color: var(--adm-text-muted); margin-top: 0.25rem; display: block; }
@media (min-width: 640px) { .compte-menu { grid-template-columns: repeat(2, 1fr); } }
</style>
{% endblock %}

{% block body %}
<div class="adm-page-header">
    <h1 class="adm-page-title">Compte</h1>
    <p class="adm-page-subtitle">Gestion des dépenses et des mois personnels</p>
</div>

<div class="compte-menu">
    <a href="{{ path('app_compte_exercice_index') }}">
        <i class="fas fa-chart-pie"></i>
        <div>
            <span>Dépenses du compte commun</span>
            <span>Gérer les dépenses communes</span>
        </div>
    </a>
    <a href="{{ path('app_compte_user_mois_index') }}">
        <i class="fas fa-user-clock"></i>
        <div>
            <span>Mes Mois personnels</span>
            <span>Gérer vos mois, salaire et enveloppes</span>
        </div>
    </a>
</div>
{% endblock %}
