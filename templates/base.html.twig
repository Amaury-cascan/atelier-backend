<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}<L'atelier de Marie>{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-...your-integrity-hash..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_dashboard_index') }}">L'Atelier de Marie</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            {% if is_granted('ROLE_ADMIN') %}
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_dashboard_index') }}">Tableau de bord</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_calendar') }}">Réservations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_service_index') }}">Prestations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_category_index') }}">Catégories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_picture_presentation_index') }}">Images</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_client_index') }}">Clients</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_statistics_index') }}">Statistiques</a>
                    </li>
                </ul>
                {% if app.user %}
                <div class="ms-auto"> 
                    <a class="btn btn-outline-light" href="{{ path('app_logout') }}">Déconnexion</a>
                </div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </nav>
    <main class="container mt-4">
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>