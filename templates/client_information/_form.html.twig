{{ form_start(form, {'attr': {'class': 'modern-form', 'novalidate': 'novalidate'}}) }}

<style>
.modern-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.modern-form .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.modern-form .form-control {
    padding: 1rem;
    border: 2px solid rgba(162, 78, 50, 0.15);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    font-family: 'Inter', sans-serif;
    color: #333;
    transition: all 0.3s ease;
}

.modern-form .form-control:focus {
    outline: none;
    border-color: var(--taupe);
    box-shadow: 
        0 0 0 3px rgba(162, 78, 50, 0.1),
        0 4px 15px rgba(162, 78, 50, 0.15);
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-1px);
}

.modern-form .form-control::placeholder {
    color: var(--taupe-dark);
}

.modern-form label {
    font-weight: 600;
    color: var(--taupe);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.modern-form label::before {
    content: attr(data-icon);
    font-family: 'Font Awesome 6 Free';
    font-weight: 900;
    color: var(--taupe);
}

.modern-form textarea {
    min-height: 100px;
    resize: vertical;
}

.submit-btn {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.3);
}

.submit-btn:active {
    transform: translateY(0);
}

.form-errors {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.05));
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1rem;
    color: #dc2626;
}

.form-errors ul {
    margin: 0;
    padding-left: 1rem;
}

/* Responsive */
@media (max-width: 768px) {
    .modern-form {
        gap: 1rem;
    }
    
    .modern-form .form-control {
        padding: 0.875rem;
    }
    
    .submit-btn {
        padding: 0.875rem 1.5rem;
    }
}
</style>

<div class="modern-form">
    {% if form.vars.errors|length > 0 %}
        <div class="form-errors">
            <strong>Erreurs de validation :</strong>
            <ul>
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if form.client is defined %}
    <div class="form-group">
        {{ form_label(form.client, 'Client', {'attr': {'data-icon': '\f007'}}) }}
        {{ form_widget(form.client, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.client) }}
    </div>
    {% endif %}

    {% if form.allergies is defined %}
    <div class="form-group">
        {{ form_label(form.allergies, 'Allergies', {'attr': {'data-icon': '\f071'}}) }}
        {{ form_widget(form.allergies, {'attr': {'placeholder': 'Indiquez les allergies connues...', 'rows': '3', 'class': 'form-control'}}) }}
        {{ form_errors(form.allergies) }}
    </div>
    {% endif %}

    {% if form.preferences is defined %}
    <div class="form-group">
        {{ form_label(form.preferences, 'Préférences', {'attr': {'data-icon': '\f004'}}) }}
        {{ form_widget(form.preferences, {'attr': {'placeholder': 'Styles préférés, couleurs, etc...', 'rows': '3', 'class': 'form-control'}}) }}
        {{ form_errors(form.preferences) }}
    </div>
    {% endif %}

    {% if form.contraindications is defined %}
    <div class="form-group">
        {{ form_label(form.contraindications, 'Contre-indications', {'attr': {'data-icon': '\f05e'}}) }}
        {{ form_widget(form.contraindications, {'attr': {'placeholder': 'Problèmes de peau, traitements médicaux...', 'rows': '3', 'class': 'form-control'}}) }}
        {{ form_errors(form.contraindications) }}
    </div>
    {% endif %}

    {% if form.notes is defined %}
    <div class="form-group">
        {{ form_label(form.notes, 'Notes personnelles', {'attr': {'data-icon': '\f249'}}) }}
        {{ form_widget(form.notes, {'attr': {'placeholder': 'Informations complémentaires...', 'rows': '4', 'class': 'form-control'}}) }}
        {{ form_errors(form.notes) }}
    </div>
    {% endif %}

    <button type="submit" class="submit-btn">
        <i class="fas fa-save"></i>
        {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}