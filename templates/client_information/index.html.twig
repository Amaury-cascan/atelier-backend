{% extends 'base.html.twig' %}

{% block title %}Informations Clients{% endblock %}

{% block stylesheets %}
<style>
.info-container {
    padding: 2rem 0;
}

.page-header {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(197, 101, 63, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
}

.page-title {
    color: var(--taupe);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 16px;
}

.page-subtitle {
    color: var(--taupe-dark);
    margin-top: 0.5rem;
    font-size: 1.1rem;
}

.stats-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
    text-align: center;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.15);
}

.stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    font-size: 1.5rem;
    color: white;
}

.stat-icon.total { background: linear-gradient(135deg, var(--taupe), var(--taupe-dark)); }
.stat-icon.revenue { background: linear-gradient(135deg, #22c55e, #16a34a); }
.stat-icon.average { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
.stat-icon.notes { background: linear-gradient(135deg, #f59e0b, #d97706); }

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--taupe);
    margin-bottom: 0.5rem;
}

.stat-label {
    color: var(--taupe-dark);
    font-weight: 500;
}

.info-cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.info-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
    transition: all 0.3s ease;
    position: relative;
}

.info-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.15);
}

.info-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.info-id {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
}

.info-date {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(29, 78, 216, 0.05));
    color: #3b82f6;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid rgba(59, 130, 246, 0.2);
}

.info-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.info-item {
    background: rgba(162, 78, 50, 0.03);
    border-radius: 8px;
    padding: 0.75rem;
    border-left: 3px solid var(--taupe);
}

.info-label {
    font-size: 0.8rem;
    color: var(--taupe);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 0.25rem;
}

.info-value {
    color: #333;
    font-weight: 500;
    font-size: 0.9rem;
}

.info-value.empty {
    color: var(--taupe-dark);
    font-style: italic;
    opacity: 0.7;
}

.price-value {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
    font-size: 1.1rem;
}

.note-section {
    grid-column: 1 / -1;
    background: rgba(245, 223, 198, 0.1);
    border-radius: 8px;
    padding: 0.75rem;
    border-left: 3px solid #f5dfc6;
}

.note-content {
    color: var(--taupe-dark);
    font-size: 0.85rem;
    line-height: 1.4;
    margin-top: 0.25rem;
}

.info-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-top: 1rem;
}

.action-btn {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 4px;
    border: none;
    cursor: pointer;
}

.action-btn.view {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.2);
}

.action-btn.edit {
    background: rgba(162, 78, 50, 0.1);
    color: var(--taupe);
    border: 1px solid rgba(162, 78, 50, 0.2);
}

.action-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.search-header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 0 4px 15px rgba(162, 78, 50, 0.08);
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.search-title {
    color: var(--taupe);
    font-weight: 600;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.search-container {
    position: relative;
    min-width: 300px;
}

.search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.5rem;
    border: 2px solid rgba(162, 78, 50, 0.15);
    border-radius: 25px;
    background: rgba(255, 255, 255, 0.9);
    font-size: 0.9rem;
    transition: all 0.3s ease;
}

.search-input:focus {
    outline: none;
    border-color: var(--taupe);
    box-shadow: 0 0 0 3px rgba(162, 78, 50, 0.1);
}

.search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--taupe);
}

.empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--taupe-dark);
}

.empty-state i {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.add-btn {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.add-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.3);
    color: white;
}

.results-counter {
    color: var(--taupe-dark);
    font-size: 0.9rem;
    margin-top: 1rem;
}

/* Responsive */
@media (max-width: 768px) {
    .info-cards-container {
        grid-template-columns: 1fr;
    }
    
    .info-details {
        grid-template-columns: 1fr;
    }
    
    .search-header {
        flex-direction: column;
        align-items: stretch;
    }
    
    .search-container {
        min-width: auto;
    }
    
    .page-title {
        font-size: 2rem;
        flex-direction: column;
        text-align: center;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="info-container" data-animate="true">
    <!-- En-tête -->
    <div class="page-header">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-clipboard-list"></i>
                    Informations Clients
                </h1>
                <p class="page-subtitle">Historique détaillé des prestations et notes clients</p>
            </div>
            <a href="{{ path('app_client_information_new') }}" class="add-btn">
                <i class="fas fa-plus-circle"></i>
                Nouvelle Information
            </a>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon total">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div class="stat-number" data-target="{{ client_informations|length }}">0</div>
            <div class="stat-label">Prestations total</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue">
                <i class="fas fa-euro-sign"></i>
            </div>
            <div class="stat-number" data-target="{% set totalRevenue = 0 %}{% for info in client_informations %}{% if info.prix is defined %}{% set totalRevenue = totalRevenue + info.prix %}{% endif %}{% endfor %}{{ totalRevenue }}">0</div>
            <div class="stat-label">Chiffre d'affaires €</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon average">
                <i class="fas fa-calculator"></i>
            </div>
            <div class="stat-number" data-target="{{ client_informations|length > 0 ? (totalRevenue / client_informations|length)|round : 0 }}">0</div>
            <div class="stat-label">Prix moyen €</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon notes">
                <i class="fas fa-sticky-note"></i>
            </div>
            <div class="stat-number" data-target="{% set withNotes = 0 %}{% for info in client_informations %}{% if info.note is defined and info.note %}{% set withNotes = withNotes + 1 %}{% endif %}{% endfor %}{{ withNotes }}">0</div>
            <div class="stat-label">Avec notes</div>
        </div>
    </div>

    <!-- Recherche -->
    <div class="search-header">
        <h4 class="search-title">
            <i class="fas fa-table"></i>
            Historique des Prestations
        </h4>
        <div class="search-container">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Rechercher une prestation..." id="searchInfos">
        </div>
    </div>

    <!-- Liste des informations -->
    {% if client_informations is not empty %}
        <div class="info-cards-container">
            {% for client_information in client_informations %}
                <div class="info-card" data-search="{{ (client_information.technique|default('') ~ ' ' ~ client_information.forme|default('') ~ ' ' ~ client_information.produit|default(''))|lower }}">
                    <div class="info-header">
                        <div class="info-id">#{{ client_information.id }}</div>
                        {% if client_information.date %}
                            <div class="info-date">
                                <i class="fas fa-calendar"></i>
                                {{ client_information.date|date('d/m/Y') }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="info-details">
                        <div class="info-item">
                            <div class="info-label">
                                <i class="fas fa-magic"></i>
                                Technique
                            </div>
                            <div class="info-value {{ client_information.technique ? '' : 'empty' }}">
                                {{ client_information.technique ?: 'Non définie' }}
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">
                                <i class="fas fa-shapes"></i>
                                Forme
                            </div>
                            <div class="info-value {{ client_information.forme ? '' : 'empty' }}">
                                {{ client_information.forme ?: 'Non définie' }}
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">
                                <i class="fas fa-box"></i>
                                Produit
                            </div>
                            <div class="info-value {{ client_information.produit ? '' : 'empty' }}">
                                {{ client_information.produit ?: 'Non défini' }}
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-label">
                                <i class="fas fa-euro-sign"></i>
                                Prix
                            </div>
                            <div class="info-value {{ client_information.prix ? 'price-value' : 'empty' }}">
                                {% if client_information.prix %}
                                    {{ client_information.prix }} €
                                {% else %}
                                    Non défini
                                {% endif %}
                            </div>
                        </div>

                        {% if client_information.note %}
                            <div class="note-section">
                                <div class="info-label">
                                    <i class="fas fa-sticky-note"></i>
                                    Note
                                </div>
                                <div class="note-content">{{ client_information.note }}</div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="info-actions">
                        <a href="{{ path('app_client_information_show', {'id': client_information.id}) }}" class="action-btn view">
                            <i class="fas fa-eye"></i>
                            Voir
                        </a>
                        <a href="{{ path('app_client_information_edit', {'id': client_information.id}) }}" class="action-btn edit">
                            <i class="fas fa-edit"></i>
                            Modifier
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="results-counter">
            <span id="infoCount">{{ client_informations|length }}</span> prestation(s) affichée(s)
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-clipboard-list"></i>
            <h3>Aucune information trouvée</h3>
            <p>Créez votre première fiche d'information client</p>
            <a href="{{ path('app_client_information_new') }}" class="add-btn">
                <i class="fas fa-plus-circle"></i>
                Créer une Information
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Animation des compteurs
    document.querySelectorAll('.stat-number').forEach(counter => {
        const target = parseInt(counter.getAttribute('data-target'));
        if (!isNaN(target)) {
            let current = 0;
            const increment = target / 20;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                counter.textContent = Math.floor(current);
            }, 50);
        }
    });

    // Recherche en temps réel
    const searchInput = document.getElementById('searchInfos');
    const infoCards = document.querySelectorAll('.info-card');
    const infoCounter = document.getElementById('infoCount');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            let visibleCount = 0;
            
            infoCards.forEach(card => {
                const searchData = card.getAttribute('data-search');
                if (searchData.includes(searchTerm)) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            
            if (infoCounter) {
                infoCounter.textContent = visibleCount;
            }
        });
    }
});
</script>
{% endblock %}
