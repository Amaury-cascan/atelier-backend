{% extends 'base.html.twig' %}

{% block title %}Informations du client{% endblock %}

{% block stylesheets %}
<style>
.info-container {
    max-width: 900px;
    margin: 0 auto;
}

.info-header {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(197, 101, 63, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    text-align: center;
}

.info-title {
    color: var(--taupe);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.info-subtitle {
    color: var(--taupe-dark);
    margin-top: 0.5rem;
    font-size: 1rem;
}

.info-details-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 
        0 10px 25px rgba(162, 78, 50, 0.08),
        0 4px 15px rgba(162, 78, 50, 0.05);
    margin-bottom: 2rem;
    position: relative;
}

.info-details-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--taupe), var(--taupe-light));
    border-radius: 20px 20px 0 0;
}

.info-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.info-row {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: rgba(162, 78, 50, 0.03);
    border-radius: 12px;
    border-left: 4px solid var(--taupe);
}

.info-label {
    font-weight: 600;
    color: var(--taupe);
    min-width: 120px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.info-value {
    color: #333;
    font-weight: 500;
}

.price-value {
    background: linear-gradient(135deg, #22C55E, #16A34A);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
    font-size: 1.2rem;
}

.date-value {
    background: linear-gradient(135deg, #3B82F6, #1D4ED8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 700;
}

.note-value {
    line-height: 1.6;
    color: var(--taupe-dark);
}

.actions-container {
    display: flex;
    gap: 1rem;
    justify-content: flex-start;
    flex-wrap: wrap;
    align-items: center;
}

.action-btn {
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
}

.back-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--taupe-dark);
    border: 1px solid rgba(162, 78, 50, 0.2);
}

.back-btn:hover {
    background: var(--taupe);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(162, 78, 50, 0.2);
}

.edit-btn {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
}

.edit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(162, 78, 50, 0.3);
}

/* Responsive */
@media (max-width: 768px) {
    .info-details-card {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .info-header {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .info-title {
        font-size: 1.6rem;
        flex-direction: column;
    }
    
    .info-details {
        grid-template-columns: 1fr;
    }
    
    .actions-container {
        justify-content: center;
        flex-direction: column;
        align-items: stretch;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="info-container" data-animate="true">
    <div class="info-header">
        <h1 class="info-title">
            <i class="fas fa-user-circle"></i>
            Informations Client
        </h1>
        <p class="info-subtitle">Détails des informations personnalisées</p>
    </div>

    <div class="info-details-card">
        <div class="info-details">
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-hashtag"></i>
                    ID :
                </div>
                <div class="info-value">#{{ client_information.id }}</div>
            </div>

            {% if client_information.client is defined %}
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-user"></i>
                    Client :
                </div>
                <div class="info-value">{{ client_information.client.firstName ~ ' ' ~ client_information.client.lastName }}</div>
            </div>
            {% endif %}

            {% if client_information.date %}
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-calendar"></i>
                    Date :
                </div>
                <div class="info-value date-value">{{ client_information.date|date('d/m/Y à H:i') }}</div>
            </div>
            {% endif %}

            {% if client_information.technique %}
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-tools"></i>
                    Technique :
                </div>
                <div class="info-value">{{ client_information.technique }}</div>
            </div>
            {% endif %}

            {% if client_information.forme %}
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-shapes"></i>
                    Forme :
                </div>
                <div class="info-value">{{ client_information.forme }}</div>
            </div>
            {% endif %}

            {% if client_information.produit %}
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-box"></i>
                    Produit :
                </div>
                <div class="info-value">{{ client_information.produit }}</div>
            </div>
            {% endif %}

            {% if client_information.prix %}
            <div class="info-row">
                <div class="info-label">
                    <i class="fas fa-euro-sign"></i>
                    Prix :
                </div>
                <div class="info-value price-value">{{ client_information.prix }} €</div>
            </div>
            {% endif %}

            {% if client_information.note %}
            <div class="info-row" style="grid-column: 1 / -1;">
                <div class="info-label">
                    <i class="fas fa-sticky-note"></i>
                    Notes :
                </div>
                <div class="info-value note-value">{{ client_information.note }}</div>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="actions-container">
        <a href="{{ path('app_client_information_index') }}" class="action-btn back-btn">
            <i class="fas fa-arrow-left"></i>
            Retour à la liste
        </a>
        <a href="{{ path('app_client_information_edit', {'id': client_information.id}) }}" class="action-btn edit-btn">
            <i class="fas fa-edit"></i>
            Modifier
        </a>
        {{ include('client_information/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
