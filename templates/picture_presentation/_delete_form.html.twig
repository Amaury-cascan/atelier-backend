<form method="post" action="{{ path('app_picture_presentation_delete', {'id': picture_presentation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette image ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ picture_presentation.id) }}">
    <button class="btn">Supprimer</button>
</form>
