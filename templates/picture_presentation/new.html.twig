{% extends 'base.html.twig' %}

{% block title %}Nouvelle image{% endblock %}

{% block stylesheets %}
<style>
.form-container {
    max-width: 800px;
    margin: 0 auto;
}

.form-header {
    background: linear-gradient(135deg, rgba(162, 78, 50, 0.1), rgba(197, 101, 63, 0.05));
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    text-align: center;
}

.form-title {
    color: var(--taupe);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.form-subtitle {
    color: var(--taupe-dark);
    margin-top: 0.5rem;
    font-size: 1rem;
}

.form-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 2.5rem;
    border: 1px solid rgba(162, 78, 50, 0.1);
    box-shadow: 
        0 10px 25px rgba(162, 78, 50, 0.08),
        0 4px 15px rgba(162, 78, 50, 0.05);
    margin-bottom: 2rem;
    position: relative;
}

.form-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--taupe), var(--taupe-light));
    border-radius: 20px 20px 0 0;
}

.actions-container {
    display: flex;
    gap: 1rem;
    justify-content: flex-start;
    flex-wrap: wrap;
}

.back-btn {
    background: rgba(255, 255, 255, 0.9);
    color: var(--taupe-dark);
    border: 1px solid rgba(162, 78, 50, 0.2);
    padding: 12px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.back-btn:hover {
    background: var(--taupe);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(162, 78, 50, 0.2);
}

/* Responsive */
@media (max-width: 768px) {
    .form-card {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .form-header {
        padding: 1.5rem;
        margin: 1rem;
    }
    
    .form-title {
        font-size: 1.6rem;
        flex-direction: column;
    }
    
    .actions-container {
        justify-content: center;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="form-container" data-animate="true">
    <div class="form-header">
        <h1 class="form-title">
            <i class="fas fa-plus-circle"></i>
            Nouvelle image
        </h1>
        <p class="form-subtitle">Ajoutez une nouvelle réalisation à votre galerie</p>
    </div>

    <div class="form-card">
        {{ include('picture_presentation/_form.html.twig') }}
    </div>

    <div class="actions-container">
        <a href="{{ path('app_picture_presentation_index') }}" class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Retour à la galerie
        </a>
    </div>
</div>
{% endblock %}
