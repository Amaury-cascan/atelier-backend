{% extends 'base.html.twig' %}

{% block title %}Détails de l'image{% endblock %}

{% block body %}
    <h1 class="mb-4">Détails de l'image</h1>

    <div class="card mb-4">
        <div class="card-body">
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th>Description</th>
                        <td>{{ picture_presentation.description }}</td>
                    </tr>
                    <tr>
                        <th>Image</th>
                        <td>{{ picture_presentation.picture }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_picture_presentation_index') }}" class="btn btn-secondary">Retour à la liste</a>
        <a href="{{ path('app_picture_presentation_edit', {'id': picture_presentation.id}) }}" class="btn btn-primary">Modifier</a>
        {{ include('picture_presentation/_delete_form.html.twig') }}
    </div>
{% endblock %}
