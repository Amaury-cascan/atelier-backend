{% extends 'base_admin.html.twig' %}

{% block title %}Image #{{ picture_presentation.id }} - Détails{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-4 mb-2"><i class="fas fa-image me-3"></i>Détails de l'image</h1>
            <p class="text-muted lead">Image #{{ picture_presentation.id }}</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_picture_presentation_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Retour à la galerie
            </a>
            <a href="{{ path('app_picture_presentation_edit', {'id': picture_presentation.id}) }}" class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>Modifier
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Image principale -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><i class="fas fa-image me-2"></i>Aperçu de l'image</h4>
                </div>
                <div class="card-body text-center">
                    {% if picture_presentation.picture %}
                        <div class="main-image-container">
                            <img src="{{ asset('images/service/' ~ picture_presentation.picture) }}" 
                                 alt="{{ picture_presentation.description ?: 'Image de présentation' }}" 
                                 class="main-image"
                                 onclick="openImageModal(this.src)">
                            <div class="image-overlay">
                                <i class="fas fa-search-plus fa-2x"></i>
                                <p class="mt-2 mb-0">Cliquez pour agrandir</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="no-image-placeholder">
                            <i class="fas fa-image fa-5x text-muted mb-3"></i>
                            <h5 class="text-muted">Aucune image</h5>
                            <p class="text-muted">Aucun fichier image n'est associé à cette présentation</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Informations -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Informations</h5>
                </div>
                <div class="card-body">
                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-hashtag text-primary"></i>
                            <span>ID</span>
                        </div>
                        <div class="info-value">#{{ picture_presentation.id }}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-align-left text-primary"></i>
                            <span>Description</span>
                        </div>
                        <div class="info-value">
                            {% if picture_presentation.description %}
                                {{ picture_presentation.description }}
                            {% else %}
                                <em class="text-muted">Aucune description</em>
                            {% endif %}
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-file-image text-primary"></i>
                            <span>Fichier</span>
                        </div>
                        <div class="info-value">
                            {% if picture_presentation.picture %}
                                <span class="badge bg-success">
                                    <i class="fas fa-check me-1"></i>{{ picture_presentation.picture }}
                                </span>
                            {% else %}
                                <span class="badge bg-warning">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Aucun fichier
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="mt-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-cogs me-2"></i>Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('app_picture_presentation_edit', {'id': picture_presentation.id}) }}" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Modifier l'image
                    </a>
                    {{ include('picture_presentation/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour agrandir l'image -->
    <div class="modal fade" id="imageModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aperçu de l'image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalImage" src="" alt="Image agrandie" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
<style>
.main-image-container {
    position: relative;
    display: inline-block;
    cursor: pointer;
}

.main-image {
    max-width: 100%;
    max-height: 500px;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(162, 78, 50, 0.15);
    transition: transform 0.3s ease;
}

.main-image-container:hover .main-image {
    transform: scale(1.02);
}

.image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 12px;
}

.main-image-container:hover .image-overlay {
    opacity: 1;
}

.no-image-placeholder {
    padding: 3rem;
    background: linear-gradient(135deg, var(--beige), var(--beige-light));
    border-radius: 12px;
    color: var(--taupe);
}

.info-item {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    border-left: 3px solid var(--taupe);
}

.info-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--taupe);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
}

.info-value {
    color: #333;
    font-weight: 500;
}

.modal-content {
    border: none;
    border-radius: 15px;
    overflow: hidden;
}

.modal-header {
    background: linear-gradient(135deg, var(--taupe), var(--taupe-dark));
    color: white;
    border: none;
}

.modal-header .btn-close {
    filter: invert(1);
}
</style>
{% endblock %}

{% block javascripts %}
<script>
function openImageModal(imageSrc) {
    document.getElementById('modalImage').src = imageSrc;
    new bootstrap.Modal(document.getElementById('imageModal')).show();
}
</script>
{% endblock %}
